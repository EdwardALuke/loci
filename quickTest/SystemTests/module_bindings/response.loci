#include <Loci.h>
#include <module_interface.h>

/// The host chooses the provider of this input.
$type input param<int> ;
/// A private control belonging to the local input label.
$type bias_input param<int> ;
$type X param<int> ;
$type bias_X param<int> ;
$type Response(X) param<int> ;
$type result param<int> ;

/// Binding input must not redirect the related private name bias_input.
$rule default(bias_input) { $bias_input = 3 ; }

/// Substitution selects a local bias; binding later selects the input data.
$rule singleton(Response(X) <- X,bias_X) {
  $Response(X) = $X + $bias_X ;
}

/// The public result uses the same family for any selected input provider.
$rule singleton(result <- Response(input)) {
  $result = $Response(input) ;
}

extern "C" const Loci::module_interface_v1 *loci_module_interface_v1() {
  static const Loci::module_interface_v1 interface = {{"input"}, {"result"}} ;
  return &interface ;
}
