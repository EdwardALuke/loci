#include <Loci.h>
#include <module_interface.h>

/// Imported surface temperature, produced at the host's exchange level.
$type wallTemperature param<double> ;
/// Imported ambient temperature, available during setup and queries.
$type ambient param<double> ;
/// Private controls read from this instance's deck.
$type temperature param<double> ;
$type conductance param<double> ;
/// Private setup result and a counter that detects repeated initialization.
$type offset param<double> ;
$type setupCount param<int> ;
/// Public output; this formula is a dataflow example, not a fluid solver.
$type heatFlux param<double> ;
$type X param<double> ;
$type Copy(X) param<double> ;
$type environment@temperature param<double> ;
$type explicitAmbient param<double> ;

/// Local controls retain ordinary Loci defaults.
$rule default(temperature) { $temperature = 400.0 ; }

/// The deck can override this value without changing any bindings.
$rule default(conductance) { $conductance = 2.0 ; }

/// Expansion retains a local argument label and binds the resulting source.
$rule singleton(Copy(X) <- X) { $Copy(X) = $X ; }

/// An explicit source must not prevent relocation of this private target.
$rule singleton(explicitAmbient <- environment@temperature) {
  $explicitAmbient = $environment@temperature ;
}

/// Host iteration promotion carries the selected wall temperature into here.
$rule singleton(heatFlux <- Copy(wallTemperature),temperature,
conductance,offset) {
  $heatFlux = $conductance * ($temperature + $offset - $Copy(wallTemperature)) ;
}

extern "C" const Loci::module_interface_v1 *loci_module_interface_v1() {
  static const Loci::module_interface_v1 interface = {
    {"wallTemperature", "ambient"}, {"heatFlux"}
  } ;
  return &interface ;
}

extern "C" void loci_init_module_v1(Loci::module_context &context) {
  Loci::const_param<double> ambient(context.read("ambient")) ;
  Loci::param<double> offset ;
  *offset = *ambient - 300.0 ;
  context.create("offset", offset.Rep()) ;
  Loci::param<int> count ;
  *count = 1 ;
  context.create("setupCount", count.Rep()) ;
}
