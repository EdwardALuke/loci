#include <Loci.h>

$type X param<int> ;
$type Define(X) param<int> ;
$type seed param<int> ;
$type pressure param<int> ;
$type result param<int> ;
$type prescribed param<int> ;
$type total param<int> ;
$type original store<int> ;
$type updated store<int> ;

/// Instantiation with pressure creates an illegal imported-input writer.
$rule singleton(Define(X), X <- seed), parametric(Define(X)) {
  $Define(X) = $seed ;
  $X = $seed ;
}

/// Force the specialization that exposes the otherwise symbolic target X.
$rule singleton(result <- Define(pressure), pressure) {
  $result = $Define(pressure) + $pressure ;
}

/// An imported input cannot have a local default.
$rule default(prescribed) {
  $prescribed = 13 ;
}

/// A local reduction cannot initialize an imported input.
$rule unit(total), constraint(UNIVERSE) {
  $total = 0 ;
}

/// An apply contribution is also a write to the imported input.
$rule apply(total <- original)[Loci::Summation] {
  join($total, $original) ;
}

/// The old name is a write target too because its storage is reused.
$rule pointwise(updated <- original), inplace(updated|original) {
  $updated = $original + 1 ;
}
