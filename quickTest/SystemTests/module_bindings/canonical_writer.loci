#include <Loci.h>
#include <module_interface.h>

$type host@X param<double> ;
$type Define(X) param<double> ;
$type seed param<double> ;
$type pressure param<double> ;
$type result param<double> ;

/// The forbidden destination appears only after substituting X=pressure.
$rule singleton(Define(X),host@X <- seed), parametric(Define(X)) {
  $Define(X) = $seed ;
  $host@X = $seed ;
}

/// Request the specialization while retaining a properly private output.
$rule singleton(result <- Define(pressure),pressure) {
  $result = $Define(pressure) + $pressure ;
}

extern "C" const Loci::module_interface_v1 *loci_module_interface_v1() {
  static const Loci::module_interface_v1 interface = {
    {"pressure"}, {"result"}
  } ;
  return &interface ;
}
