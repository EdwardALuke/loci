// Optional solver-facing facts installed with the adapted mesh.

#include <FVMAdapt/face_history.h>

/// Number of refinement-tree steps from the original cell; zero for a root.
$type refinementDepth store<int> ;

/// Base-mesh file number of the original cell, shared by its descendants.
/// Not an entity ID in the installed mesh.
$type rootCellFileNumber store<int> ;

/// How this cell was produced by the last adaptation; values are Loci::CellChange.
/// Unchanged cells may still have subdivided faces.
$type cellChange store<int> ;

/// Longest own edge of the final leaf, ignoring neighboring subdivisions.
/// Lengths use the returned node coordinates and are not updated by mesh motion.
$type maxEdgeLength store<double> ;

/// Maximum length among the cell's own edges projected onto the XY plane.
$type maxEdgeLengthXY store<double> ;

/// Old-face contributors on installed faces; fractions use refinement coordinates.
$type faceSources multiStore<Loci::FaceSource> ;
/// Change from the preceding mesh, as a FaceChange value.
$type faceChange store<int> ;
/// Previous cell file number for FACE_CREATED; -1 otherwise. IDs may be negative.
$type faceOriginCell store<Loci::CellId> ;
/// Retained topology for the next adaptation; no solver fields are stored.
$type faceState blackbox<Loci::FaceStateP> ;
/// Correspondence and reusable old-field retrieval for this mesh transition.
$type faceHistory blackbox<Loci::FaceHistoryP> ;
