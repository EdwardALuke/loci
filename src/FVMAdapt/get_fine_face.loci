#include <iostream>
#include <vector>
#include <Loci.h>
#include <Tools/tools.h>
#include "diamondcell.h"

#include "face_output.h"

$include "FVM.lh"
$include "fvmadapt_internal.lh"

// This file generates fine_faces according refinement plans. The
// original grid is general element. Isotropic refinement is used. the rules
// should be used after node_offset and cell_offset has been set up.
// FineFaces is defined as c1, c2,followed by face2node.

/// Get fine_faces of general cells
// Without face history.
$rule pointwise(fine_faces_cell <-
balancedCellPlan, balanced_node_offset,
balanced_cell_offset,
(lower, upper, boundary_map)->(balancedFacePlan,is_quadface, balanced_node_offset),
(lower, upper, boundary_map)->face2edge->(balancedEdgePlan,balanced_node_offset),
(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(gnrlcells, faceHistoryDisabled) {
  Loci::FaceOutput output($fine_faces_cell) ;
  if($balancedCellPlan.size() == 0) {
    return ;
  }

  std::list<Node*> bnode_list ; // boundary node
  std::list<Edge*> edge_list ;
  std::list<Face*> face_list ;
  std::list<Node*> node_list ; // inner node

  // build a cell
  Cell* aCell = build_general_cell($lower.begin(), $lower.size(),
    $upper.begin(), $upper.size(), $boundary_map.begin(), $boundary_map.size(),
    $*is_quadface, $*face2node, $*face2edge, $*edge2node, $*pos, $*balancedEdgePlan,
    $*balancedFacePlan, $*balanced_node_offset, bnode_list, edge_list, face_list,
    $*fileNumber(pos)) ;

  Loci::make_general_cell_faces(aCell, $balancedCellPlan, $balanced_node_offset,
    $balanced_cell_offset, node_list, edge_list, face_list, output) ;

  // clean up
  if(aCell != 0) {
    delete aCell ;
    aCell = 0 ;
  }

  // Delete the separately owned nodes, edges, and faces.
  cleanup_list(bnode_list, edge_list, face_list) ;
  cleanup_list(node_list) ;
}

// With face history.
$rule pointwise(fine_faces_cell, fine_face_patches_cell <-
recordFaceHistory, fileNumber(geom_cells), planCellFileOffset,
balancedCellPlan, balanced_node_offset,
balanced_cell_offset,
(lower, upper, boundary_map)->(balancedFacePlan,is_quadface, balanced_node_offset),
(lower, upper, boundary_map)->face2edge->(balancedEdgePlan,balanced_node_offset),
(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(gnrlcells, faceHistoryEnabled) {
  Loci::FaceOutput output($fine_faces_cell, $fine_face_patches_cell,
    $fileNumber(geom_cells)+$planCellFileOffset) ;
  if($balancedCellPlan.size() == 0) {
    return ;
  }

  std::list<Node*> bnode_list ; // boundary node
  std::list<Edge*> edge_list ;
  std::list<Face*> face_list ;
  std::list<Node*> node_list ; // inner node

  // build a cell
  Cell* aCell = build_general_cell($lower.begin(), $lower.size(),
    $upper.begin(), $upper.size(), $boundary_map.begin(), $boundary_map.size(),
    $*is_quadface, $*face2node, $*face2edge, $*edge2node, $*pos, $*balancedEdgePlan,
    $*balancedFacePlan, $*balanced_node_offset, bnode_list, edge_list, face_list,
    $*fileNumber(pos)) ;

  Loci::make_general_cell_faces(aCell, $balancedCellPlan, $balanced_node_offset,
    $balanced_cell_offset, node_list, edge_list, face_list, output) ;

  // clean up
  if(aCell != 0) {
    delete aCell ;
    aCell = 0 ;
  }

  // Delete the separately owned nodes, edges, and faces.
  cleanup_list(bnode_list, edge_list, face_list) ;
  cleanup_list(node_list) ;
}

/// Get fine_faces of interior faces
// Without face history.
$rule pointwise(fine_faces <-
balancedFacePlan, balanced_node_offset,
face2edge->(balancedEdgePlan, balanced_node_offset),
(cl, cr)->(balancedCellPlan, balanced_cell_offset),
(cl, cr)->(upper, lower, boundary_map)->face2node->(pos, fileNumber(pos)),
(cl, cr)->(upper, lower, boundary_map)-> face2edge->edge2node->pos,
face2node->(pos, fileNumber(pos))),
constraint((cl, cr)->gnrlcells, faceHistoryDisabled) {
  Loci::FaceOutput output($fine_faces) ;
  std::list<Node*> bnode_list, node_list ;
  std::list<Edge*> edge_list ;
  Face* aFace = build_general_face($face2node.begin(), $face2node.size(),
    $face2edge.begin(), $*edge2node, $*pos, $*balanced_node_offset,
    $*balancedEdgePlan, bnode_list, edge_list, $*fileNumber(pos));
  auto leaves = output.split(aFace, $balancedFacePlan, $balanced_node_offset,
    node_list, edge_list) ;

  std::vector<int32> CL(1,1) ;
  if(!$balancedFacePlan.empty()) {
    CL = get_c1($cl->$lower.begin(), $cl->$lower.size(),
      $cl->$upper.begin(), $cl->$upper.size(), $cl->$boundary_map.begin(),
      $cl->$boundary_map.size(), $*face2node, $*face2edge, $*edge2node,
      $cl->$balancedCellPlan, $balancedFacePlan, _e_, $*fileNumber(pos)) ;
  }
  std::vector<int32> CR(1,1) ;
  if(!$balancedFacePlan.empty()) {
    CR = get_c1($cr->$lower.begin(), $cr->$lower.size(),
      $cr->$upper.begin(), $cr->$upper.size(), $cr->$boundary_map.begin(),
      $cr->$boundary_map.size(), $*face2node, $*face2edge, $*edge2node,
      $cr->$balancedCellPlan, $balancedFacePlan, _e_, $*fileNumber(pos)) ;
  }
  output.append(leaves, CL, $cl->$balancedCellPlan, $cl->$balanced_cell_offset,
    CR, $cr->$balancedCellPlan, $cr->$balanced_cell_offset) ;

  // Clean up the face tree and its nodes and edges.
  delete aFace ;
  cleanup_list(node_list) ;
  cleanup_list(bnode_list, edge_list) ;
}

// With face history.
$rule pointwise(fine_faces, fine_face_patches <-
recordFaceHistory, planFaceFileNumber,
balancedFacePlan, balanced_node_offset,
face2edge->(balancedEdgePlan, balanced_node_offset),
(cl, cr)->(balancedCellPlan, balanced_cell_offset),
(cl, cr)->(upper, lower, boundary_map)->face2node->(pos, fileNumber(pos)),
(cl, cr)->(upper, lower, boundary_map)-> face2edge->edge2node->pos,
face2node->(pos, fileNumber(pos))),
constraint((cl, cr)->gnrlcells, faceHistoryEnabled) {
  Loci::FaceOutput output($fine_faces, $fine_face_patches, $planFaceFileNumber) ;
  std::list<Node*> bnode_list, node_list ;
  std::list<Edge*> edge_list ;
  Face* aFace = build_general_face($face2node.begin(), $face2node.size(),
    $face2edge.begin(), $*edge2node, $*pos, $*balanced_node_offset,
    $*balancedEdgePlan, bnode_list, edge_list, $*fileNumber(pos));
  auto leaves = output.split(aFace, $balancedFacePlan, $balanced_node_offset,
    node_list, edge_list) ;

  std::vector<int32> CL(1,1) ;
  if(!$balancedFacePlan.empty()) {
    CL = get_c1($cl->$lower.begin(), $cl->$lower.size(),
      $cl->$upper.begin(), $cl->$upper.size(), $cl->$boundary_map.begin(),
      $cl->$boundary_map.size(), $*face2node, $*face2edge, $*edge2node,
      $cl->$balancedCellPlan, $balancedFacePlan, _e_, $*fileNumber(pos)) ;
  }
  std::vector<int32> CR(1,1) ;
  if(!$balancedFacePlan.empty()) {
    CR = get_c1($cr->$lower.begin(), $cr->$lower.size(),
      $cr->$upper.begin(), $cr->$upper.size(), $cr->$boundary_map.begin(),
      $cr->$boundary_map.size(), $*face2node, $*face2edge, $*edge2node,
      $cr->$balancedCellPlan, $balancedFacePlan, _e_, $*fileNumber(pos)) ;
  }
  output.append(leaves, CL, $cl->$balancedCellPlan, $cl->$balanced_cell_offset,
    CR, $cr->$balancedCellPlan, $cr->$balanced_cell_offset) ;

  // Clean up the face tree and its nodes and edges.
  delete aFace ;
  cleanup_list(node_list) ;
  cleanup_list(bnode_list, edge_list) ;
}

/// Build boundary-face connectivity.
// Without face history.
$rule pointwise(fine_faces <-
balancedFacePlan, balanced_node_offset,
face2edge->(balancedEdgePlan, balanced_node_offset),
cl->(balancedCellPlan, balanced_cell_offset),
cl->(upper, lower, boundary_map)->face2node->(pos, fileNumber(pos)),
cl->(upper, lower, boundary_map)-> face2edge->edge2node->pos,
face2node->(pos, fileNumber(pos)), ref->boundary_tags),
constraint(cl->gnrlcells, boundary_faces, faceHistoryDisabled) {
  Loci::FaceOutput output($fine_faces) ;
  std::list<Node*> bnode_list, node_list ;
  std::list<Edge*> edge_list ;
  Face* aFace = build_general_face($face2node.begin(), $face2node.size(),
    $face2edge.begin(), $*edge2node, $*pos, $*balanced_node_offset,
    $*balancedEdgePlan, bnode_list, edge_list, $*fileNumber(pos)) ;
  auto leaves = output.split(aFace, $balancedFacePlan, $balanced_node_offset,
    node_list, edge_list) ;

  std::vector<int32> CL(1,1) ;
  if(!$balancedFacePlan.empty()) {
    CL = get_c1($cl->$lower.begin(), $cl->$lower.size(),
      $cl->$upper.begin(), $cl->$upper.size(), $cl->$boundary_map.begin(),
      $cl->$boundary_map.size(), $*face2node, $*face2edge, $*edge2node,
      $cl->$balancedCellPlan, $balancedFacePlan, _e_, $*fileNumber(pos)) ;
  }
  int boundary = -atoi(&($ref->$boundary_tags[3])) ;
  output.append(leaves, CL, $cl->$balancedCellPlan, $cl->$balanced_cell_offset, boundary) ;

  // Clean up the face tree and its nodes and edges.
  delete aFace ;
  cleanup_list(node_list) ;
  cleanup_list(bnode_list, edge_list) ;
}

// With face history.
$rule pointwise(fine_faces, fine_face_patches <-
recordFaceHistory, planFaceFileNumber,
balancedFacePlan, balanced_node_offset,
face2edge->(balancedEdgePlan, balanced_node_offset),
cl->(balancedCellPlan, balanced_cell_offset),
cl->(upper, lower, boundary_map)->face2node->(pos, fileNumber(pos)),
cl->(upper, lower, boundary_map)-> face2edge->edge2node->pos,
face2node->(pos, fileNumber(pos)), ref->boundary_tags),
constraint(cl->gnrlcells, boundary_faces, faceHistoryEnabled) {
  Loci::FaceOutput output($fine_faces, $fine_face_patches, $planFaceFileNumber) ;
  std::list<Node*> bnode_list, node_list ;
  std::list<Edge*> edge_list ;
  Face* aFace = build_general_face($face2node.begin(), $face2node.size(),
    $face2edge.begin(), $*edge2node, $*pos, $*balanced_node_offset,
    $*balancedEdgePlan, bnode_list, edge_list, $*fileNumber(pos)) ;
  auto leaves = output.split(aFace, $balancedFacePlan, $balanced_node_offset,
    node_list, edge_list) ;

  std::vector<int32> CL(1,1) ;
  if(!$balancedFacePlan.empty()) {
    CL = get_c1($cl->$lower.begin(), $cl->$lower.size(),
      $cl->$upper.begin(), $cl->$upper.size(), $cl->$boundary_map.begin(),
      $cl->$boundary_map.size(), $*face2node, $*face2edge, $*edge2node,
      $cl->$balancedCellPlan, $balancedFacePlan, _e_, $*fileNumber(pos)) ;
  }
  int boundary = -atoi(&($ref->$boundary_tags[3])) ;
  output.append(leaves, CL, $cl->$balancedCellPlan, $cl->$balanced_cell_offset, boundary) ;

  // Clean up the face tree and its nodes and edges.
  delete aFace ;
  cleanup_list(node_list) ;
  cleanup_list(bnode_list, edge_list) ;
}
