#include <iostream>
#include <queue>
#include <vector>
#include <map>
#include <set>

#include <Loci.h>
#include <Tools/tools.h>
#include "diamondcell.h"
$include "FVM.lh"
$include "fvmadapt_internal.lh"

using std::queue ;
using std::cerr ;
using std::endl ;
using std::set ;
using std::map ;

// by: Qiuhan Xue
// This file set up the numbers of inner nodes, the number of fine cells in each
// original cell


$rule pointwise(num_inner_nodes <- cellPlan,
(lower, upper, boundary_map)->(is_quadface, facePlan),
(lower, upper, boundary_map)->face2edge->edgePlan,
(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(gnrlcells) {
  if($cellPlan.size() == 0) {
    $num_inner_nodes = 0 ;
    return ;
  }

  std::list<Node*> bnode_list ; // boundary node
  std::list<Node*> node_list ; // inner node
  std::list<Edge*> edge_list ;
  std::list<Face*> face_list ;

  Cell* aCell = build_general_cell($lower.begin(), $lower.size(),
                                   $upper.begin(), $upper.size(),
                                   $boundary_map.begin(), $boundary_map.size(),
                                   $*is_quadface,
                                   $*face2node,
                                   $*face2edge,
                                   $*edge2node,
                                   $*pos,
                                   $*edgePlan,
                                   $*facePlan,
                                   bnode_list,
                                   edge_list,
                                   face_list,
                                   $*fileNumber(pos)) ;

  std::vector<DiamondCell*> cells ;
  aCell->resplit($cellPlan,
                 node_list,
                 edge_list,
                 face_list,
                 cells) ;

  $num_inner_nodes = node_list.size() ;

  // clean up
  if(aCell != 0) {
    delete aCell ;
    aCell = 0 ;
  }

  // aCell will clean up these
  cleanup_list(node_list, edge_list, face_list) ;
  cleanup_list(bnode_list) ;
}


$rule pointwise(num_fine_cells <- cellPlan,
(lower, upper, boundary_map)->face2node->fileNumber(pos),
(lower, upper, boundary_map)->face2edge->edge2node->fileNumber(pos)),
constraint(gnrlcells) {
  if($cellPlan.size() == 0) {
    $num_fine_cells = 1 ;
    return ;
  }

  std::list<Node*> node_list ;
  std::list<Edge*> edge_list ;
  std::list<Face*> face_list ;

  Cell* aCell = build_general_cell($lower.begin(), $lower.size(),
                                   $upper.begin(), $upper.size(),
                                   $boundary_map.begin(), $boundary_map.size(),
                                   $*face2node,
                                   $*face2edge,
                                   $*edge2node,
                                   node_list,
                                   edge_list,
                                   face_list,
                                   $*fileNumber(pos)) ;

  $num_fine_cells = aCell->empty_resplit($cellPlan) ;

  // clean up
  if(aCell != 0) {
    delete aCell ;
    aCell = 0 ;
  }

  // aCell will clean up these
  cleanup_list(node_list, edge_list, face_list) ;
}


$rule pointwise(quadface::num_inner_nodes <- facePlan,
face2edge->edgePlan,
face2edge->edge2node->pos,
face2node->pos),
constraint(faces) {
  if($facePlan.size() == 0) {
    $num_inner_nodes = 0 ;
    return ;
  }

  std::list<Node*> bnode_list ;
  std::list<Node*> node_list ;
  std::list<Edge*> edge_list ;

  Face* aFace = build_general_face($face2node.begin(), $face2node.size(),
                                   $face2edge.begin(),
                                   $*edge2node,
                                   $*pos,
                                   $*edgePlan,
                                   bnode_list,
                                   edge_list) ;

  aFace->resplit($facePlan,
                 node_list,
                 edge_list) ;

  $num_inner_nodes = node_list.size() ;

  // clean up
  if(aFace != 0) {
    delete aFace ;
    aFace = 0 ;
  }
  cleanup_list(node_list, edge_list) ;
  cleanup_list(bnode_list) ;
}


$rule pointwise(num_inner_nodes <- edgePlan),
constraint(edge2node->pos) {
  int num = 0 ;
  if($edgePlan.size() != 0) {
    for(unsigned int i = 0; i < $edgePlan.size(); i++) {
      if($edgePlan[i] == 1) num++ ;
    }
  }
  $num_inner_nodes = num ;
}


$rule pointwise(priority::c2p::balanced_num_fine_cells,
parent_num_fine_cells, indexMap <- balancedCellPlan, parentPlan,
(lower, upper, boundary_map)->face2node->fileNumber(pos),
(lower, upper, boundary_map)->face2edge->edge2node->fileNumber(pos)),
constraint(gnrlcells) {
  // both former cycle and current cycle didn't split this cell
  if($balancedCellPlan.size() == 0 && $parentPlan.size() == 0) {
    $balanced_num_fine_cells = 1 ;
    $parent_num_fine_cells = 1 ;
    $indexMap.push_back(make_pair(1, 1)) ;
    reduce_vector($indexMap) ;
    return ;
  }

  std::list<Node*> node_list ;
  std::list<Edge*> edge_list ;
  std::list<Face*> face_list ;

  Cell* aCell = build_general_cell($lower.begin(), $lower.size(),
                                   $upper.begin(), $upper.size(),
                                   $boundary_map.begin(), $boundary_map.size(),
                                   $*face2node,
                                   $*face2edge,
                                   $*edge2node,
                                   node_list,
                                   edge_list,
                                   face_list,
                                   $*fileNumber(pos)) ;

  $parent_num_fine_cells = aCell->empty_resplit($parentPlan) ;
  $balanced_num_fine_cells = aCell->empty_resplit($balancedCellPlan) ;
  aCell->traverse($parentPlan, $indexMap) ;
  reduce_vector($indexMap) ;

  // clean up
  if(aCell != 0) {
    delete aCell ;
    aCell = 0 ;
  }

  // aCell will clean up these
  cleanup_list(node_list, edge_list, face_list) ;
}
