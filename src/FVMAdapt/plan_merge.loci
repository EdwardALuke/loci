#include <list>
#include <vector>

#include <Loci.h>
#include "defines.h"
#include "diamondcell.h"
#include "face.h"
#include "hex_defines.h"
#include "hexcell.h"
#include "prism.h"
#include "transfer_plan.h"
#include "quadface.h"

$include "FVM.lh"
$include "fvmadapt_internal.lh"

using namespace Loci ;
using std::cerr ;
using std::endl ;
using std::list ;
using std::vector ;

//-----------------------------------------------------------------------------
// General-cell face plans
//-----------------------------------------------------------------------------

$rule pointwise(facePlan <- (cl, cr)->cellPlan,
(cl, cr)->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)), //dummy
(cl, cr)->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint((cl, cr)->gnrlcells) {
  $facePlan.clear() ;
  std::vector<char> facePlanL = extract_general_face($cl->$lower.begin(),
                                                     $*lower.num_elems($cl),
                                                     $cl->$upper.begin(),
                                                     $*upper.num_elems($cl),
                                                     $cl->$boundary_map.begin(),
                                                     $*boundary_map.num_elems($cl),
                                                     $*face2node, $*face2edge,
                                                     $*edge2node, $cl->$cellPlan,
                                                     _e_, $*fileNumber(pos)) ;

  std::vector<char> facePlanR = extract_general_face($cr->$lower.begin(),
                                                     $*lower.num_elems($cr),
                                                     $cr->$upper.begin(),
                                                     $*upper.num_elems($cr),
                                                     $cr->$boundary_map.begin(),
                                                     $*boundary_map.num_elems($cr),
                                                     $*face2node, $*face2edge,
                                                     $*edge2node, $cr->$cellPlan,
                                                     _e_, $*fileNumber(pos)) ;
  
  $facePlan = merge_faceplan(facePlanL, facePlanR, $*face2node.num_elems(_e_)) ;
  reduce_vector($facePlan) ;
}

$rule pointwise(facePlan <- cl->cellPlan,
cl->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)), //dummy
cl->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(boundary_faces, cl->gnrlcells) {
  $facePlan = extract_general_face($cl->$lower.begin(), $*lower.num_elems($cl),
                                   $cl->$upper.begin(), $*upper.num_elems($cl),
                                   $cl->$boundary_map.begin(),
                                   $*boundary_map.num_elems($cl),
                                   $*face2node, $*face2edge, $*edge2node,
                                   $cl->$cellPlan, _e_, $*fileNumber(pos)) ;
  reduce_vector($facePlan) ;
}


//-----------------------------------------------------------------------------
// Hex-cell face plans
//-----------------------------------------------------------------------------


// This rule first extracts faceplan from cl and cr, then merges them into one
// final plan in the face's local coordinates system.
//
// To merge the plans, use a queue of ranges to simulate the tree splitting
// process, and put the inner eges in list xEdge and yEdges according to their
// directions.
//
// Then sort and unique xEdge and yEdge. and then merge all the overlapped
// edges. 
//
// The last step is compose a new refinement plan according to xEdges and
// yEdges. Search the inner edges of a parent cell, the result implies the
// split code. Repeat the same process for each child.

$rule pointwise(facePlan <- (cl, cr)->cellPlan,
(cl, cr)->hexOrientCode, fl, fr), constraint(interior_faces, (cl, cr)->hexcells) {
  std::vector<char> facePlanL = extract_hex_face($cl->$cellPlan, DIRECTION($fl)) ;
  std::vector<char> facePlanR = extract_hex_face($cr->$cellPlan, DIRECTION($fr)) ;
  $facePlan = merge_quad_face(facePlanL, $cl->$hexOrientCode[$fl],
                              facePlanR, $cr->$hexOrientCode[$fr]) ;
  reduce_vector($facePlan) ;
}

$rule pointwise(facePlan <- cl->cellPlan, cl->hexOrientCode, fl),
constraint(boundary_faces, cl->hexcells) {
  std::vector<char> facePlanL = extract_hex_face($cl->$cellPlan, DIRECTION($fl)) ;
  $facePlan = merge_quad_face(facePlanL, $cl->$hexOrientCode[$fl]) ;
  reduce_vector($facePlan) ;
}


//-----------------------------------------------------------------------------
// Prism-cell face plans
//-----------------------------------------------------------------------------


// This rule first extracts faceplan from cl and cr, then merges them into one
// final plan in the face's local coordinates system.
//
// To merge the plans, use a queue of ranges to simulate the tree splitting
// process, and put the inner eges in list xEdge and yEdges according to their
// directions.
//
// Then sort and unique xEdge and yEdge. and then merge all the overlapped
// edges.   
//
// The last step is compose a new refinement plan according to xEdges and
// yEdges. Search the inner edges of a parent cell, the result implies the
// split code. Repeat the same process for each child.

$rule pointwise(facePlan <- (cl, cr)->cellPlan,
(cl, cr)->prismOrientCode, fl, fr), constraint(interior_faces, (cl, cr)->prisms) {
  if($fl < 2) {
    $facePlan = merge_tri_face_pp($cl->$cellPlan, $fl, $cl->$prismOrientCode[$fl],
                                  $cr->$cellPlan, $fr, $cr->$prismOrientCode[$fr]) ;
  }else {
    $facePlan = merge_quad_face_pp($cl->$cellPlan, $fl, $cl->$prismOrientCode[$fl],
                                   $cr->$cellPlan, $fr, $cr->$prismOrientCode[$fr]) ;
  }
  reduce_vector($facePlan) ;
}

$rule pointwise(facePlan <- cl->cellPlan, cl->prismOrientCode, fl),
constraint(boundary_faces, cl->prisms) {
  if($fl < 2) {
    $facePlan = merge_tri_face_p($cl->$cellPlan, $fl, $cl->$prismOrientCode[$fl]) ;
  }else {
    $facePlan = merge_quad_face_p($cl->$cellPlan, $fl, $cl->$prismOrientCode[$fl]) ;
  }
  reduce_vector($facePlan) ;
}


//-----------------------------------------------------------------------------
// Mixed-cell face plans
//-----------------------------------------------------------------------------


$rule pointwise(facePlan <- (cl, cr)->cellPlan, cr->hexOrientCode, fr,
cl->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)), 
cl->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(cl->gnrlcells, cr->hexcells) {
  $facePlan.clear() ;
  std::vector<char> localPlanL = extract_general_face(
    $cl->$lower.begin(), $*lower.num_elems($cl),
    $cl->$upper.begin(), $*upper.num_elems($cl),
    $cl->$boundary_map.begin(), $*boundary_map.num_elems($cl),
    $*face2node, $*face2edge, $*edge2node, $cl->$cellPlan, _e_,
    $*fileNumber(pos)) ;
  std::vector<char> facePlanL = transfer_plan_g2q(localPlanL) ;
  std::vector<char> facePlanR = extract_hex_face($cr->$cellPlan, DIRECTION($fr)) ;
  $facePlan = merge_quad_face(facePlanL, static_cast<char>(0), facePlanR,
                              $cr->$hexOrientCode[$fr]);
  reduce_vector($facePlan) ;
}

$rule pointwise(facePlan <- (cl, cr)->cellPlan, cl->hexOrientCode, fl,
cr->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)), 
cr->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(cr->gnrlcells, cl->hexcells) {
  $facePlan.clear() ;
  std::vector<char> localPlanR = extract_general_face(
    $cr->$lower.begin(), $*lower.num_elems($cr),
    $cr->$upper.begin(), $*upper.num_elems($cr),
    $cr->$boundary_map.begin(), $*boundary_map.num_elems($cr),
    $*face2node, $*face2edge, $*edge2node, $cr->$cellPlan, _e_,
    $*fileNumber(pos)) ;
  std::vector<char> facePlanR = transfer_plan_g2q(localPlanR) ;
  std::vector<char> facePlanL = extract_hex_face($cl->$cellPlan, DIRECTION($fl)) ;
  $facePlan = merge_quad_face(facePlanR, static_cast<char>(0), facePlanL,
                              $cl->$hexOrientCode[$fl]);
  reduce_vector($facePlan) ;
}

$rule pointwise(facePlan <- (cl, cr)->cellPlan, cr->prismOrientCode, fr,
cl->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)), 
cl->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(cl->gnrlcells, cr->prisms) {
  $facePlan.clear() ;
  std::vector<char> localPlanL = extract_general_face(
    $cl->$lower.begin(), $*lower.num_elems($cl),
    $cl->$upper.begin(), $*upper.num_elems($cl),
    $cl->$boundary_map.begin(), $*boundary_map.num_elems($cl),
    $*face2node, $*face2edge, $*edge2node, $cl->$cellPlan, _e_,
    $*fileNumber(pos)) ;

  if($fr < 2) {
    std::vector<char> facePlanR = merge_tri_face_p($cr->$cellPlan, $fr,
                                                   $cr->$prismOrientCode[$fr]) ;
    $facePlan = merge_faceplan(localPlanL, facePlanR, $*face2node.num_elems(_e_)) ;
  }else {
    std::vector<char> facePlanR = extract_prism_face($cr->$cellPlan, $fr) ;
    std::vector<char> facePlanL = transfer_plan_g2q(localPlanL) ;
    $facePlan = merge_quad_face(facePlanL, static_cast<char>(0), facePlanR,
                                $cr->$prismOrientCode[$fr]);
  }
  reduce_vector($facePlan) ;
}

$rule pointwise(facePlan <- (cl, cr)->cellPlan, cl->prismOrientCode, fl,
cr->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)), 
cr->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(cr->gnrlcells, cl->prisms) {
  $facePlan.clear();
  std::vector<char> localPlanR = extract_general_face(
    $cr->$lower.begin(), $*lower.num_elems($cr),
    $cr->$upper.begin(), $*upper.num_elems($cr),
    $cr->$boundary_map.begin(), $*boundary_map.num_elems($cr),
    $*face2node, $*face2edge, $*edge2node, $cr->$cellPlan, _e_,
    $*fileNumber(pos)) ;

  if($fl < 2) {
    std::vector<char> facePlanL = merge_tri_face_p($cl->$cellPlan, $fl,
                                                   $cl->$prismOrientCode[$fl]);
    $facePlan = merge_faceplan(facePlanL, localPlanR, $*face2node.num_elems(_e_)) ;
  }else {
    std::vector<char> facePlanL = extract_prism_face($cl->$cellPlan, $fl) ;
    std::vector<char> facePlanR = transfer_plan_g2q(localPlanR) ;
    $facePlan = merge_quad_face(facePlanR, static_cast<char>(0), facePlanL,
                                $cl->$prismOrientCode[$fl]);
  }
  reduce_vector($facePlan) ;
}

$rule pointwise(facePlan <- (cl, cr)->cellPlan, cr->prismOrientCode,
cl->hexOrientCode, fl, fr), constraint(cl->hexcells, cr->prisms) {
  std::vector<char> facePlanL = extract_hex_face($cl->$cellPlan, DIRECTION($fl)) ;
  std::vector<char> facePlanR = extract_prism_face($cr->$cellPlan, $fr) ;
  $facePlan = merge_quad_face(facePlanL, $cl->$hexOrientCode[$fl], facePlanR,
                              $cr->$prismOrientCode[$fr]);
  reduce_vector($facePlan) ;
}

$rule pointwise(facePlan <- (cl, cr)->cellPlan, cl->prismOrientCode,
cr->hexOrientCode, fl, fr), constraint(cr->hexcells, cl->prisms) {
  std::vector<char> facePlanR = extract_hex_face($cr->$cellPlan, DIRECTION($fr)) ;
  std::vector<char> facePlanL = extract_prism_face($cl->$cellPlan, $fl) ;
  $facePlan = merge_quad_face(facePlanL, $cl->$prismOrientCode[$fl], facePlanR,
                              $cr->$hexOrientCode[$fr]);
  reduce_vector($facePlan) ;
}


//-----------------------------------------------------------------------------
// Edge plans
//-----------------------------------------------------------------------------

$type pointSet store<SetLong> ;


$rule unit(pointSet <- planname_par), constraint(edge2node->pos) {
}

$rule apply(face2edge->pointSet <- planname_par, facePlan, is_quadface,
face2node->pos, face2edge->edge2node->pos, face2edge->pointSet)[SetLongUnionOp],
constraint(faces) {
  if($facePlan.size() == 0) { return ; }

  if($is_quadface && $face2node.size() != 4) {
    cerr << "WARNING: quadrilateral face must have four nodes" << endl ;
    Loci::Abort() ;
  }

  const int edgeCount = $is_quadface ? $face2edge.size() : $face2node.size() ;
  std::vector<bool> edgeReversed(edgeCount, false) ;

  if($is_quadface) {
    for(int i=0; i<edgeCount; i++) {
      if(i == 0 && $face2edge[0]->$edge2node[0] == $face2node[1]) {
        edgeReversed[i] = true ;
      }else if(i == 1 && $face2edge[1]->$edge2node[0] == $face2node[2]) {
        edgeReversed[i] = true ;
      }else if(i == 2 && $face2edge[2]->$edge2node[0] == $face2node[2]) {
        edgeReversed[i] = true ;
      }else if(i == 3 && $face2edge[3]->$edge2node[0] == $face2node[3]) {
        edgeReversed[i] = true ;
      }
    }
  }else {
    for(int i=0; i<edgeCount; i++) {
      edgeReversed[i] =
        !($face2edge[i]->$edge2node[0] == $face2node[i] &&
          $face2edge[i]->$edge2node[1] ==
            $face2node[i==(edgeCount-1)?0:i+1]) ;
    }
  }

  const std::vector<SetLong> edgeSplits =
    face_edge_splits($facePlan, $is_quadface, edgeReversed) ;
  for(int i=0; i<edgeCount; i++) {
    if(edgeSplits[i].aset.empty()) { continue ; }
    join($face2edge[i]->$pointSet, edgeSplits[i]) ;
  }
}

$rule pointwise(edgePlan <- pointSet), constraint(edge2node->pos) {
  if($pointSet.aset.empty()) { return ; }
  encode_edge_plan($pointSet, $edgePlan) ;
}
