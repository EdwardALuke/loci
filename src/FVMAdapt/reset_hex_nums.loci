#include <iostream>
#include <queue>
#include <vector>
#include <map>
#include <set>
#include <Loci.h>
#include <Tools/tools.h>
#include "hexcell.h"

using std::queue;
using std::cerr;
using std::cout;
using std::endl;
using std::set;
using std::map;
using Loci::storeRepP;

$include "FVM.lh"
$include "fvmadapt_internal.lh"

$rule pointwise(balanced_num_inner_nodes <- balancedCellPlan,
hex2face, hex2node, hexOrientCode,
(lower, upper, boundary_map)->balancedFacePlan,
(lower, upper, boundary_map)->face2edge->balancedEdgePlan,
(lower, upper, boundary_map)->face2node->pos,
(lower, upper, boundary_map)->face2edge->edge2node,
(lower, upper, boundary_map)->(fileNumber(face2node), face2edge)),
constraint(hexcells) {

  if($balancedCellPlan.size() == 0) {
    $balanced_num_inner_nodes = 0 ;
    return ;
  }

  std::list<Node*> bnode_list ; //boundary node
  std::list<Node*> node_list ; //inner node
  std::list<Edge*> edge_list ;
  std::list<QuadFace*> face_list ;
    
  HexCell* aCell = build_hex_cell($lower.begin(), $lower.size(),
                                  $upper.begin(), $upper.size(),
                                  $boundary_map.begin(), $boundary_map.size(),
                                  $hex2face,
                                  $hex2node,
                                  $hexOrientCode,
                                  $*face2node,
                                  $*face2edge,
                                  $*edge2node,
                                  $*pos,
                                  $*balancedEdgePlan,
                                  $*balancedFacePlan,
                                  bnode_list,
                                  edge_list,
                                  face_list,
                                  $*fileNumber(face2node)) ;
    
  std::vector<HexCell*> cells ;
  aCell->resplit($balancedCellPlan,
                 node_list,
                 edge_list,
                 face_list,
                 cells) ;

  $balanced_num_inner_nodes = node_list.size() ;

  //clean up
  if(aCell != 0) {
    delete aCell ;
    aCell = 0 ;
  }

  //aCell will clean up these
  cleanup_list(bnode_list, edge_list, face_list) ;
  cleanup_list(node_list) ;
}

$rule pointwise(balanced_num_fine_cells <- balancedCellPlan),
constraint(hexcells) {
  HexCell* aCell = new HexCell ;
  $balanced_num_fine_cells = aCell->num_fine_cells($balancedCellPlan) ;
  delete aCell ;
}

$rule pointwise(priority::quadface::balanced_num_inner_nodes <- balancedFacePlan,
face2edge->(balancedEdgePlan, edge2node), face2node->pos),
constraint(quadfaces) {

  if($balancedFacePlan.size() == 0) {
    $balanced_num_inner_nodes = 0 ;
    return ;
  }

  std::list<Node*> bnode_list ;
  std::list<Node*> node_list ;
  std::list<Edge*> edge_list ;
   
    
  QuadFace* aFace = build_quad_face($face2node.begin(),
                                    $face2edge.begin(),
                                    $*edge2node,
                                    $*pos,
                                    $*balancedEdgePlan,
                                    bnode_list,
                                    edge_list) ;
           
  aFace->resplit($balancedFacePlan,
                 char(0),
                 node_list,
                 edge_list) ;
    
    
  $balanced_num_inner_nodes = node_list.size() ;
    
  //clean up
  if(aFace != 0) {
    delete aFace ;
    aFace = 0 ;
  }
    
  cleanup_list(bnode_list, edge_list) ;
  cleanup_list(node_list) ;
    
}
