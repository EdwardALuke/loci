#include <Loci.h>
#include <FVMAdapt/parametric_cell.h>
#include "parametric_face_data.h"
#include <FVMAdapt/gridInterface.h>
#include <FVMAdapt/parametric/geometry_quality.h>
#include <FVMAdapt/parametric/hex_plan.h>
#include <algorithm>
#include <map>
#include <set>
#include <stdexcept>

$include "FVM.lh"
$include "fvmadapt_internal.lh"
$include "parametric_internal.lh"

namespace {
  namespace P = Loci::FVMAdapt ;
  template<class T> struct ParametricTraceUnion {
    void operator()(T &target, const T &source) {
      if(&target == &source) return ;
      target.insert(target.end(),source.begin(),source.end()) ;
      std::sort(target.begin(),target.end()) ;
      target.erase(std::unique(target.begin(),target.end()),target.end()) ;
    }
  } ;
  Loci::FineFaces edgeRows(const Loci::FineFaces &rows, int edge) {
    Loci::FineFaces result ;
    for(const auto &row: rows) if(row[0] == edge) result.push_back(row) ;
    return result ;
  }
}

//-----------------------------------------------------------------------------
// Requested edits and shared-face agreement
//-----------------------------------------------------------------------------

/// Accepted face/edge divisions contributed by incident cells before new requests.
$type initialParametricFacePlan store<Loci::FVMAdapt::FacePlanData> ;

$rule unit(initialParametricFacePlan), constraint(faces) {
  $initialParametricFacePlan = P::FacePlanData() ;
}

$rule apply((lower,upper,boundary_map)->initialParametricFacePlan <- initialParametricCell,parametricInitialError,
  (lower,upper,boundary_map)->fileNumber(face2node))[ParametricMerge], constraint(geom_cells) {
  if(!$parametricInitialError.empty()) return ;
  const auto contribute = [&](int face) {
    P::FacePlanData value ;
    try { value.plan = $initialParametricCell.facePlan($*fileNumber(face2node)[face]) ; }
    catch(const std::exception &) { value.failed = true ; }
    join($*initialParametricFacePlan[face],value) ;
  } ;
  for(int face:$lower) contribute(face) ;
  for(int face:$upper) contribute(face) ;
  for(int face:$boundary_map) contribute(face) ;
}

/// Candidate history and local failure in the grading iteration.
$type tmpParametricCell store<Loci::FVMAdapt::ParametricCellData> ;
$type tmpParametricError store<std::string> ;
/// Number of completed neighbor-grading rounds for this candidate.
$type parametricRound store<int> ;
$type parametricCellUnchanged store<bool> ;
$type parametricAllUnchanged param<bool> ;
$type parametricAnyFailure param<bool> ;
$type finishParametricBalancing param<bool> ;

/// Merge shared face choices and apply requested cell edits.
$rule pointwise(tmpParametricCell{parametricBalance=0},tmpParametricError{parametricBalance=0},
  parametricCellUnchanged{parametricBalance=0},parametricRound{parametricBalance=0} <- initialParametricCell,parametricInitialError,
  (lower,upper,boundary_map)->(initialParametricFacePlan,fileNumber(face2node)),
  (lower,upper,boundary_map)->face2edge->parametricSourceEdgeGeometry,
  parametricRequests,parametricControls,parametricRegion,parametricSources,parametricInputError), constraint(geom_cells) {
  $tmpParametricCell{parametricBalance=0} = $initialParametricCell ;
  $tmpParametricError{parametricBalance=0} = $parametricInitialError ;
  $parametricCellUnchanged{parametricBalance=0} = false ; $parametricRound{parametricBalance=0} = 0 ;
  if($parametricInitialError.empty()) try {
    if(!$parametricInputError.empty()) throw std::invalid_argument($parametricInputError) ;
    const auto &options=$parametricControls.refinement ;
    P::GeometricRefinement selection ;
    if($parametricRegion) selection=P::GeometricRefinement::region([&](const P::Point &p) { return ($parametricRegion)->contains(p) ; },options.minEdgeLength) ;
    else if(!$parametricSources.empty()) selection=P::GeometricRefinement::sources($parametricSources,options.minEdgeLength) ;
    P::IncomingFacePlans incoming ;
    const auto checkFace = [&](int face) {
      for(int edge:$*face2edge[face]) {
        const auto &curve=$*parametricSourceEdgeGeometry[edge] ;
        if(!curve.assigned || curve.failed) throw std::invalid_argument("incident cells disagree on source edge geometry") ;
      }
      if($*initialParametricFacePlan[face].failed) throw std::invalid_argument("shared face plans have invalid or conflicting divisions") ;
      const auto &plan=$*initialParametricFacePlan[face].plan ; const P::EntityId id=$*fileNumber(face2node)[face] ;
      if($initialParametricCell.needsFaceMerge(id,plan)) incoming.push_back({id,plan}) ;
    } ;
    for(int face:$lower) checkFace(face) ; for(int face:$upper) checkFace(face) ; for(int face:$boundary_map) checkFace(face) ;
    $tmpParametricCell{parametricBalance=0}=$initialParametricCell.applyRequests($parametricRequests,options,incoming,selection) ;
  } catch(const std::exception &error) { $tmpParametricError{parametricBalance=0} = error.what() ; }
}

//-----------------------------------------------------------------------------
// Neighbor grading
//-----------------------------------------------------------------------------

/// Original-edge interval rows; see parametricEdgeTrace() for their layout.
$type parametricCellEdges store<Loci::FineFaces> ;
/// Rows [original vertex file ID, greatest touching leaf depth] for this candidate.
$type parametricCellVertices store<Loci::FineFaces> ;
/// Indices in this candidate's leafIds() requiring local grading.
$type parametricLocalRequests store<std::vector<int> > ;
/// Per-original-cell failure while collecting boundary data and local requests.
$type parametricCheckError store<std::string> ;
/// Select the vertex reductions only for vertex grading.
$type parametricVertexGrading Constraint ;
$type parametricNoVertexGrading Constraint ;
$rule constraint(parametricVertexGrading,parametricNoVertexGrading <- parametricGrading) {
  $parametricVertexGrading=$parametricGrading=="vertices" ? ~EMPTY:EMPTY ;
  $parametricNoVertexGrading=$parametricGrading=="vertices" ? EMPTY:~EMPTY ;
}
/// Failure while collecting a cell's vertex depths.
$type parametricCellVertexError store<std::string> ;
/// Current leaf indices requiring refinement to meet shared vertex depths.
$type parametricVertexRequests store<std::vector<int> > ;
/// Failure while forming vertex-grading requests.
$type parametricVertexError store<std::string> ;
/// Refinement requests and active divided-face votes from both sides of an original face.
$type parametricFaceRequests store<std::vector<Loci::FVMAdapt::FaceBalanceRequest>> ;
$type parametricFaceError store<std::string> ;
/// Union of accepted source-face cuts for the next balancing round.
$type parametricFacePlan store<Loci::FVMAdapt::FacePlanData> ;
$type parametricEdgeTrace store<Loci::FineFaces> ;
$type parametricVertexDepth store<int> ;

$rule unit(parametricFacePlan), constraint(faces) {
  $parametricFacePlan = P::FacePlanData() ;
}

$rule apply((lower,upper,boundary_map)->parametricFacePlan <- tmpParametricCell,tmpParametricError,
  (lower,upper,boundary_map)->fileNumber(face2node))[ParametricMerge], constraint(geom_cells) {
  if(!$tmpParametricError.empty()) return ;
  const auto contribute = [&](int face) {
    P::FacePlanData value ;
    try { value.plan = $tmpParametricCell.facePlan($*fileNumber(face2node)[face]) ; }
    catch(const std::exception &) { value.failed = true ; }
    join($*parametricFacePlan[face],value) ;
  } ;
  for(int face:$lower) contribute(face) ;
  for(int face:$upper) contribute(face) ;
  for(int face:$boundary_map) contribute(face) ;
}

$rule pointwise(parametricCellEdges,parametricLocalRequests,parametricCheckError <- tmpParametricCell,tmpParametricError,
  parametricTopology,parametricControls), constraint(geom_cells) {
  $parametricCellEdges.clear() ; $parametricLocalRequests.clear() ;
  $parametricCheckError = $tmpParametricError ;
  if($tmpParametricError.empty()) try {
    const auto topology = P::decodeParametricTopology($parametricTopology) ;
    $parametricLocalRequests = $tmpParametricCell.localRequests(topology,$parametricControls.levelDifference,
      $parametricControls.grading,$parametricControls.refinement.extrusionAxis) ;
    $parametricCellEdges = $tmpParametricCell.edgeTrace(topology) ;
  } catch(const std::exception &error) {
    $parametricCheckError = error.what() ; $parametricCellEdges.clear() ; $parametricLocalRequests.clear() ;
  }
}

$rule pointwise(parametricCellVertices,parametricCellVertexError <- tmpParametricCell,parametricCheckError,parametricTopology),
  constraint(parametricVertexGrading,geom_cells) {
  $parametricCellVertices.clear() ; $parametricCellVertexError=$parametricCheckError ;
  if($parametricCheckError.empty()) try {
    const auto topology=P::decodeParametricTopology($parametricTopology) ;
    const auto depths=$tmpParametricCell.vertexDepths(topology) ;
    for(unsigned v=0;v<depths.size();++v) $parametricCellVertices.push_back({int(topology.vertexId(v)),depths[v]}) ;
  } catch(const std::exception &error) { $parametricCellVertexError=error.what() ; $parametricCellVertices.clear() ; }
}

$rule pointwise(parametricFaceRequests,parametricFaceError <- (cl,cr)->(tmpParametricCell,parametricTopology,parametricCheckError),fileNumber(face2node),
  parametricControls), constraint(interior_faces) {
  $parametricFaceRequests.clear() ; $parametricFaceError.clear() ;
  if($cl->$parametricCheckError.empty() && $cr->$parametricCheckError.empty()) try {
    const auto left=P::decodeParametricTopology($cl->$parametricTopology), right=P::decodeParametricTopology($cr->$parametricTopology) ;
    const auto requests=$cl->$tmpParametricCell.faceRequests($fileNumber(face2node),left,$cr->$tmpParametricCell,right,
      $parametricControls.levelDifference,$parametricControls.grading) ;
    for(const auto &row:requests) $parametricFaceRequests.push_back({row[0],row[1],-1}) ;
    if($parametricControls.faceBalance!=P::FaceBalance::none || $parametricControls.directionalBalance) {
      const auto divided=$cl->$tmpParametricCell.dividedFaces($fileNumber(face2node),left,$cr->$tmpParametricCell,right,$parametricControls.directionalBalance) ;
      $parametricFaceRequests.insert($parametricFaceRequests.end(),divided.begin(),divided.end()) ;
    }
  } catch(const std::exception &error) { $parametricFaceError = error.what() ; }
}
$rule pointwise(parametricFaceRequests,parametricFaceError), constraint(boundary_faces) {
  $parametricFaceRequests.clear() ; $parametricFaceError.clear() ;
}
$rule unit(parametricEdgeTrace), constraint(edge2node->pos) { $parametricEdgeTrace.clear() ; }
$rule unit(parametricVertexDepth), constraint(parametricVertexGrading,pos) { $parametricVertexDepth = 0 ; }

$rule apply(face2edge->parametricEdgeTrace <- cl->parametricCellEdges,face2edge->fileNumber(edge2node))[ParametricTraceUnion], constraint(faces) {
  for(int edge: $face2edge) join($*parametricEdgeTrace[edge],edgeRows($cl->$parametricCellEdges,$*fileNumber(edge2node)[edge])) ;
}
$rule apply(face2node->parametricVertexDepth <- cl->parametricCellVertices,face2node->fileNumber(pos))[Loci::Maximum], constraint(parametricVertexGrading,faces) {
  for(int node: $face2node)
    for(const auto &row: $cl->$parametricCellVertices)
      if(row[0] == $*fileNumber(pos)[node]) join($*parametricVertexDepth[node],row[1]) ;
}

$rule apply(face2edge->parametricEdgeTrace <- cr->parametricCellEdges,face2edge->fileNumber(edge2node))[ParametricTraceUnion], constraint(interior_faces) {
  for(int edge: $face2edge) join($*parametricEdgeTrace[edge],edgeRows($cr->$parametricCellEdges,$*fileNumber(edge2node)[edge])) ;
}
$rule apply(face2node->parametricVertexDepth <- cr->parametricCellVertices,face2node->fileNumber(pos))[Loci::Maximum], constraint(parametricVertexGrading,interior_faces) {
  for(int node: $face2node)
    for(const auto &row: $cr->$parametricCellVertices)
      if(row[0] == $*fileNumber(pos)[node]) join($*parametricVertexDepth[node],row[1]) ;
}

/// Convert shared vertex depths to leaf requests within each original cell.
$rule pointwise(parametricVertexRequests,parametricVertexError <- tmpParametricCell,parametricCellVertexError,parametricTopology,
  (lower,upper,boundary_map)->face2node->(fileNumber(pos),parametricVertexDepth),parametricControls),
  constraint(parametricVertexGrading,geom_cells) {
  $parametricVertexRequests.clear() ; $parametricVertexError=$parametricCellVertexError ;
  if($parametricCellVertexError.empty()) try {
    std::map<P::EntityId,int> vertices ;
    const auto addFace=[&](int face) {
      for(int node:$*face2node[face]) vertices[$*fileNumber(pos)[node]]=$*parametricVertexDepth[node] ;
    } ;
    for(int face:$lower) addFace(face) ; for(int face:$upper) addFace(face) ; for(int face:$boundary_map) addFace(face) ;
    $parametricVertexRequests=$tmpParametricCell.vertexRequests(P::decodeParametricTopology($parametricTopology),vertices,
      $parametricControls.levelDifference) ;
  } catch(const std::exception &error) { $parametricVertexError=error.what() ; }
}

$rule pointwise(parametricVertexRequests,parametricVertexError), constraint(parametricNoVertexGrading,geom_cells) {
  $parametricVertexRequests.clear() ; $parametricVertexError.clear() ;
}

/// Refine required leaves and accept shared divisions; otherwise reuse the cell.
$rule pointwise(tmpParametricCell{parametricBalance+1},tmpParametricError{parametricBalance+1},parametricRound{parametricBalance+1},
  parametricCellUnchanged{parametricBalance+1} <- tmpParametricCell{parametricBalance},parametricCheckError{parametricBalance},
  parametricRound{parametricBalance},parametricLocalRequests{parametricBalance},parametricTopology,initialParametricCell,
  (lower,upper,boundary_map)->(parametricFaceRequests{parametricBalance},parametricFaceError{parametricBalance},parametricFacePlan{parametricBalance},fileNumber(face2node)),
  (lower,upper,boundary_map)->face2edge->parametricEdgeTrace{parametricBalance},
  parametricVertexRequests{parametricBalance},parametricVertexError{parametricBalance},
  parametricControls), constraint(geom_cells) {
  $tmpParametricCell{parametricBalance+1} = $tmpParametricCell{parametricBalance} ;
  $tmpParametricError{parametricBalance+1} = $parametricCheckError{parametricBalance} ;
  $parametricRound{parametricBalance+1} = $parametricRound{parametricBalance} ;
  if($parametricRound{parametricBalance+1} < $parametricControls.maxRounds)
    ++$parametricRound{parametricBalance+1} ;
  $parametricCellUnchanged{parametricBalance+1} = true ;
  if($parametricCheckError{parametricBalance}.empty()) try {
    if(!$parametricVertexError{parametricBalance}.empty()) throw std::invalid_argument($parametricVertexError{parametricBalance}) ;
    const auto topology = P::decodeParametricTopology($parametricTopology) ;
    const auto grading = $parametricControls.grading ;
    P::IncomingFacePlans sharedFacePlans ;
    std::set<int> leavesToRefine($parametricLocalRequests{parametricBalance}.begin(),$parametricLocalRequests{parametricBalance}.end()) ;
    std::set<int> visitedEdges ;
    leavesToRefine.insert($parametricVertexRequests{parametricBalance}.begin(),$parametricVertexRequests{parametricBalance}.end()) ;
    std::vector<P::FaceBalanceRequest> dividedFaces ;
    const auto addFace = [&](int face) {
      if(!$*parametricFaceError{parametricBalance}[face].empty()) throw std::invalid_argument($*parametricFaceError{parametricBalance}[face]) ;
      if($*parametricFacePlan{parametricBalance}[face].failed) throw std::invalid_argument("shared face plans have invalid or conflicting divisions") ;
      const auto &plan=$*parametricFacePlan{parametricBalance}[face].plan ;
      const P::EntityId id=$*fileNumber(face2node)[face] ;
      if($tmpParametricCell{parametricBalance}.needsFaceMerge(id,plan)) sharedFacePlans.push_back({id,plan}) ;
      for(const auto &row: $*parametricFaceRequests{parametricBalance}[face]) if(P::EntityId(row.root)==topology.id()) {
        if(row.face<0) leavesToRefine.insert(row.leaf) ;
        else dividedFaces.push_back(row) ;
      }
      for(int edge: $*face2edge[face]) if(visitedEdges.insert(edge).second) {
        const auto edgeRequests = P::parametricEdgeRequests(topology.id(),$*parametricEdgeTrace{parametricBalance}[edge],$parametricControls.levelDifference,grading) ;
        leavesToRefine.insert(edgeRequests.begin(),edgeRequests.end()) ;
      }
    } ;
    for(int face: $lower) addFace(face) ;
    for(int face: $upper) addFace(face) ;
    for(int face: $boundary_map) addFace(face) ;
    std::map<int,unsigned> splitDirections ;
    const auto faceRequests=$tmpParametricCell{parametricBalance}.faceBalanceRequests(topology,dividedFaces,
      $parametricControls.faceBalance,$parametricControls.directionalBalance ? &splitDirections:nullptr) ;
    leavesToRefine.insert(faceRequests.begin(),faceRequests.end()) ;
    if(leavesToRefine.empty() && sharedFacePlans.empty()) return ;
    if(!leavesToRefine.empty() && $parametricRound{parametricBalance}>=$parametricControls.maxRounds)
      throw std::length_error("parametric grading round limit exceeded") ;
    bool changed=false ;
    const auto balancedCell=$tmpParametricCell{parametricBalance}.balance(leavesToRefine,splitDirections,$initialParametricCell,
      $parametricControls.refinement.center,$parametricControls.refinement.extrusionAxis,sharedFacePlans,changed) ;
    if(changed) {
      if($parametricRound{parametricBalance}>=$parametricControls.maxRounds) throw std::length_error("parametric grading round limit exceeded") ;
      $parametricCellUnchanged{parametricBalance+1}=false ;
      $tmpParametricCell{parametricBalance+1}=balancedCell ;
    }
  } catch(const std::exception &error) { $tmpParametricError{parametricBalance+1} = error.what() ; }
}

//-----------------------------------------------------------------------------
// Collective acceptance and retained history
//-----------------------------------------------------------------------------

$rule unit(parametricAllUnchanged), constraint(geom_cells) { $parametricAllUnchanged = true ; }
$rule apply(parametricAllUnchanged <- parametricCellUnchanged)[Loci::LogicalAnd], constraint(geom_cells) {
  join($parametricAllUnchanged,$parametricCellUnchanged) ;
}
$rule unit(parametricAnyFailure), constraint(geom_cells) { $parametricAnyFailure = false ; }
$rule apply(parametricAnyFailure <- tmpParametricError)[Loci::LogicalOr], constraint(geom_cells) {
  join($parametricAnyFailure,!$tmpParametricError.empty()) ;
}
$rule singleton(finishParametricBalancing <- parametricAllUnchanged,parametricAnyFailure), constraint(geom_cells) {
  $finishParametricBalancing = $parametricAllUnchanged || $parametricAnyFailure ;
}
$rule unit(parametricBalanced), constraint(UNIVERSE) { $parametricBalanced=true ; }
$rule apply(parametricBalanced <- candidateParametricError)[Loci::LogicalAnd], constraint(geom_cells) {
  join($parametricBalanced,$candidateParametricError.empty()) ;
}
$rule pointwise(candidateParametricCell,candidateParametricError <- tmpParametricCell{parametricBalance},tmpParametricError{parametricBalance},initialParametricCell,
  parametricAnyFailure{parametricBalance},finishParametricBalancing{parametricBalance}),
  conditional(finishParametricBalancing{parametricBalance}), constraint(geom_cells) {
  $candidateParametricError=$tmpParametricError{parametricBalance} ;
  $candidateParametricCell=$parametricAnyFailure{parametricBalance} ? ($initialParametricCell) : ($tmpParametricCell{parametricBalance}) ;
}
$rule singleton(parametricAccepted <- parametricBalanced,parametricQualityAccepted), constraint(geom_cells) {
  $parametricAccepted=$parametricBalanced && $parametricQualityAccepted ;
}
$rule pointwise(balancedParametricCell,balancedParametricHistory,parametricError <- candidateParametricCell,candidateParametricError,
  parametricAccepted,initialParametricCell,initialParametricHistory,parametricQualityReport,
  parametricControls,parametricTopology), constraint(geom_cells) {
  $balancedParametricCell=$parametricAccepted ? ($candidateParametricCell) : ($initialParametricCell) ;
  $balancedParametricHistory=$parametricAccepted ? ($balancedParametricCell.record()) : ($initialParametricHistory) ;
  $parametricError=$candidateParametricError ;
  if(!$parametricAccepted && $parametricError.empty()) {
    const auto &q=$parametricQualityReport ; const int root=P::decodeParametricTopology($parametricTopology).id() ;
    if(q.invalidRoot==root || q.nonOrthogonality.root==root || q.faceWarpage.root==root || q.childVolumeRatio.root==root) {
      $parametricError=q.description($parametricControls.quality) ;
    }
  }
}

/// Candidate cell edge intervals for shared-edge agreement before final acceptance.
$type parametricCandidateEdges store<Loci::FineFaces> ;
$rule pointwise(parametricCandidateEdges <- candidateParametricCell,parametricTopology,parametricBalanced), constraint(geom_cells) {
  $parametricCandidateEdges.clear() ;
  if(!$parametricBalanced) return ;
  $parametricCandidateEdges=$candidateParametricCell.edgeTrace(P::decodeParametricTopology($parametricTopology)) ;
}
$rule unit(candidateParametricEdgeTrace), constraint(edge2node->pos) { $candidateParametricEdgeTrace.clear() ; }
$rule apply(face2edge->candidateParametricEdgeTrace <- cl->parametricCandidateEdges,face2edge->fileNumber(edge2node))[ParametricTraceUnion],
  constraint(faces) {
  for(int edge:$face2edge) join($*candidateParametricEdgeTrace[edge],edgeRows($cl->$parametricCandidateEdges,$*fileNumber(edge2node)[edge])) ;
}
$rule apply(face2edge->candidateParametricEdgeTrace <- cr->parametricCandidateEdges,face2edge->fileNumber(edge2node))[ParametricTraceUnion],
  constraint(interior_faces) {
  for(int edge:$face2edge) join($*candidateParametricEdgeTrace[edge],edgeRows($cr->$parametricCandidateEdges,$*fileNumber(edge2node)[edge])) ;
}
$rule pointwise(balancedParametricEdgeTrace <- candidateParametricEdgeTrace),conditional(parametricAccepted) {
  $balancedParametricEdgeTrace=$candidateParametricEdgeTrace ;
}
