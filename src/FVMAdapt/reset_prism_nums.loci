#include <iostream>
#include <queue>
#include <vector>
#include <map>
#include <set>
#include <Loci.h>
#include <Tools/tools.h>
#include "prism.h"
$include "FVM.lh"
$include "fvmadapt_internal.lh"

using std::queue ;
using std::cerr ;
using std::cout ;
using std::endl ;
using std::set ;
using std::map ;
using Loci::storeRepP ;

$rule pointwise(balanced_num_inner_nodes <- balancedCellPlan,
prism2face, prism2node, prismOrientCode,
(lower, upper, boundary_map)->balancedFacePlan,
(lower, upper, boundary_map)->face2edge->balancedEdgePlan,
(lower, upper, boundary_map)->face2node->pos,
(lower, upper, boundary_map)->face2edge->edge2node,
(lower, upper, boundary_map)->(fileNumber(face2node), face2edge)),
constraint(prisms) {
  if($balancedCellPlan.size() == 0) {
    $balanced_num_inner_nodes = 0 ;
    return ;
  }

  std::list<Node*> bnode_list ; // boundary node
  std::list<Node*> node_list ; // inner node
  std::list<Edge*> edge_list ;
  std::list<QuadFace*> qface_list ;
  std::list<Face*> gface_list ;
  Prism* aCell = build_prism_cell($lower.begin(), $lower.size(),
                                  $upper.begin(), $upper.size(),
                                  $boundary_map.begin(), $boundary_map.size(),
                                  $prism2face,
                                  $prism2node,
                                  $prismOrientCode,
                                  $*face2node,
                                  $*face2edge,
                                  $*edge2node,
                                  $*pos,
                                  $*balancedEdgePlan,
                                  $*balancedFacePlan,
                                  bnode_list,
                                  edge_list,
                                  qface_list,
                                  gface_list,
                                  $*fileNumber(face2node)) ;

  std::vector<Prism*> cells ;
  aCell->resplit($balancedCellPlan,
                 node_list,
                 edge_list,
                 qface_list,
                 gface_list,
                 cells) ;

  $balanced_num_inner_nodes = node_list.size() ;

  // clean up
  if(aCell != 0) {
    delete aCell ;
    aCell = 0 ;
  }

  // aCell will clean up these
  cleanup_list(bnode_list, edge_list, gface_list) ;
  cleanup_list(qface_list) ;
  cleanup_list(node_list) ;
}


$rule pointwise(balanced_num_fine_cells <- balancedCellPlan),
constraint(prisms) {
  if($balancedCellPlan.size() == 0) {
    $balanced_num_fine_cells = 1 ;
    return ;
  }
  Prism* aCell = new Prism ;
  $balanced_num_fine_cells = aCell->empty_resplit($balancedCellPlan) ;
  //clean up
  if(aCell != 0) {
    delete aCell ;
    aCell = 0 ;
  }
}
