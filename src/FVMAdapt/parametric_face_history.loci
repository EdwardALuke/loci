#include <Loci.h>
#include <FVMAdapt/parametric_cell.h>
$include "FVM.lh"
$include "fvmadapt_internal.lh"
$include "parametric_internal.lh"

using namespace Loci::FVMAdapt ;

/// Failure to construct an accepted cell or original-face patch record.
$type parametricCellPatchError store<std::string> ;
$type parametricFacePatchError store<std::string> ;

/// Accepted internal face patches in fine_faces_cell order.
$rule pointwise(fine_face_patches_cell,parametricCellPatchError<-parametricTopology,balancedParametricCell),
conditional(parametricAccepted),constraint(faceHistoryEnabled,geom_cells) {
  $fine_face_patches_cell.clear() ;
  $parametricCellPatchError.clear() ;
  try {
    $fine_face_patches_cell=$balancedParametricCell.cellPatches($parametricTopology) ;
  } catch(const std::exception& error) { $parametricCellPatchError=error.what() ; }
}

/// Accepted shared face patches in fine_faces order.
$rule pointwise(fine_face_patches,parametricFacePatchError<-fileNumber(face2node),(cl,cr)->(parametricTopology,balancedParametricCell)),
conditional(parametricAccepted),constraint(faceHistoryEnabled,interior_faces) {
  $fine_face_patches.clear() ;
  $parametricFacePatchError.clear() ;
  try {
    $fine_face_patches=$cl->$balancedParametricCell.facePatches($fileNumber(face2node),$cl->$parametricTopology,
        &$cr->$balancedParametricCell,&$cr->$parametricTopology) ;
  } catch(const std::exception& error) { $parametricFacePatchError=error.what() ; }
}

/// Accepted boundary patches in fine_faces order.
$rule pointwise(fine_face_patches,parametricFacePatchError<-fileNumber(face2node),cl->(parametricTopology,balancedParametricCell)),
conditional(parametricAccepted),constraint(faceHistoryEnabled,boundary_faces) {
  $fine_face_patches.clear() ;
  $parametricFacePatchError.clear() ;
  try {
    $fine_face_patches=$cl->$balancedParametricCell.facePatches($fileNumber(face2node),$cl->$parametricTopology) ;
  } catch(const std::exception& error) { $parametricFacePatchError=error.what() ; }
}
