#include <iostream>
#include <vector>
#include <Loci.h>
#include <Tools/tools.h>
#include "hexcell.h"

#include "face_output.h"

$include "FVM.lh"
$include "fvmadapt_internal.lh"

//  by: Qiuhan Xue
//
// This file generates fine_faces according refinement plans. The
// original grid is hexcell element. Anisotropic refinement is used. the rules should be
// used After node_offset and cell_offset has been set up.
// FineFaces is defined as c1, c2,followed by face2node.

/// Get fine_faces of hex cells
// Without face history.
$rule pointwise(fine_faces_cell <-
balancedCellPlan, balanced_node_offset,
balanced_cell_offset, (hex2face, hex2node, hexOrientCode),
(lower, upper, boundary_map)->(balancedFacePlan,fileNumber(face2node), balanced_node_offset),
(lower, upper, boundary_map)->face2edge->(balancedEdgePlan,balanced_node_offset),
(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
(lower, upper, boundary_map)->face2edge->edge2node->(pos, fileNumber(pos))),
constraint(hexcells, faceHistoryDisabled) {
  Loci::FaceOutput output($fine_faces_cell) ;
  if($balancedCellPlan.size() == 0) {
    return ;
  }

  std::list<Node*> bnode_list ; // boundary node
  std::list<Edge*> edge_list ;
  std::list<QuadFace*> face_list ;
  std::list<Node*> node_list ; // inner node

  // build a Cell
  HexCell* aCell = build_hex_cell($lower.begin(), $lower.size(),
    $upper.begin(), $upper.size(), $boundary_map.begin(), $boundary_map.size(),
    $hex2face, $hex2node, $hexOrientCode, $*face2node, $*face2edge,
    $*edge2node, $*pos, $*balancedEdgePlan, $*balancedFacePlan,
    $*balanced_node_offset, $*fileNumber(face2node), $*fileNumber(pos),
    bnode_list, edge_list, face_list) ;

  Loci::make_hex_cell_faces(aCell, $balancedCellPlan, $balanced_node_offset,
    $balanced_cell_offset, node_list, edge_list, face_list, output) ;

  // clean up
  if(aCell != 0) {
    delete aCell ;
    aCell = 0 ;
  }

  // Delete the separately owned nodes, edges, and faces.
  cleanup_list(bnode_list, edge_list, face_list) ;
  cleanup_list(node_list) ;
}

// With face history.
$rule pointwise(fine_faces_cell, fine_face_patches_cell <-
recordFaceHistory, fileNumber(geom_cells), planCellFileOffset,
balancedCellPlan, balanced_node_offset,
balanced_cell_offset, (hex2face, hex2node, hexOrientCode),
(lower, upper, boundary_map)->(balancedFacePlan,fileNumber(face2node), balanced_node_offset),
(lower, upper, boundary_map)->face2edge->(balancedEdgePlan,balanced_node_offset),
(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
(lower, upper, boundary_map)->face2edge->edge2node->(pos, fileNumber(pos))),
constraint(hexcells, faceHistoryEnabled) {
  Loci::FaceOutput output($fine_faces_cell, $fine_face_patches_cell,
    $fileNumber(geom_cells)+$planCellFileOffset) ;
  if($balancedCellPlan.size() == 0) {
    return ;
  }

  std::list<Node*> bnode_list ; // boundary node
  std::list<Edge*> edge_list ;
  std::list<QuadFace*> face_list ;
  std::list<Node*> node_list ; // inner node

  // build a Cell
  HexCell* aCell = build_hex_cell($lower.begin(), $lower.size(),
    $upper.begin(), $upper.size(), $boundary_map.begin(), $boundary_map.size(),
    $hex2face, $hex2node, $hexOrientCode, $*face2node, $*face2edge,
    $*edge2node, $*pos, $*balancedEdgePlan, $*balancedFacePlan,
    $*balanced_node_offset, $*fileNumber(face2node), $*fileNumber(pos),
    bnode_list, edge_list, face_list) ;

  Loci::make_hex_cell_faces(aCell, $balancedCellPlan, $balanced_node_offset,
    $balanced_cell_offset, node_list, edge_list, face_list, output) ;

  // clean up
  if(aCell != 0) {
    delete aCell ;
    aCell = 0 ;
  }

  // Delete the separately owned nodes, edges, and faces.
  cleanup_list(bnode_list, edge_list, face_list) ;
  cleanup_list(node_list) ;
}

/// Get fine_faces of interior faces
// Without face history.
$rule pointwise(fine_faces <-
balancedFacePlan, balanced_node_offset,
face2edge->(balancedEdgePlan, balanced_node_offset),
(cl, cr)->(balancedCellPlan, balanced_cell_offset, hex2node, hex2face, hexOrientCode),
(fl, fr),
(cl, cr)->(upper, lower, boundary_map)->face2node->pos,
(cl, cr)->(upper, lower, boundary_map)-> face2edge->edge2node->pos,
face2node->(pos, fileNumber(pos))),
constraint((cl, cr)->hexcells, faceHistoryDisabled) {
  Loci::FaceOutput output($fine_faces) ;
  std::list<Node*> bnode_list, node_list ;
  std::list<Edge*> edge_list ;
  QuadFace* aFace = build_quad_face($face2node.begin(), $face2edge.begin(),
    $*edge2node, $*pos, $*balancedEdgePlan, $*balanced_node_offset,
    $*fileNumber(pos), bnode_list, edge_list) ;
  auto leaves = output.split(aFace, $balancedFacePlan, $balanced_node_offset,
    node_list, edge_list) ;

  std::vector<int32> CL = get_c1_hex($cl->$balancedCellPlan, $balancedFacePlan,
    $cl->$hexOrientCode[$fl], $fl) ;
  std::vector<int32> CR = get_c1_hex($cr->$balancedCellPlan, $balancedFacePlan,
    $cr->$hexOrientCode[$fr], $fr) ;
  output.append(leaves, CL, $cl->$balancedCellPlan, $cl->$balanced_cell_offset,
    CR, $cr->$balancedCellPlan, $cr->$balanced_cell_offset) ;

  // Clean up the face tree and its nodes and edges.
  delete aFace ;
  cleanup_list(node_list) ;
  cleanup_list(bnode_list, edge_list) ;
}

// With face history.
$rule pointwise(fine_faces, fine_face_patches <-
recordFaceHistory, planFaceFileNumber,
balancedFacePlan, balanced_node_offset,
face2edge->(balancedEdgePlan, balanced_node_offset),
(cl, cr)->(balancedCellPlan, balanced_cell_offset, hex2node, hex2face, hexOrientCode),
(fl, fr),
(cl, cr)->(upper, lower, boundary_map)->face2node->pos,
(cl, cr)->(upper, lower, boundary_map)-> face2edge->edge2node->pos,
face2node->(pos, fileNumber(pos))),
constraint((cl, cr)->hexcells, faceHistoryEnabled) {
  Loci::FaceOutput output($fine_faces, $fine_face_patches, $planFaceFileNumber) ;
  std::list<Node*> bnode_list, node_list ;
  std::list<Edge*> edge_list ;
  QuadFace* aFace = build_quad_face($face2node.begin(), $face2edge.begin(),
    $*edge2node, $*pos, $*balancedEdgePlan, $*balanced_node_offset,
    $*fileNumber(pos), bnode_list, edge_list) ;
  auto leaves = output.split(aFace, $balancedFacePlan, $balanced_node_offset,
    node_list, edge_list) ;

  std::vector<int32> CL = get_c1_hex($cl->$balancedCellPlan, $balancedFacePlan,
    $cl->$hexOrientCode[$fl], $fl) ;
  std::vector<int32> CR = get_c1_hex($cr->$balancedCellPlan, $balancedFacePlan,
    $cr->$hexOrientCode[$fr], $fr) ;
  output.append(leaves, CL, $cl->$balancedCellPlan, $cl->$balanced_cell_offset,
    CR, $cr->$balancedCellPlan, $cr->$balanced_cell_offset) ;

  // Clean up the face tree and its nodes and edges.
  delete aFace ;
  cleanup_list(node_list) ;
  cleanup_list(bnode_list, edge_list) ;
}

// Get fine_faces of boundary faces
// Without face history.
$rule pointwise(fine_faces <-
balancedFacePlan, balanced_node_offset,
face2edge->(balancedEdgePlan, balanced_node_offset),
cl->(balancedCellPlan, balanced_cell_offset, hex2face, hex2node, hexOrientCode),
fl, cl->(upper, lower, boundary_map)->face2node->pos,
cl->(upper, lower, boundary_map)-> face2edge->edge2node->pos,
face2node->(pos, fileNumber(pos)), ref->boundary_tags),
constraint(cl->hexcells, boundary_faces, faceHistoryDisabled) {
  Loci::FaceOutput output($fine_faces) ;
  std::list<Node*> bnode_list, node_list ;
  std::list<Edge*> edge_list ;
  QuadFace* aFace = build_quad_face($face2node.begin(), $face2edge.begin(),
    $*edge2node, $*pos, $*balancedEdgePlan, $*balanced_node_offset,
    $*fileNumber(pos), bnode_list, edge_list) ;
  auto leaves = output.split(aFace, $balancedFacePlan, $balanced_node_offset,
    node_list, edge_list) ;

  std::vector<int32> CL = get_c1_hex($cl->$balancedCellPlan, $balancedFacePlan,
    $cl->$hexOrientCode[$fl], $fl) ;
  int boundary = -atoi(&($ref->$boundary_tags[3])) ;
  output.append(leaves, CL, $cl->$balancedCellPlan, $cl->$balanced_cell_offset, boundary) ;

  // Clean up the face tree and its nodes and edges.
  delete aFace ;
  cleanup_list(node_list) ;
  cleanup_list(bnode_list, edge_list) ;
}

// With face history.
$rule pointwise(fine_faces, fine_face_patches <-
recordFaceHistory, planFaceFileNumber,
balancedFacePlan, balanced_node_offset,
face2edge->(balancedEdgePlan, balanced_node_offset),
cl->(balancedCellPlan, balanced_cell_offset, hex2face, hex2node, hexOrientCode),
fl, cl->(upper, lower, boundary_map)->face2node->pos,
cl->(upper, lower, boundary_map)-> face2edge->edge2node->pos,
face2node->(pos, fileNumber(pos)), ref->boundary_tags),
constraint(cl->hexcells, boundary_faces, faceHistoryEnabled) {
  Loci::FaceOutput output($fine_faces, $fine_face_patches, $planFaceFileNumber) ;
  std::list<Node*> bnode_list, node_list ;
  std::list<Edge*> edge_list ;
  QuadFace* aFace = build_quad_face($face2node.begin(), $face2edge.begin(),
    $*edge2node, $*pos, $*balancedEdgePlan, $*balanced_node_offset,
    $*fileNumber(pos), bnode_list, edge_list) ;
  auto leaves = output.split(aFace, $balancedFacePlan, $balanced_node_offset,
    node_list, edge_list) ;

  std::vector<int32> CL = get_c1_hex($cl->$balancedCellPlan, $balancedFacePlan,
    $cl->$hexOrientCode[$fl], $fl) ;
  int boundary = -atoi(&($ref->$boundary_tags[3])) ;
  output.append(leaves, CL, $cl->$balancedCellPlan, $cl->$balanced_cell_offset, boundary) ;

  // Clean up the face tree and its nodes and edges.
  delete aFace ;
  cleanup_list(node_list) ;
  cleanup_list(bnode_list, edge_list) ;
}
