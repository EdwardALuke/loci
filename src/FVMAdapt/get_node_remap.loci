#include <Loci.h>
#include <map>
#include "defines.h"
#include <list>
#include <string>
#include <vector>
#include <algorithm>

$include "FVM.lh"

using std::cerr ;
using std::cout ;
using std::endl ;
using std::list ;
using std::ofstream ;
using std::pair ;
using std::sort ;
using std::string;
using std::unique ;
using std::vector ;

using Loci::MPI_processes;


$type X store<Loci::real_t> ;
$rule pointwise(fileNumber(X)), constraint(X), option(disable_threading),
prelude {
   if(Loci::MPI_processes == 1) {
     for(sequence::const_iterator si=seq.begin();si!= seq.end();++si) {
       $fileNumber(X)[*si] = *si ;
       //if(*si < 0) cout << "negative file Number " << *si << endl;
     }
     return ;
   }
   fact_db::distribute_infoP df = Loci::exec_current_fact_db->get_distribute_info() ;
    Map l2g ;
    l2g = df->l2g.Rep() ;
    store<unsigned char> key_domain ;
    key_domain = df->key_domain.Rep() ;
    //dMap g2f ;
    //g2f = df->g2f.Rep() ;

    for(sequence::const_iterator si=seq.begin();si!= seq.end();++si){
      int kd = key_domain[*si] ;
      $fileNumber(X)[*si] = df->g2fv[kd][l2g[*si]] ;
      //if(fileNumX[*si] < 0) cout << "negative file Number " << fileNumX[*si] << endl;
    }
} ;



