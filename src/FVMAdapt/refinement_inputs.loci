#include <memory>
#include <string>
#include <vector>

#include <Loci.h>
#include "read_par.h"

#ifdef USE_LIBXML2
#include <libxml/parser.h>
#include <libxml/tree.h>
#else
typedef struct _xmlDoc xmlDoc;
#endif

$include "fvmadapt_internal.lh"

using std::cerr ;
using std::endl ;

$type xmlfile_par param<std::string> ;
$type parfile_par param<std::string> ;

/// Read the XML region once for the cell-plan rules on this process.
$rule blackbox(cellPlanXMLDoc <- xmlfile_par), prelude {
#ifdef USE_LIBXML2
  xmlDoc* doc = xmlReadFile((*$xmlfile_par).c_str(), NULL, 0);
  if(doc == NULL) {
    cerr << "WARNING: fail to parse xml file" << endl ;
    Loci::Abort() ;
  }
  *$cellPlanXMLDoc = std::shared_ptr<xmlDoc>(doc, [](xmlDoc* owned_doc) {
    xmlFreeDoc(owned_doc) ;
  });
  if(xmlDocGetRootElement(doc) == NULL) {
    cerr << "WARNING: fail to parse xml file" << endl ;
    Loci::Abort() ;
  }
#else
  cerr << "XML capabilities not compiled into adaption code!"
       << " Check libxml availability when compiling" << endl ;
#endif
} ;

/// Read the parameter sources once for the cell-plan rules on this process.
$rule blackbox(cellPlanSources <- parfile_par), prelude {
  readPar(*$parfile_par, *$cellPlanSources) ;
  if($cellPlanSources->empty()) {
    cerr << "WARNING: fail to read par file" << endl ;
    Loci::Abort() ;
  }
} ;
