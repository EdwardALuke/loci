#include <iostream>
#include <queue>
#include <vector>
#include <map>
#include <set>

#include <Loci.h>
#include <Tools/tools.h>
#include "hexcell.h"
$include "FVM.lh"
$include "fvmadapt_internal.lh"

using std::queue ;
using std::cerr ;
using std::cout ;
using std::endl ;
using std::set ;
using std::map ;
using Loci::storeRepP ;

$rule pointwise(num_inner_nodes <- cellPlan,
hex2face, hex2node, hexOrientCode,
(lower, upper, boundary_map)->facePlan,
(lower, upper, boundary_map)->face2edge->edgePlan,
(lower, upper, boundary_map)->face2node->pos,
(lower, upper, boundary_map)->face2edge->edge2node,
(lower, upper, boundary_map)->(fileNumber(face2node), face2edge)),
constraint(hexcells) {
  if($cellPlan.size() == 0) {
    $num_inner_nodes = 0 ;
    return ;
  }

  std::list<Node*> bnode_list ; //boundary node
  std::list<Node*> node_list ; //inner node
  std::list<Edge*> edge_list ;
  std::list<QuadFace*> face_list ;

  HexCell* aCell = build_hex_cell($lower.begin(), $lower.size(),
                                  $upper.begin(), $upper.size(),
                                  $boundary_map.begin(), $boundary_map.size(),
                                  $hex2face,
                                  $hex2node,
                                  $hexOrientCode,
                                  $*face2node,
                                  $*face2edge,
                                  $*edge2node,
                                  $*pos,
                                  $*edgePlan,
                                  $*facePlan,
                                  bnode_list,
                                  edge_list,
                                  face_list,
                                  $*fileNumber(face2node)) ;

  std::vector<HexCell*> cells ;
  aCell->resplit($cellPlan,
                 node_list,
                 edge_list,
                 face_list,
                 cells) ;

  $num_inner_nodes = node_list.size() ;

  //clean up
  if(aCell != 0) {
    delete aCell ;
    aCell = 0 ;
  }

  // aCell will clean up these
  cleanup_list(bnode_list, edge_list, face_list) ;
  cleanup_list(node_list) ;
}


$rule pointwise(num_fine_cells <- cellPlan), constraint(hexcells) {
  HexCell* aCell = new HexCell ;
  $num_fine_cells = aCell->num_fine_cells($cellPlan) ;
  delete aCell ;
}


$rule pointwise(priority::quadface::num_inner_nodes <- facePlan,
face2edge->(edgePlan, edge2node), face2node->pos),
constraint(quadfaces) {
  if($facePlan.size() == 0) {
    $num_inner_nodes = 0 ;
    return ;
  }

  std::list<Node*> bnode_list ;
  std::list<Node*> node_list ;
  std::list<Edge*> edge_list ;

  QuadFace* aFace = build_quad_face($face2node.begin(),
                                    $face2edge.begin(),
                                    $*edge2node,
                                    $*pos,
                                    $*edgePlan,
                                    bnode_list,
                                    edge_list) ;

  aFace->resplit($facePlan, char(0), node_list, edge_list) ;
  $num_inner_nodes = node_list.size() ;

  // clean up
  if(aFace != 0) {
    delete aFace ;
    aFace = 0 ;
  }

  cleanup_list(bnode_list, edge_list) ;
  cleanup_list(node_list) ;
}


$rule pointwise(priority::c2p::balanced_num_fine_cells,
parent_num_fine_cells, indexMap <- balancedCellPlan, parentPlan),
constraint(hexcells) {
  // both former cycle and current cycle didn't split this cell
  if($balancedCellPlan.size() == 0 && $parentPlan.size() == 0) {
    $balanced_num_fine_cells = 1 ;
    $parent_num_fine_cells = 1 ;
    $indexMap.push_back(make_pair(1, 1)) ;
    reduce_vector($indexMap) ;
    return ;
  }

  HexCell* aCell = new HexCell ;
  $parent_num_fine_cells = aCell->empty_resplit($parentPlan) ;
  $balanced_num_fine_cells = aCell->empty_resplit($balancedCellPlan) ;
  aCell->traverse($parentPlan, $indexMap) ;
  reduce_vector($indexMap) ;

  // clean up
  if(aCell != 0) {
    delete aCell ;
    aCell = 0 ;
  }
}
