//-----------------------------------------------------------------------------
// No-derefinement plan
//-----------------------------------------------------------------------------

/// Dummy parameter to trick Loci scheduler
$rule pointwise(balancedCellPlan <- balancedCellPlan1, beginWithMarker),
option(disable_threading) {
  $balancedCellPlan = $balancedCellPlan1 ;
}


//-----------------------------------------------------------------------------
// Rules for derefining general cells
//-----------------------------------------------------------------------------

/// Dummy parameter to trick Loci scheduler
$rule pointwise(priority::restart::balancedCellPlan <- beginWithMarker,
  restart_tag_par, (cellPlan,balancedCellPlan1,nodeTag), isIndivisible,
  (lower, upper, boundary_map) -> (facePlan,balancedFacePlan1,is_quadface, nodeTag),
  (lower, upper, boundary_map)->face2node->(pos, posTag, fileNumber(pos)),
  (lower, upper, boundary_map)->face2edge->edge2node->pos,
  (lower, upper, boundary_map)->face2edge->(edgePlan,balancedEdgePlan1,nodeTag)),
constraint(gnrlcells) {
  if(!$isIndivisible) {
    std::list<Node*> node_list ;
    std::list<Edge*> edge_list ;
    std::list<Face*> face_list ;
    std::list<Node*> bnode_list ;

    Cell* aCell = build_resplit_general_cell($lower.begin(), $*lower.num_elems(_e_),
      $upper.begin(), $*upper.num_elems(_e_), $boundary_map.begin(),
      $*boundary_map.num_elems(_e_), $*is_quadface, $*face2node, $*face2edge,
      $*edge2node, $*pos, $*edgePlan, $*facePlan, $*balancedEdgePlan1,
      $*balancedFacePlan1, $*posTag, $*nodeTag, bnode_list, node_list,
      edge_list, face_list, $*fileNumber(pos), $cellPlan, $nodeTag) ;

    std::vector<DiamondCell*> cells ; // leaves collected according to cellPlan1
    aCell->resplit($balancedCellPlan1, node_list, edge_list, face_list, cells) ;

    // recollect leaves according to tree structure
    std::list<DiamondCell*> leaves ;
    aCell->sort_leaves(leaves) ;

    // first if any cell need derefine
    std::set<DiamondCell*> dparents ;
    bool check_root = false ;
    // mark the cell that will be eliminated
    for(std::list<DiamondCell*>::const_iterator li=leaves.begin(); li!=leaves.end(); li++) {
      if((*li)->get_tagged() == 2) {
        DiamondCell* parent = (*li)->getParentCell() ;
        if(parent == 0) {
          check_root = true ;
        }
        if(parent != 0 && parent->needDerefine()) {
          dparents.insert(parent) ;
        }
      }
    }
    // derefine the cells
    for(std::set<DiamondCell*>::const_iterator si=dparents.begin(); si!=dparents.end(); si++) {
      (*si)->derefine() ;
    }
    if(check_root) {
      if(aCell->needDerefine()) {
        aCell->derefine() ;
      }
    }

    $balancedCellPlan = aCell->make_cellplan() ;

    // clean up
    if(aCell != 0) {
      delete aCell ;
      aCell = 0 ;
    }
    cleanup_list(node_list, edge_list, face_list) ;
    cleanup_list(bnode_list) ;
    reduce_vector($balancedCellPlan) ;
  }
}

// dummy parameter to trick Loci scheduler
$rule pointwise(priority::restart::balancedCellPlan <- beginWithMarker,
  restart_tag_par, (cellPlan,balancedCellPlan1,fineCellTag), isIndivisible,
  (lower, upper, boundary_map) -> (facePlan,balancedFacePlan1,is_quadface),
  (lower, upper, boundary_map)->face2node->(pos,fileNumber(pos)),
  (lower, upper, boundary_map)->face2edge->edge2node->pos,
  (lower, upper, boundary_map)->face2edge->(edgePlan,balancedEdgePlan1)),
constraint(gnrlcells) {
  if(!$isIndivisible) {
    std::list<Node*> node_list ;
    std::list<Edge*> edge_list ;
    std::list<Face*> face_list ;
    std::list<Node*> bnode_list ;

    Cell* aCell = build_resplit_general_cell_ctag($lower.begin(), $*lower.num_elems(_e_),
      $upper.begin(), $*upper.num_elems(_e_), $boundary_map.begin(),
      $*boundary_map.num_elems(_e_), $*is_quadface, $*face2node, $*face2edge,
      $*edge2node, $*pos, $*edgePlan, $*facePlan, $*balancedEdgePlan1,
      $*balancedFacePlan1, bnode_list, node_list, edge_list, face_list,
      $*fileNumber(pos), $cellPlan, $fineCellTag) ;

    std::vector<DiamondCell*> cells ; // leaves collected according to cellPlan1
    aCell->resplit($balancedCellPlan1, node_list, edge_list, face_list, cells) ;

    // recollect leaves according to tree structure
    std::list<DiamondCell*> leaves ;
    aCell->sort_leaves(leaves) ;

    // first if any cell need derefine
    std::set<DiamondCell*> dparents ;
    bool check_root = false ;
    // mark the cell that will be eliminated
    for(std::list<DiamondCell*>::const_iterator li=leaves.begin(); li!=leaves.end(); li++) {
      if((*li)->getTag() == 2) {
        DiamondCell* parent = (*li)->getParentCell() ;
        if(parent == 0) {
          check_root = true ;
        }
        if(parent != 0 && parent->needDerefine_ctag()) {
          dparents.insert(parent) ;
        }
      }
    }

    // derefine the cells
    for(std::set<DiamondCell*>::const_iterator si=dparents.begin(); si!=dparents.end(); si++) {
      (*si)->derefine() ;
    }
    if(check_root) {
      if(aCell->needDerefine_ctag()) {
        aCell->derefine() ;
      }
    }

    $balancedCellPlan = aCell->make_cellplan() ;

    // clean up
    if(aCell != 0) {
      delete aCell ;
      aCell = 0 ;
    }
    cleanup_list(node_list, edge_list, face_list) ;
    cleanup_list(bnode_list) ;
    reduce_vector($balancedCellPlan) ;
  }
}


//-----------------------------------------------------------------------------
// Rules for derefining hex cells
//-----------------------------------------------------------------------------

/// This rule makes a newCellPlan according to cellPlan
/// and nodeTag, posTag.
/// Dummy parameter to trick Loci scheduler
$rule pointwise(priority::restart::balancedCellPlan <- beginWithMarker,
  restart_tag_par, split_mode_par,
  (cellPlan,balancedCellPlan1,nodeTag,hex2face, hex2node, hexOrientCode),
  isIndivisible,
  (lower, upper, boundary_map) -> (facePlan,balancedFacePlan1,nodeTag),
  (lower, upper, boundary_map)->face2node->(pos, posTag),
  (lower, upper, boundary_map)->face2edge->edge2node->pos,
  (lower, upper, boundary_map)->face2edge->(edgePlan,balancedEdgePlan1,nodeTag),
  (lower, upper, boundary_map)->fileNumber(face2node)),
constraint(hexcells) {
  if(!$isIndivisible) {
    std::list<Node*> node_list ;
    std::list<Edge*> edge_list ;
    std::list<QuadFace*> face_list ;
    std::list<Node*> bnode_list ;

    HexCell* aCell = build_resplit_hex_cell($lower.begin(), $*lower.num_elems(_e_),
      $upper.begin(), $*upper.num_elems(_e_), $boundary_map.begin(),
      $*boundary_map.num_elems(_e_), $hex2face, $hex2node, $hexOrientCode,
      $*face2node, $*face2edge, $*edge2node, $*pos, $*edgePlan, $*facePlan,
      $*balancedEdgePlan1, $*balancedFacePlan1, $*posTag, $*nodeTag,
      bnode_list, node_list, edge_list, face_list, $*fileNumber(face2node),
      $cellPlan, $nodeTag) ;

    std::vector<HexCell*> cells ; // leaves collected according to cellPlan1
    aCell->resplit($balancedCellPlan1, node_list, edge_list, face_list, cells) ;

    // recollect leaves according to tree structure
    std::list<HexCell*> leaves ;
    aCell->sort_leaves(leaves) ;

    // first if any cell need derefine
    std::set<HexCell*> dparents ;

    for(std::list<HexCell*>::const_iterator li=leaves.begin(); li!=leaves.end(); li++) {
      if((*li)->get_tagged() == 2) {
        HexCell* parent = (*li)->getParentCell() ;
        if(parent != 0 && parent->needDerefine()) {
          dparents.insert(parent) ;
        }
      }
    }
    // derefine the cells
    for(std::set<HexCell*>::const_iterator si=dparents.begin(); si!=dparents.end(); si++) {
      (*si)->derefine() ;
    }

    $balancedCellPlan = aCell->make_cellplan() ;

    // clean up
    if(aCell != 0) {
      delete aCell ;
      aCell = 0 ;
    }
    cleanup_list(node_list, edge_list, face_list) ;
    cleanup_list(bnode_list) ;
    reduce_vector($balancedCellPlan) ;
  }
}

