#include <limits>
#include <Loci.h>
#include "defines.h"
#include "face_history.h"

$include "FVM.lh"
$include "fvmadapt_internal.lh"

/// Face provenance is recorded only when requested by the caller.
$rule default(recordFaceHistory) { $recordFaceHistory=false ; }

$rule constraint(faceHistoryEnabled <- recordFaceHistory) {
  $faceHistoryEnabled=$recordFaceHistory ? ~EMPTY:EMPTY ;
}
