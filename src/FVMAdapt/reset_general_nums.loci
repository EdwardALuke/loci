////////////////////////////////////////////////////////////////////////////////////////
//                                   set_general_nums.cc                              //
//                                by: Qiuhan Xue                                      //
//                                                                                    //
// This file set up the numbers of inner nodes, the number of fine cells in each      //
// original cell                                                                      //
////////////////////////////////////////////////////////////////////////////////////////
#include <iostream>
#include <queue>
#include <vector>
#include <map>
#include <set>

#include <Loci.h>
#include <Tools/tools.h>
#include "diamondcell.h"
$include "FVM.lh"
$include "fvmadapt_internal.lh"

using std::queue ;
using std::cerr ;
using std::endl ;
using std::set ;
using std::map ;

$rule pointwise(balanced_num_inner_nodes <- balancedCellPlan,
(lower, upper, boundary_map)->(is_quadface, balancedFacePlan),
(lower, upper, boundary_map)->face2edge->balancedEdgePlan,
(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(gnrlcells) {

  if($balancedCellPlan.size() == 0) {
    $balanced_num_inner_nodes = 0 ;
    return ;
  }

  std::list<Node*> bnode_list ; //boundary node
  std::list<Node*> node_list ; //inner node
  std::list<Edge*> edge_list ;
  std::list<Face*> face_list ;

  Cell* aCell = build_general_cell($lower.begin(), $lower.size(),
                                   $upper.begin(), $upper.size(),
                                   $boundary_map.begin(), $boundary_map.size(),
                                   $*is_quadface,
                                   $*face2node,
                                   $*face2edge,
                                   $*edge2node,
                                   $*pos,
                                   $*balancedEdgePlan,
                                   $*balancedFacePlan,
                                   bnode_list,
                                   edge_list,
                                   face_list,
                                   $*fileNumber(pos)) ;

  std::vector<DiamondCell*> cells ;
  aCell->resplit($balancedCellPlan, node_list, edge_list, face_list, cells) ;

  $balanced_num_inner_nodes = node_list.size() ;

  //clean up
  if(aCell != 0) {
    delete aCell ;
    aCell = 0 ;
  }

  //aCell will clean up these
  cleanup_list(node_list, edge_list, face_list) ;
  cleanup_list(bnode_list) ;
}


$rule pointwise(balanced_num_fine_cells <- balancedCellPlan,
(lower, upper, boundary_map)->face2node->fileNumber(pos),
(lower, upper, boundary_map)->face2edge->edge2node->fileNumber(pos)),
constraint(gnrlcells) {
  if($balancedCellPlan.size() == 0) {
    $balanced_num_fine_cells = 1 ;
    return ;
  }

  std::list<Node*> node_list ;
  std::list<Edge*> edge_list ;
  std::list<Face*> face_list ;

  Cell* aCell = build_general_cell($lower.begin(), $lower.size(),
                                   $upper.begin(), $upper.size(),
                                   $boundary_map.begin(), $boundary_map.size(),
                                   $*face2node,
                                   $*face2edge,
                                   $*edge2node,
                                   node_list,
                                   edge_list,
                                   face_list,
                                   $*fileNumber(pos)) ;

  $balanced_num_fine_cells = aCell->empty_resplit($balancedCellPlan) ;

  //clean up
  if(aCell != 0) {
    delete aCell ;
    aCell = 0 ;
  }

  //aCell will clean up these
  cleanup_list(node_list, edge_list, face_list) ;
}


$rule pointwise(quadface::balanced_num_inner_nodes <- balancedFacePlan,
face2edge->balancedEdgePlan,
face2edge->edge2node->pos,
face2node->pos),
constraint(faces) {
  if($balancedFacePlan.size() == 0) {
    $balanced_num_inner_nodes = 0 ;
    return ;
  }

  std::list<Node*> bnode_list ;
  std::list<Node*> node_list ;
  std::list<Edge*> edge_list ;

  Face* aFace = build_general_face($face2node.begin(), $face2node.size(),
                                   $face2edge.begin(),
                                   $*edge2node,
                                   $*pos,
                                   $*balancedEdgePlan,
                                   bnode_list,
                                   edge_list) ;

  aFace->resplit($balancedFacePlan, node_list, edge_list) ;
  $balanced_num_inner_nodes = node_list.size() ;

  //clean up
  if(aFace != 0) {
    delete aFace ;
    aFace = 0 ;
  }

  cleanup_list(node_list, edge_list) ;
  cleanup_list(bnode_list) ;
}


$rule pointwise(balanced_num_inner_nodes <- balancedEdgePlan),
constraint(edge2node->pos) {
  int num = 0 ;
  if($balancedEdgePlan.size() != 0) {
    for(unsigned int i = 0; i < $balancedEdgePlan.size(); i++) {
      if($balancedEdgePlan[i] == 1) num++ ;
    }
  }
  $balanced_num_inner_nodes = num ;
}
