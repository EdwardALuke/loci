$include "FVMAdapt/parametric_adapt.lh"
#include <FVMAdapt/defines.h>
#include "parametric_cell_data.h"
#include <FVMAdapt/xml_region.h>
#include <FVMAdapt/spacing_source.h>

/// Compiled physical region, shared by all cell requests on a process.
$type parametricRegion blackbox<Loci::FVMAdapt::XMLRegionP> ;
/// Spacing sources shared by all cell requests on a process.
$type parametricSources blackbox<std::vector<Loci::FVMAdapt::SpacingSource> > ;
/// Geometric input failure, checked before applying cell requests.
$type parametricInputError blackbox<std::string> ;

/// Source-cell connectivity in original file numbering; encodeParametricTopology().
$type parametricTopology store<std::vector<int> > ;
/// Source mesh for cell correspondence; normally the accepted input history.
$type parametricDonorCell store<Loci::FVMAdapt::ParametricCellData> ;
/// Agreed original-edge intervals; parametricEdgeTrace().
$type balancedParametricEdgeTrace store<Loci::FineFaces> ;
/// Accepted input history, initialized from the source geometry when empty.
$type initialParametricHistory store<Loci::FVMAdapt::ParametricRecord> ;

/// Accepted input state shared by tag conversion, balancing and transfer.
$type initialParametricCell store<Loci::FVMAdapt::ParametricCellData> ;
/// Accepted output state; rules construct working geometry when needed.
$type balancedParametricCell store<Loci::FVMAdapt::ParametricCellData> ;
/// Finished balancing candidate, before optional physical quality acceptance.
$type candidateParametricCell store<Loci::FVMAdapt::ParametricCellData> ;
$type candidateParametricError store<std::string> ;
/// True when balancing completed without a local or remote failure.
$type parametricBalanced param<bool> ;
/// Original-edge divisions of the balanced candidate.
$type candidateParametricEdgeTrace store<Loci::FineFaces> ;
/// Quality calculations completed and met the selected acceptance policy.
$type parametricQualityAccepted param<bool> ;
