//-----------------------------------------------------------------------------
// Rules for balancing general cell plans
//-----------------------------------------------------------------------------

//----------------------------------------------------------------------------
//
// This file balance general cellPlan between cells
//
//-----------------------------------------------------------------------------

/// Initializes cellUnchanged. Initially newCellPlan is the plan
/// made from postag and nodeTag, and after each cell is balanced.
$rule pointwise(cellUnchanged{n=0}, tmpCellPlan{n=0} <- newCellPlan),
constraint(gnrlcells) {
  $cellUnchanged{n=0} = ($newCellPlan.size() == 0) ;
  $tmpCellPlan{n=0} = $newCellPlan ;
  reduce_vector($tmpCellPlan{n=0}) ;
}

/// Advance rule for balancing each general cell with its interior and
/// boundary faces.
$rule pointwise(cellUnchanged{n+1}, tmpCellPlan{n+1} <- cellUnchanged{n},
tmpCellPlan{n}, isIndivisible,
(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
(lower, upper, boundary_map)->face2edge->tmpEdgePlan{n},
(lower, upper, boundary_map)->face2edge->edge2node->pos,
(lower, upper, boundary_map)->(is_quadface, tmpFacePlan{n})),
constraint(gnrlcells) {

  // first assume the cell will not be updated
  $cellUnchanged{n+1} = true ;

  std::list<Node*> node_list ;
  std::list<Edge*> edge_list ;
  std::list<Face*> face_list ;
  std::list<Node*> bnode_list ;
  Cell* aCell = build_general_cell($lower.begin(), $lower.size(),
                                   $upper.begin(), $upper.size(),
                                   $boundary_map.begin(),
                                   $boundary_map.size(),
                                   $*is_quadface,
                                   $*face2node,
                                   $*face2edge,
                                   $*edge2node,
                                   $*pos,
                                   $*tmpEdgePlan{n},
                                   $*tmpFacePlan{n},
                                   bnode_list,
                                   edge_list,
                                   face_list,
                                   $*fileNumber(pos)) ;

  std::vector<DiamondCell*> cells ;
  aCell->resplit($tmpCellPlan{n},
                 node_list,
                 edge_list,
                 face_list,
                 cells) ;

  // balance cells
  if (!$isIndivisible) {
    aCell->rebalance_cells(node_list, edge_list, face_list) ;
  }

  // write new cellPlan
  std::vector<char> newCellPlan(aCell->make_cellplan()) ;
  $cellUnchanged{n+1} = (newCellPlan == $tmpCellPlan{n}) ;

  $tmpCellPlan{n+1} = newCellPlan ;
  reduce_vector($tmpCellPlan{n+1}) ;

  // clean up
  if (aCell != 0) {
    delete aCell ;
    aCell = 0 ;
  }
  cleanup_list(node_list, edge_list, face_list) ;
  cleanup_list(bnode_list) ;
}


//-----------------------------------------------------------------------------
// Rules for balancing hex cell plans
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
//
// This file balances hex cellPlan between cells
//
//-----------------------------------------------------------------------------

/// Initializes cellUnchanged. Initially newCellPlan is the plan made from
/// postag and nodeTag, and after each cell is balanced.
$rule pointwise(cellUnchanged{n=0}, tmpCellPlan{n=0} <- newCellPlan),
constraint(hexcells) {
  $cellUnchanged{n=0} = ($newCellPlan.size() == 0) ;
  $tmpCellPlan{n=0} = $newCellPlan ;
  reduce_vector($tmpCellPlan{n=0}) ;
}

/// Advance rule for balancing each hex cell with its interior and boundary
/// faces.
$rule pointwise(cellUnchanged{n+1}, tmpCellPlan{n+1} <- split_mode_par,
cellUnchanged{n}, tmpCellPlan{n}, hex2face, hex2node, hexOrientCode,
isIndivisible,
(lower, upper, boundary_map)->face2node->pos,
(lower, upper, boundary_map)->face2edge->tmpEdgePlan{n},
(lower, upper, boundary_map)->face2edge->edge2node->pos,
(lower, upper, boundary_map)->tmpFacePlan{n},
(lower, upper, boundary_map)->fileNumber(face2node)),
constraint(hexcells) {

  // first assume the cell will not be updated
  $cellUnchanged{n+1} = true ;

  std::list<Node*> node_list ;
  std::list<Edge*> edge_list ;
  std::list<QuadFace*> face_list ;
  std::list<Node*> bnode_list ;

  HexCell* aCell = build_hex_cell($lower.begin(), $lower.size(),
                                  $upper.begin(), $upper.size(),
                                  $boundary_map.begin(),
                                  $boundary_map.size(),
                                  $hex2face,
                                  $hex2node,
                                  $hexOrientCode,
                                  $*face2node,
                                  $*face2edge,
                                  $*edge2node,
                                  $*pos,
                                  $*tmpEdgePlan{n},
                                  $*tmpFacePlan{n},
                                  bnode_list,
                                  edge_list,
                                  face_list,
                                  $*fileNumber(face2node)) ;

  std::vector<HexCell*> cells ;
  aCell->resplit($tmpCellPlan{n},
                 node_list,
                 edge_list,
                 face_list,
                 cells) ;

  // balance cells
  if (!$isIndivisible) {
    aCell->rebalance_cells($split_mode_par, node_list, edge_list, face_list) ;
  }

  // write new cellPlan
  std::vector<char> newCellPlan(aCell->make_cellplan()) ;
  $cellUnchanged{n+1} = (newCellPlan == $tmpCellPlan{n}) ;

  $tmpCellPlan{n+1} = newCellPlan ;
  reduce_vector($tmpCellPlan{n+1}) ;

  // clean up
  if (aCell != 0) {
    delete aCell ;
    aCell = 0 ;
  }
  cleanup_list(node_list, edge_list, face_list) ;
  cleanup_list(bnode_list) ;
}


//-----------------------------------------------------------------------------
// Rules for balancing prism cell plans
//-----------------------------------------------------------------------------

//using std::cout ;

// This file balances prism cellPlan between cells  

/// This rule initializes cellUnchanged, initially newCellPlan is the plan made
/// from postag and nodeTag, and after each cell is balanced.
$rule pointwise(cellUnchanged{n=0}, tmpCellPlan{n=0} <- newCellPlan),
constraint(prisms) {
  $cellUnchanged{n=0} = ($newCellPlan.size() == 0) ;
  $tmpCellPlan{n=0} = $newCellPlan ;
  reduce_vector($tmpCellPlan{n=0}) ;
}

/// This rule balance each cell with all its interior faces(lower, upper)
/// const_blackbox<storeRepP>  node_remap;
/// Map node_l2f;
/// input("node_remap");
$rule pointwise(cellUnchanged{n+1}, tmpCellPlan{n+1} <- split_mode_par,
cellUnchanged{n}, tmpCellPlan{n}, prism2face, prism2node, prismOrientCode, isIndivisible,
(lower, upper, boundary_map)->face2node->pos,
(lower, upper, boundary_map)->face2edge->tmpEdgePlan{n},
(lower, upper, boundary_map)->face2edge->edge2node->pos,
(lower, upper, boundary_map)->(tmpFacePlan{n}, fileNumber(face2node))),
constraint(prisms) {
  // first assume the cell will not be updated
  $cellUnchanged{n+1} = true ;

  std::list<Node*> node_list ;
  std::list<Edge*> edge_list ;
  std::list<QuadFace*> qface_list ;
  std::list<Face*> gface_list ;
  std::list<Node*> bnode_list ;

  Prism* aCell = build_prism_cell($lower.begin(), $*lower.num_elems(_e_),
                                  $upper.begin(), $*upper.num_elems(_e_),
                                  $boundary_map.begin(),
                                  $*boundary_map.num_elems(_e_),
                                  $prism2face, $prism2node, $prismOrientCode,
                                  $*face2node, $*face2edge, $*edge2node, $*pos,
                                  $*tmpEdgePlan{n}, $*tmpFacePlan{n},
                                  bnode_list, edge_list, qface_list, gface_list,
                                  $*fileNumber(face2node)) ;

  std::vector<Prism*> cells ;
  aCell->resplit($tmpCellPlan{n}, node_list, edge_list, qface_list, gface_list,
                 cells) ;

  // balance cells
  if(!$isIndivisible) {
    aCell->rebalance_cells($split_mode_par, node_list, edge_list, qface_list,
                           gface_list) ;
  }

  // write new cellPlan
  std::vector<char> newCellPlan(aCell->make_cellplan()) ;
  $cellUnchanged{n+1} = (newCellPlan == $tmpCellPlan{n}) ;
  $tmpCellPlan{n+1} = newCellPlan ;
  reduce_vector($tmpCellPlan{n+1}) ;

  // clean up
  if(aCell != 0) {
    delete aCell ;
    aCell = 0 ;
  }
  cleanup_list(node_list, edge_list, qface_list) ;
  cleanup_list(gface_list) ;
  cleanup_list(bnode_list) ;
}


//-----------------------------------------------------------------------------
// General-cell face plans
//-----------------------------------------------------------------------------

$rule pointwise(tmpFacePlan <- (cl, cr)->tmpCellPlan,
(cl, cr)->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
(cl, cr)->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(interior_faces, (cl, cr)->gnrlcells) {
  $tmpFacePlan.clear() ;

  std::vector<char> facePlanL = extract_general_face($cl->$lower.begin(),
                                                     $*lower.num_elems($cl),
                                                     $cl->$upper.begin(),
                                                     $*upper.num_elems($cl),
                                                     $cl->$boundary_map.begin(),
                                                     $*boundary_map.num_elems($cl),
                                                     $*face2node, $*face2edge,
                                                     $*edge2node, $cl->$tmpCellPlan,
                                                     _e_, $*fileNumber(pos)) ;

  std::vector<char> facePlanR = extract_general_face($cr->$lower.begin(),
                                                     $*lower.num_elems($cr),
                                                     $cr->$upper.begin(),
                                                     $*upper.num_elems($cr),
                                                     $cr->$boundary_map.begin(),
                                                     $*boundary_map.num_elems($cr),
                                                     $*face2node, $*face2edge,
                                                     $*edge2node, $cr->$tmpCellPlan,
                                                     _e_, $*fileNumber(pos)) ;

  $tmpFacePlan = merge_faceplan(facePlanL, facePlanR, $*face2node.num_elems(_e_)) ;
  reduce_vector($tmpFacePlan) ;
}

$rule pointwise(tmpFacePlan <- cl->tmpCellPlan,
cl->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)), //dummy
cl->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(boundary_faces, cl->gnrlcells) {
  $tmpFacePlan = extract_general_face($cl->$lower.begin(),
                                      $*lower.num_elems($cl),
                                      $cl->$upper.begin(),
                                      $*upper.num_elems($cl),
                                      $cl->$boundary_map.begin(),
                                      $*boundary_map.num_elems($cl),
                                      $*face2node, $*face2edge,
                                      $*edge2node, $cl->$tmpCellPlan,
                                      _e_, $*fileNumber(pos)) ;
  reduce_vector($tmpFacePlan) ;
}


//-----------------------------------------------------------------------------
// Hex-cell face plans
//-----------------------------------------------------------------------------

void extract_quad_edge(const std::vector<char>&, std::vector<char>&, unsigned int) ;
std::vector<char> merge_quad_face(std::vector<char>& facePlanL, char orientCodeL) ;
std::vector<char> merge_quad_face(std::vector<char>& facePlanL, char orientCodeL,
                                  std::vector<char>& facePlanR, char orientCodeR) ;
std::vector<char> extract_hex_face(const std::vector<char>& cellPlan, DIRECTION dd) ;


// This rule first extracts faceplan from cl and cr, then merges them into one
// final plan in the face's local coordinates system.
//
// To merge the plans,  use a queue of ranges to simulate the tree splitting
// process, and put the inner eges in list xEdge and yEdges according to their
// directions.
//
// Then sort and unique xEdge and yEdge. and then merge all the overlapped
// edges.   
//
// The last step is compose a new refinement plan according to xEdges and
// yEdges. Search the inner edges of a parent cell, the result implies the
// split code. Repeat the same process for each child.

$rule pointwise(tmpFacePlan <- (cl, cr)->tmpCellPlan,
(cl, cr)->hexOrientCode, fl, fr), constraint(interior_faces, (cl, cr)->hexcells) {
  std::vector<char> facePlanL = extract_hex_face($cl->$tmpCellPlan, DIRECTION($fl)) ;
  std::vector<char> facePlanR = extract_hex_face($cr->$tmpCellPlan, DIRECTION($fr)) ;
  $tmpFacePlan = merge_quad_face(facePlanL, $cl->$hexOrientCode[$fl],
    facePlanR, $cr->$hexOrientCode[$fr]) ;
  reduce_vector($tmpFacePlan) ;
}

$rule pointwise(tmpFacePlan <- cl->tmpCellPlan, cl->hexOrientCode, fl),
constraint(boundary_faces, cl->hexcells) {
  std::vector<char> facePlanL = extract_hex_face($cl->$tmpCellPlan, DIRECTION($fl)) ;
  $tmpFacePlan = merge_quad_face(facePlanL, $cl->$hexOrientCode[$fl]) ;
  reduce_vector($tmpFacePlan) ;
}


//-----------------------------------------------------------------------------
// Prism-cell face plans
//-----------------------------------------------------------------------------

void extract_prism_face(const std::vector<char>& cellPlan,
  std::vector<char>& facePlan, int dd) ;

std::vector<char> merge_quad_face_p(const std::vector<char>& cellPlan1,
  int dd1, char orientCode1) ;

std::vector<char> merge_quad_face_pp(const std::vector<char>& cellPlan1,
  int dd1, char orientCode1, const std::vector<char>& cellPlan2, int dd2,
  char orientCode2) ;

std::vector<char> merge_tri_face_p(const std::vector<char>& cellPlan1, int dd1,
  char orientCode1) ;

std::vector<char> merge_tri_face_pp(const std::vector<char>& cellPlan1,
  int dd1, char orientCode1, const std::vector<char>& cellPlan2, int dd2,
  char orientCode2) ;


// This rule first extracts faceplan from cl and cr, then merges them into one
// final plan in the face's local coordinates system.
//
// To merge the plans,  use a queue of ranges to simulate the tree splitting
// process, and put the inner eges in list xEdge and yEdges according to their
// directions.
//
// Then sort and unique xEdge and yEdge. and then merge all the overlapped
// edges.   
//
// The last step is compose a new refinement plan according to xEdges and
// yEdges. Search the inner edges of a parent cell, the result implies the
// split code. Repeat the same process for each child.

$rule pointwise(tmpFacePlan <- (cl, cr)->tmpCellPlan,
(cl, cr)->prismOrientCode, fl, fr), constraint((cl, cr)->prisms) {
  if ($fl < 2) {
    $tmpFacePlan = merge_tri_face_pp($cl->$tmpCellPlan, $fl,
                                     $cl->$prismOrientCode[$fl],
                                     $cr->$tmpCellPlan, $fr,
                                     $cr->$prismOrientCode[$fr]) ;
  }else {
    $tmpFacePlan = merge_quad_face_pp($cl->$tmpCellPlan, $fl,
                                      $cl->$prismOrientCode[$fl],
                                      $cr->$tmpCellPlan, $fr,
                                      $cr->$prismOrientCode[$fr]) ;
  }
  reduce_vector($tmpFacePlan) ;
}

$rule pointwise(tmpFacePlan <- cl->tmpCellPlan, cl->prismOrientCode, fl),
constraint(boundary_faces, cl->prisms) {
  if ($fl < 2) {
    $tmpFacePlan = merge_tri_face_p($cl->$tmpCellPlan, $fl,
                                    $cl->$prismOrientCode[$fl]) ;
  }else {
    $tmpFacePlan = merge_quad_face_p($cl->$tmpCellPlan, $fl,
                                     $cl->$prismOrientCode[$fl]) ;
  }
  reduce_vector($tmpFacePlan) ;
}


//-----------------------------------------------------------------------------
// Mixed-cell face plans
//-----------------------------------------------------------------------------

std::vector<char> extract_general_face(const Entity* lower, int lower_size,
                                       const Entity* upper, int upper_size,
                                       const Entity* boundary_map, int boundary_map_size,
                                       const const_multiMap& face2node,
                                       const const_multiMap& face2edge,
                                       const const_MapVec<2>& edge2node,
                                       const std::vector<char>& cellPlan,
                                       Entity ff,
                                       const const_store<int>& node_remap
                                       ) ;

std::vector<char> extract_prism_face(const std::vector<char>& cellPlan, int dd) ;

std::vector<char> merge_tri_face_p(const std::vector<char>& cellPlan1,
                                   int dd1, char orientCode1);

std::vector<char> extract_hex_face(const std::vector<char>& cellPlan, DIRECTION dd) ;

std::vector<char> merge_quad_face(std::vector<char>& facePlanL, char orientCodeL) ;

std::vector<char> merge_quad_face(std::vector<char>& facePlanL, char orientCodeL,
                                  std::vector<char>& facePlanR, char orientCodeR) ;

std::vector<char> merge_tri_face_pp(const std::vector<char>& cellPlan1,
                                    int dd1, char orientCode1,
                                    const std::vector<char>& cellPlan2,
                                    int dd2, char orientCode2) ;

std::vector<char> merge_faceplan(std::vector<char>& planl, std::vector<char>& planr,
                                 int numNodes) ;

std::vector<char> transfer_plan_g2q(std::vector<char>& facePlan) ;


$rule pointwise(tmpFacePlan <- (cl, cr)->tmpCellPlan, cr->hexOrientCode, fr,
cl->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)), 
cl->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(cl->gnrlcells, cr->hexcells) {
  $tmpFacePlan.clear() ;
  std::vector<char> localPlanL = extract_general_face(
    $cl->$lower.begin(), $*lower.num_elems($cl),
    $cl->$upper.begin(), $*upper.num_elems($cl),
    $cl->$boundary_map.begin(), $*boundary_map.num_elems($cl),
    $*face2node, $*face2edge, $*edge2node, $cl->$tmpCellPlan,
    _e_, $*fileNumber(pos)) ;

  std::vector<char> facePlanL = transfer_plan_g2q(localPlanL) ;
  std::vector<char> facePlanR = extract_hex_face($cr->$tmpCellPlan, DIRECTION($fr)) ;

  $tmpFacePlan = merge_quad_face(facePlanL, static_cast<char>(0), facePlanR,
                                 $cr->$hexOrientCode[$fr]) ;
  reduce_vector($tmpFacePlan) ;
}

$rule pointwise(tmpFacePlan <- (cl, cr)->tmpCellPlan, cl->hexOrientCode, fl,
cr->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)), //dummy
cr->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(cr->gnrlcells, cl->hexcells) {
  $tmpFacePlan.clear() ;
  std::vector<char> localPlanR = extract_general_face(
    $cr->$lower.begin(), $*lower.num_elems($cr),
    $cr->$upper.begin(), $*upper.num_elems($cr),
    $cr->$boundary_map.begin(), $*boundary_map.num_elems($cr),
    $*face2node, $*face2edge, $*edge2node, $cr->$tmpCellPlan,
    _e_, $*fileNumber(pos)) ;
  std::vector<char> facePlanR = transfer_plan_g2q(localPlanR) ;
  std::vector<char> facePlanL = extract_hex_face($cl->$tmpCellPlan, DIRECTION($fl)) ;

  $tmpFacePlan = merge_quad_face(facePlanR, static_cast<char>(0), facePlanL,
                                 $cl->$hexOrientCode[$fl]);
  reduce_vector($tmpFacePlan) ;
}

$rule pointwise(tmpFacePlan <- (cl, cr)->tmpCellPlan, cr->prismOrientCode, fr,
cl->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)), 
cl->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(cl->gnrlcells, cr->prisms) {
  $tmpFacePlan.clear() ;
  std::vector<char> localPlanL = extract_general_face(
    $cl->$lower.begin(), $*lower.num_elems($cl),
    $cl->$upper.begin(), $*upper.num_elems($cl),
    $cl->$boundary_map.begin(), $*boundary_map.num_elems($cl),
    $*face2node, $*face2edge, $*edge2node, $cl->$tmpCellPlan,
    _e_, $*fileNumber(pos)) ;

  if($fr< 2) {
    std::vector<char> facePlanR = merge_tri_face_p($cr->$tmpCellPlan, $fr, $cr->$prismOrientCode[$fr]) ;
    $tmpFacePlan = merge_faceplan(localPlanL, facePlanR, $*face2node.num_elems(_e_)) ;
  }else {
    std::vector<char> facePlanR = extract_prism_face($cr->$tmpCellPlan, $fr) ;
    std::vector<char> facePlanL = transfer_plan_g2q(localPlanL) ;
    $tmpFacePlan = merge_quad_face(facePlanL, static_cast<char>(0), facePlanR,
                                   $cr->$prismOrientCode[$fr]);
  }
  reduce_vector($tmpFacePlan) ;
}

$rule pointwise(tmpFacePlan <- (cl, cr)->tmpCellPlan, cl->prismOrientCode, fl,
cr->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)), 
cr->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(cr->gnrlcells, cl->prisms) {
  $tmpFacePlan.clear() ;
  std::vector<char> localPlanR = extract_general_face(
    $cr->$lower.begin(), $*lower.num_elems($cr),
    $cr->$upper.begin(), $*upper.num_elems($cr),
    $cr->$boundary_map.begin(), $*boundary_map.num_elems($cr),
    $*face2node, $*face2edge, $*edge2node, $cr->$tmpCellPlan,
    _e_, $*fileNumber(pos)) ;

  if($fl< 2) {
    std::vector<char> facePlanL = merge_tri_face_p($cl->$tmpCellPlan, $fl, $cl->$prismOrientCode[$fl]) ;
    $tmpFacePlan = merge_faceplan(facePlanL, localPlanR, $*face2node.num_elems(_e_)) ;
  }else {
    std::vector<char> facePlanL = extract_prism_face($cl->$tmpCellPlan, $fl) ;
    std::vector<char> facePlanR = transfer_plan_g2q(localPlanR) ;

    $tmpFacePlan = merge_quad_face(facePlanR,static_cast<char>(0), facePlanL,
                                   $cl->$prismOrientCode[$fl]);
  }
  reduce_vector($tmpFacePlan) ;
}

$rule pointwise(tmpFacePlan <- (cl, cr)->tmpCellPlan, cr->prismOrientCode,
cl->hexOrientCode, fl, fr), constraint(cl->hexcells, cr->prisms) {
  std::vector<char> facePlanL = extract_hex_face($cl->$tmpCellPlan, DIRECTION($fl)) ;
  std::vector<char> facePlanR = extract_prism_face($cr->$tmpCellPlan, $fr) ;
  $tmpFacePlan = merge_quad_face(facePlanL, $cl->$hexOrientCode[$fl],
    facePlanR, $cr->$prismOrientCode[$fr]) ;
  reduce_vector($tmpFacePlan) ;
}

$rule pointwise(tmpFacePlan <- (cl, cr)->tmpCellPlan, cl->prismOrientCode,
cr->hexOrientCode, fl, fr), constraint(cr->hexcells, cl->prisms) {
  std::vector<char> facePlanR = extract_hex_face($cr->$tmpCellPlan, DIRECTION($fr)) ;
  std::vector<char> facePlanL = extract_prism_face($cl->$tmpCellPlan, $fl) ;
  $tmpFacePlan = merge_quad_face(facePlanL, $cl->$prismOrientCode[$fl],
    facePlanR, $cr->$hexOrientCode[$fr]) ;
  reduce_vector($tmpFacePlan) ;
}


//-----------------------------------------------------------------------------
// Edge plans
//-----------------------------------------------------------------------------

$type tmpPointSet store<SetLong> ;

$rule unit(tmpPointSet), constraint(edge2node->pos) {
}

$rule apply(face2edge->tmpPointSet <- (tmpFacePlan, is_quadface), face2node->pos,
face2edge->edge2node->pos, face2edge->tmpPointSet)[SetLongUnionOp],
constraint(faces) {
  if($is_quadface) {
    if($*face2node.num_elems(_e_)!=4) {
      cerr << "WARNING: Not a hexcell" << endl ;
      Loci::Abort() ;
    }

    for(int i=0; i<$*face2edge.num_elems(_e_); i++) {
      int64 maxValue = int64(1) << MAXLEVEL ;
      std::vector<char> plan ;
      extract_quad_edge($tmpFacePlan, plan, i) ;
      if(plan.size() == 0) continue ;

      bool needReverse = false ;

      if(i == 0 && $face2edge[0]->$edge2node[0] == $face2node[1]) needReverse = true ;
      else if(i == 1 && $face2edge[1]->$edge2node[0] == $face2node[2]) needReverse = true ;
      else if(i == 2 && $face2edge[2]->$edge2node[0] == $face2node[2]) needReverse = true ;
      else if(i == 3 && $face2edge[3]->$edge2node[0] == $face2node[3]) needReverse = true ;

      queue<pair<int64, int64> > Q ;
      char code = plan.front() ;
      unsigned int index = 0 ;
      pair<int64, int64> pRange = make_pair(int64(0), maxValue) ;
      Q.push(pRange) ;

      int64 midP ;
      while(!Q.empty()) {
        // read in a code
        if(index >= plan.size()) {
          code = 0 ;
        }else {
          code = plan[index++] ;
        }

        // read in the range from the queue
        pRange = Q.front() ;

        // process the cell, push children ranges into Q
        // and put the middle point into points
        switch(code) {
          case 1:
            midP = (pRange.first + pRange.second)/2 ;
            Q.push(make_pair(pRange.first, midP)) ;
            Q.push(make_pair(midP, pRange.second)) ;

            if(needReverse) {
              ($face2edge[i]->$tmpPointSet.aset).insert(maxValue - midP) ;
            }else {
              ($face2edge[i]->$tmpPointSet.aset).insert(midP) ;
            }
            break ;

          case 0:
            break ;

          case 8:
            Q.push(pRange) ;
            break ;
          default:
            cerr << "WARNING: illegal splitCode in rule edge_points_apply" << endl ;
            break ;
        }
        Q.pop() ;
      }
      plan.clear() ;
    }
  }else {
    // if(is_quadface[f])

    if($tmpFacePlan.size() == 0) return ;

    int64 maxValue = int64(1) << MAXLEVEL ;

    // assume facePlan[f][0] ==1
    int nfnode = $*face2node.num_elems(_e_) ;
    std::vector<bool> needReverse(nfnode) ;

    for(int i=0; i<nfnode; i++) {
      if($face2edge[i]->$edge2node[0] == $face2node[i] &&
         $face2edge[i]->$edge2node[1] == $face2node[i==(nfnode-1)?0:i+1]) {
        needReverse[i] = false ;
      }else {
        needReverse[i] = true ;
      }
    }

    // first time split face, put all the edgecenter into pointSet
    std::queue<pair<int, TwoEdge> > Q ;
    std::vector<TwoEdge> child(nfnode) ;
    for(int i=0; i<nfnode; i++) {
      if(needReverse[i]) {
        child[i].e0 = make_pair(maxValue, maxValue/2) ;
      }else {
        child[i].e0 = make_pair(int64(0),maxValue/2) ;
      }

      if(needReverse[i==0?nfnode-1:i-1]) {
        child[i].e3 = make_pair(maxValue/2, int64(0)) ;
      }else {
        child[i].e3 = make_pair(maxValue/2, maxValue) ;
      }
      Q.push(make_pair(i, child[i])) ;
      ($face2edge[i]->$tmpPointSet.aset).insert(maxValue/2) ;
    }

    TwoEdge current ;
    unsigned  int index = 1 ;
    char mySplitCode ;
    int edgeID ;

    while(!Q.empty()) {
      current = Q.front().second ;
      edgeID = Q.front().first ;
      if(index >= $tmpFacePlan.size()) {
        mySplitCode = 0 ;
      }else {
        // take a code from splitcode
        mySplitCode = $tmpFacePlan[index] ;
        index++ ;
      }

      if(mySplitCode == 1) {
        // define new edgeID and push the children into Q
        // put edgecenter into pointSet if necessary
        int newID[4] = {-1,-1,-1,-1} ;
        
        // define the 4 children
        TwoEdge child[4] ;

        // if edgeID== -1, each newID is -1, no edgecenter need to be put
        // into pointSet
        if(edgeID == -1) {
          for(int i=0; i<3; i++) newID[i] = -1 ;
        }else if(edgeID >= 0 && edgeID < nfnode) {
          // if edgeID is in [0, nfnode), edge 0 is on edgeID, edge3 is on edgeID-1
          newID[2] = -1 ;
          newID[0] = edgeID ; // e0 on edgeID, e3 on edgeID-1
          child[0].e0 = make_pair(current.e0.first, (current.e0.first + current.e0.second)/2) ;
          child[0].e3 = make_pair((current.e3.first + current.e3.second)/2, current.e3.second) ;

          newID[1] = 2*nfnode+edgeID ; // e3 on edgId
          child[1].e3 = make_pair((current.e0.first + current.e0.second)/2, current.e0.second) ;

          newID[3] = nfnode +(edgeID==0?nfnode-1:edgeID-1) ; // e0 on edgeId
          child[3].e0 = make_pair(current.e3.first, (current.e3.first + current.e3.second)/2) ;

          $face2edge[edgeID]->$tmpPointSet.aset.insert((current.e0.first + current.e0.second)/2) ;

          $face2edge[edgeID==0?nfnode-1:edgeID-1]->$tmpPointSet.aset.insert((current.e3.first + current.e3.second)/2) ;

        }else if(edgeID >=nfnode && edgeID <2*nfnode) {
          // edge 0 on edgeID-nfnode
          newID[2] = newID[3] = -1 ;
          newID[0] = edgeID ; // e0 on edgeId
          child[0].e0 = make_pair(current.e0.first, (current.e0.first + current.e0.second)/2) ;

          newID[1] = nfnode + edgeID ; // e3 on edgeId
          child[1].e3 = make_pair((current.e0.first + current.e0.second)/2, current.e0.second) ;

          $face2edge[edgeID-nfnode]->$tmpPointSet.aset.insert((current.e0.first + current.e0.second)/2) ;
        }else if(edgeID >= 2*nfnode && edgeID < 3*nfnode) {
          // edge 3 on edgeID-2*nfnode
          newID[1] = newID[2] = -1 ;
          newID[0] = edgeID ; // e3 on edgeId
          child[0].e3 = make_pair((current.e3.first + current.e3.second)/2, current.e3.second) ;

          newID[3] = edgeID - nfnode ; // e0 on edgeId
          child[3].e0 = make_pair(current.e3.first, (current.e3.first + current.e3.second)/2) ;

          $face2edge[edgeID-2*nfnode]->$tmpPointSet.aset.insert((current.e3.first + current.e3.second)/2) ;
        }else {
          cerr << " WARNING: illegal edgeID" << endl ;
          Loci::Abort() ;
        }

        for(int i=0; i<4; i++) {
          Q.push(make_pair(newID[i],child[i])) ;
        }
      }
      Q.pop() ;
    }
  }
}

$rule pointwise(tmpEdgePlan <- tmpPointSet) {
  if($tmpPointSet.aset.empty()) return ;
  
  // define range of the integer coordinates of the edge
  int64 maxValue = int64(1) << MAXLEVEL ;
  
  //prepare to make up the refinement plan according to list points
  $tmpEdgePlan.clear() ;
  queue<pair<int64, int64> > Q ;
  pair<int64,int64> pRange = make_pair(int64(0), maxValue) ;
  Q.push(pRange) ;
  int64 midP ;

  while(!Q.empty()) {
    // read in the range
    pRange = Q.front() ;

    // define the positions
    midP = (pRange.first + pRange.second) / 2 ;

    // if midP is in pointSet,set the code to 1, else the code is 0
    if($tmpPointSet.aset.empty()) {
      break ;
    }else {
      std::set<int64>::iterator p = $tmpPointSet.aset.find(midP) ;
      if(p != $tmpPointSet.aset.end()) {
        Q.push(make_pair(pRange.first, midP)) ;
        Q.push(make_pair(midP, pRange.second)) ;
        $tmpEdgePlan.push_back(1) ;
      }else {
        $tmpEdgePlan.push_back(0) ;
      }
    }
    Q.pop() ;
  }
  while($tmpEdgePlan.size() != 0 && $tmpEdgePlan.back() == 0 ) $tmpEdgePlan.pop_back() ;
  reduce_vector($tmpEdgePlan) ;
}


//-----------------------------------------------------------------------------
// Balancing convergence
//-----------------------------------------------------------------------------

/// This unit-apply rule sequence is used to check if the balancing iteration
/// is finished.

/// Initializes parameter finishBalancing to true.
$rule unit(finishBalancing),constraint(geom_cells) {
  $finishBalancing = true ;
}

/// Applies each cellUnchanged value to finishBalancing using logical and.
$rule apply(finishBalancing<-cellUnchanged, finishBalancing)[Loci::LogicalAnd],
constraint(geom_cells) {
  join($finishBalancing, $cellUnchanged) ;
}

/// Collapse rule for when  balancing is finished. Copies newCellPlan to balanceCellPlan.
$rule pointwise(balancedCellPlan1<-tmpCellPlan{n}, finishBalancing{n}),
constraint(geom_cells), conditional(finishBalancing{n}) {
  $balancedCellPlan1 = $tmpCellPlan{n} ;
  reduce_vector($balancedCellPlan1) ;
}
