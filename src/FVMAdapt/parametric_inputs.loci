#include <Loci.h>

$include "fvmadapt_internal.lh"
$include "parametric_internal.lh"

$rule default(parametricRegionFile) { $parametricRegionFile="" ; }
$rule default(parametricSourceFile) { $parametricSourceFile="" ; }

/// Read once per query on each process; input errors reject the collective proposal.
$rule blackbox(parametricRegion,parametricSources,parametricInputError <- parametricRegionFile,parametricSourceFile),
    prelude {
  $parametricRegion->reset() ; $parametricSources->clear() ; *$parametricInputError="" ;
  try {
    if(!$parametricRegionFile->empty() && !$parametricSourceFile->empty())
      throw std::invalid_argument("choose either an XML region or spacing source file") ;
    if(!$parametricRegionFile->empty()) *$parametricRegion=std::make_shared<Loci::FVMAdapt::XMLRegion>(*$parametricRegionFile) ;
    if(!$parametricSourceFile->empty()) *$parametricSources=Loci::FVMAdapt::readSpacingSources(*$parametricSourceFile) ;
  } catch(const std::exception &error) { *$parametricInputError=error.what() ; }
} ;
