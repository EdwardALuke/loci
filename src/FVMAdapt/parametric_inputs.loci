#include <Loci.h>
#include <FVMAdapt/parametric_cell.h>
#include <map>
#include <stdexcept>
#include <cmath>
#include <set>
#include <algorithm>

$include "FVM.lh"
$include "fvmadapt_internal.lh"
$include "parametric_internal.lh"

namespace {
  namespace P = Loci::FVMAdapt ;
}

$rule default(parametricMaxDepth) { $parametricMaxDepth = 10 ; }
$rule default(parametricMaxNodes) { $parametricMaxNodes = 1000000 ; }
$rule default(parametricLevelDifference) { $parametricLevelDifference = 1 ; }
$rule default(parametricGrading) { $parametricGrading = "vertices" ; }
$rule default(parametricFaceBalance) { $parametricFaceBalance = "none" ; }
$rule default(parametricDirectionalBalance) { $parametricDirectionalBalance = false ; }
$rule default(parametricMaxRounds) { $parametricMaxRounds = 32 ; }
$rule default(parametricCenterMethod) { $parametricCenterMethod = "reference" ; }
$rule default(parametricSplitFamily) { $parametricSplitFamily = "native" ; }
$rule default(parametricAutomaticSplit) { $parametricAutomaticSplit = false ; }
$rule default(parametricRefinementLevels) { $parametricRefinementLevels = 1 ; }
$rule default(parametricSplitAspectRatio) { $parametricSplitAspectRatio = 2 ; }
$rule default(parametricMinEdgeLength) { $parametricMinEdgeLength = 0 ; }
$rule default(parametricExtrusionAxis) { $parametricExtrusionAxis = -1 ; }

$rule default(parametricRegionFile) { $parametricRegionFile="" ; }
$rule default(parametricSourceFile) { $parametricSourceFile="" ; }

/// Resolve query controls and read geometric inputs once on each process; errors reject the collective proposal.
$rule blackbox(parametricControls,parametricRegion,parametricSources,parametricInputError <-
    parametricCenterMethod,parametricRefinementLevels,parametricExtrusionAxis,parametricAutomaticSplit,
    parametricSplitAspectRatio,parametricMinEdgeLength,parametricSplitFamily,parametricLevelDifference,parametricGrading,
    parametricFaceBalance,parametricDirectionalBalance,parametricMaxRounds,parametricRegionFile,parametricSourceFile,
    parametricQualityMode,parametricQualityCentroid,parametricMaxNonOrthogonality,parametricMaxFaceWarpage,parametricMaxChildVolumeRatio),
    prelude {
  namespace P=Loci::FVMAdapt ;
  *$parametricControls=P::AdaptationControls() ;
  $parametricRegion->reset() ; $parametricSources->clear() ; *$parametricInputError="" ;
  try {
    auto &controls=*$parametricControls ; auto &refinement=controls.refinement ;
    controls.quality={ (*$parametricQualityMode), (*$parametricQualityCentroid), (*$parametricMaxNonOrthogonality),
      (*$parametricMaxFaceWarpage), (*$parametricMaxChildVolumeRatio) } ;
    refinement.center=P::parametricCenterMethod(*$parametricCenterMethod) ;
    refinement.levels=*$parametricRefinementLevels ; refinement.extrusionAxis=*$parametricExtrusionAxis ;
    refinement.automatic=*$parametricAutomaticSplit ; refinement.aspectRatio=*$parametricSplitAspectRatio ;
    refinement.minEdgeLength=*$parametricMinEdgeLength ;
    controls.levelDifference=*$parametricLevelDifference ; controls.maxRounds=*$parametricMaxRounds ;
    controls.grading=P::parametricGrading(*$parametricGrading) ;
    controls.faceBalance=P::parametricFaceBalance(*$parametricFaceBalance) ;
    controls.directionalBalance=*$parametricDirectionalBalance ;
    if(refinement.levels<1 || refinement.levels>30)
      throw std::invalid_argument("parametricRefinementLevels must be in [1,30]") ;
    if(controls.levelDifference<0 || controls.levelDifference>30)
      throw std::invalid_argument("parametricLevelDifference must be in [0,30]") ;
    if(controls.maxRounds<0) throw std::invalid_argument("parametricMaxRounds must be nonnegative") ;
    if(*$parametricSplitFamily=="mixed" && (refinement.center!=P::CenterMethod::reference || refinement.extrusionAxis!=-1))
      throw std::invalid_argument("mixed splitting requires reference centers and full 3D refinement") ;
    if(controls.directionalBalance && *$parametricSplitFamily!="native" && *$parametricSplitFamily!="mixed")
      throw std::invalid_argument("directional balancing requires native cells") ;
    if(refinement.automatic) {
      if((*$parametricSplitFamily!="native" && *$parametricSplitFamily!="mixed") || refinement.extrusionAxis!=-1)
        throw std::invalid_argument("automatic splitting requires native three-dimensional cells") ;
      if(!std::isfinite(refinement.aspectRatio) || refinement.aspectRatio<=1 ||
          !std::isfinite(refinement.minEdgeLength) || refinement.minEdgeLength<0)
        throw std::invalid_argument("automatic splitting requires a finite aspect ratio greater than one and a nonnegative edge cutoff") ;
    }
    if(!$parametricRegionFile->empty() && !$parametricSourceFile->empty())
      throw std::invalid_argument("choose either an XML region or spacing source file") ;
    if(!$parametricRegionFile->empty()) *$parametricRegion=std::make_shared<P::XMLRegion>(*$parametricRegionFile) ;
    if(!$parametricSourceFile->empty()) *$parametricSources=P::readSpacingSources(*$parametricSourceFile) ;
  } catch(const std::exception &error) { *$parametricInputError=error.what() ; }
} ;

// Original-node file rows keep geometry input independent of generated edge numbering.

namespace Loci {
  void File2LocalOrder(storeRepP &,entitySet,storeRepP,int,fact_db::distribute_infoP,MPI_Comm) ;
}
$type parametricGeometryRows store<std::vector<Loci::CubicEdgeInput>> ;
$type parametricGeometryRowError store<std::string> ;
$type parametricSuppliedGeometryPairs param<int64_t> ;
$type parametricMatchedGeometryPairs param<int64_t> ;

$rule default(parametricCubicGeometryInput) {
  $*parametricCubicGeometryInput.set_entitySet(~EMPTY) ; $parametricCubicGeometryInput=0 ;
}

$rule pointwise(parametricGeometryRows,parametricGeometryRowError <- parametricCubicGeometryInput,fileNumber(pos)),
  constraint(pos), option(disable_threading), prelude {
  const entitySet nodes=entitySet(seq) ;
  for(int node:nodes) { $parametricGeometryRows[node].clear() ; $parametricGeometryRowError[node].clear() ; }
  const int supplied=(*$parametricCubicGeometryInput!=0) ; int minimum=0,maximum=0 ;
  MPI_Allreduce(&supplied,&minimum,1,MPI_INT,MPI_MIN,MPI_COMM_WORLD) ;
  MPI_Allreduce(&supplied,&maximum,1,MPI_INT,MPI_MAX,MPI_COMM_WORLD) ;
  std::string error ;
  if(minimum!=maximum) error="cubic geometry input must be supplied on every rank" ;
  else if(maximum) {
    Loci::store<std::vector<Loci::CubicEdgeInput>> input ;
    int bad=0,anyBad=0,localMaximum=-1,globalMaximum=-1 ;
    for(int node:nodes) localMaximum=std::max(localMaximum,$fileNumber(pos)[node]) ;
    MPI_Allreduce(&localMaximum,&globalMaximum,1,MPI_INT,MPI_MAX,MPI_COMM_WORLD) ;
    int range[3]={0,-1,0} ;
    try {
      if(Loci::NPTR<Loci::storeRepI<std::vector<Loci::CubicEdgeInput>>>((*$parametricCubicGeometryInput)->getRep())==0)
        throw std::invalid_argument("cubic geometry input has the wrong store type") ;
      input=*$parametricCubicGeometryInput ; const auto domain=input.domain() ;
      if(domain!=EMPTY) {
        range[0]=domain.Min() ; range[1]=domain.Max() ; range[2]=domain.size() ;
        if(range[0]<0 || static_cast<long long>(range[1])-range[0]+1!=range[2]) bad=1 ;
      }
      for(int node:domain) {
        std::set<int> endpoints ;
        for(const auto &edge:input[node]) {
          if(edge.otherVertex<=node || edge.otherVertex>globalMaximum || !endpoints.insert(edge.otherVertex).second) bad=1 ;
          for(const auto &p:{edge.firstControl,edge.secondControl})
            if(!std::isfinite(p.x) || !std::isfinite(p.y) || !std::isfinite(p.z)) bad=1 ;
        }
      }
    } catch(const std::exception &) { bad=1 ; }
    std::vector<int> ranges(3*Loci::MPI_processes) ;
    MPI_Allgather(range,3,MPI_INT,ranges.data(),3,MPI_INT,MPI_COMM_WORLD) ;
    long long next=0 ;
    for(int rank=0;rank<Loci::MPI_processes;++rank) if(ranges[3*rank+2]) {
      if(ranges[3*rank]!=next) bad=1 ;
      next=static_cast<long long>(ranges[3*rank+1])+1 ;
    }
    if(next!=static_cast<long long>(globalMaximum)+1) bad=1 ;
    MPI_Allreduce(&bad,&anyBad,1,MPI_INT,MPI_MAX,MPI_COMM_WORLD) ;
    if(anyBad) error="invalid cubic geometry rows or original-node file partition" ;
    else {
      const auto dist=Loci::exec_current_fact_db->get_distribute_info() ;
      if(dist==0) for(int node:nodes) $parametricGeometryRows[node]=input[$fileNumber(pos)[node]] ;
      else {
        auto rep=$parametricGeometryRows.Rep() ;
        Loci::File2LocalOrder(rep,nodes,input.Rep(),0,dist,MPI_COMM_WORLD) ; $parametricGeometryRows=rep ;
      }
      for(int node:nodes) std::sort($parametricGeometryRows[node].begin(),$parametricGeometryRows[node].end(),
        [](const auto &a,const auto &b) { return a.otherVertex<b.otherVertex ; }) ;
    }
  }
  if(!error.empty()) for(int node:nodes) $parametricGeometryRowError[node]=error ;
} ;

$rule pointwise(parametricInputEdgeControls,parametricInputEdgeError <- edge2node->(fileNumber(pos),parametricGeometryRows,parametricGeometryRowError)),
  constraint(edge2node->pos) {
  $parametricInputEdgeControls.clear() ; $parametricInputEdgeError.clear() ;
  const bool reverse=$edge2node[1]->$fileNumber(pos)<$edge2node[0]->$fileNumber(pos) ;
  for(unsigned i=0;i<2;++i) if(!$edge2node[i]->$parametricGeometryRowError.empty())
    $parametricInputEdgeError=$edge2node[i]->$parametricGeometryRowError ;
  const auto &rows=$edge2node[reverse ? 1:0]->$parametricGeometryRows ;
  const int other=$edge2node[reverse ? 0:1]->$fileNumber(pos) ;
  const auto found=std::lower_bound(rows.begin(),rows.end(),other,
    [](const auto &row,int vertex) { return row.otherVertex<vertex ; }) ;
  if(found!=rows.end() && found->otherVertex==other)
    $parametricInputEdgeControls={found->firstControl,found->secondControl} ;
}
$rule unit(parametricSuppliedGeometryPairs), constraint(UNIVERSE) { $parametricSuppliedGeometryPairs=0 ; }
$rule apply(parametricSuppliedGeometryPairs <- parametricGeometryRows)[Loci::Summation], constraint(pos) {
  join($parametricSuppliedGeometryPairs,static_cast<long long>($parametricGeometryRows.size())) ;
}
$rule unit(parametricMatchedGeometryPairs), constraint(UNIVERSE) { $parametricMatchedGeometryPairs=0 ; }
$rule apply(parametricMatchedGeometryPairs <- parametricInputEdgeControls)[Loci::Summation], constraint(edge2node->pos) {
  join($parametricMatchedGeometryPairs,$parametricInputEdgeControls.empty() ? 0LL:1LL) ;
}
$rule singleton(parametricGeometryPairsValid <- parametricSuppliedGeometryPairs,parametricMatchedGeometryPairs), constraint(UNIVERSE) {
  $parametricGeometryPairsValid=$parametricSuppliedGeometryPairs==$parametricMatchedGeometryPairs ;
}

// Saved histories and original cell geometry.

/// Saved file-order histories supplied by the online driver; null initializes original cells.
$type parametricHistoryInput blackbox<Loci::storeRepP> ;

$rule pointwise(parametricCellHistory <- parametricHistoryInput), constraint(geom_cells), option(disable_threading), prelude {
  const entitySet cells=entitySet(seq) ;
  if(*$parametricHistoryInput==0) {
    for(int cell:cells) $parametricCellHistory[cell].clear() ;
  } else {
    const auto dist=Loci::exec_current_fact_db->get_distribute_info() ;
    Loci::store<P::ParametricRecord> saved ; saved=*$parametricHistoryInput ;
    if(dist==0) { for(int cell:cells) $parametricCellHistory[cell]=saved[cell] ; }
    else {
      Loci::store<P::ParametricRecord> local ; local.allocate(cells) ; auto rep=local.Rep() ;
      Loci::File2LocalOrder(rep,cells,saved.Rep(),0,dist,MPI_COMM_WORLD) ; local=rep ;
      for(int cell:cells) $parametricCellHistory[cell]=local[cell] ;
    }
  }
} ;

$rule pointwise(parametricTopology,initialParametricHistory,initialParametricCell,parametricInitialError <- parametricCellHistory,fileNumber(geom_cells),
  (lower,upper,boundary_map)->fileNumber(face2node), (lower,upper,boundary_map)->face2node->(pos,fileNumber(pos)),
  (lower,upper,boundary_map)->face2edge->(fileNumber(edge2node),parametricInputEdgeControls,parametricInputEdgeError),
  (lower,upper,boundary_map)->face2edge->edge2node->fileNumber(pos),parametricGeometryPairsValid,
  parametricMaxDepth,parametricMaxNodes,parametricSplitFamily,parametricExtrusionAxis), constraint(geom_cells) {
  $initialParametricHistory = $parametricCellHistory ; $initialParametricCell = P::ParametricCellData() ; $parametricInitialError.clear() ; $parametricTopology.clear() ;
  try {
    if(!$parametricGeometryPairsValid) throw std::invalid_argument("cubic geometry names a pair that is not a source edge") ;
    std::vector<P::EntityId> faceIds, edgeIds ; std::vector<std::vector<P::EntityId>> loops ;
    std::vector<std::array<P::EntityId,2>> ends ; std::map<P::EntityId,P::Point> positions ;
    std::map<P::EntityId,std::vector<P::Point>> edgeControls ;
    const auto addFace = [&](int face, bool reverse) {
      faceIds.push_back($*fileNumber(face2node)[face]) ; std::vector<P::EntityId> loop ;
      for(int node: $*face2node[face]) {
        const auto id = $*fileNumber(pos)[node] ; const auto &p = $*pos[node] ;
        loop.push_back(id) ; positions[id] = {{p.x,p.y,p.z} } ;
      }
      if(reverse) std::reverse(loop.begin(),loop.end()) ; loops.push_back(std::move(loop)) ;
      for(int edge: $*face2edge[face]) {
        if(!$*parametricInputEdgeError[edge].empty()) throw std::invalid_argument($*parametricInputEdgeError[edge]) ;
        edgeIds.push_back($*fileNumber(edge2node)[edge]) ;
        ends.push_back({P::EntityId($*fileNumber(pos)[$*edge2node[edge][0]]),P::EntityId($*fileNumber(pos)[$*edge2node[edge][1]])}) ;
        const auto &controls=$*parametricInputEdgeControls[edge] ;
        if(!controls.empty()) {
          auto &row=edgeControls[$*fileNumber(edge2node)[edge]] ; row.clear() ;
          for(const auto &p:controls) row.push_back({p.x,p.y,p.z}) ;
        }
      }
    } ;
    for(int face: $lower) addFace(face,true) ;
    for(int face: $upper) addFace(face,false) ;
    for(int face: $boundary_map) addFace(face,false) ;
    const auto topology = P::parametricCellTopology($fileNumber(geom_cells),faceIds,loops,edgeIds,ends) ;
    $parametricTopology = P::encodeParametricTopology(topology) ; std::vector<P::Point> corners ;
    for(unsigned v = 0; v < topology.vertexCount(); ++v) corners.push_back(positions.at(topology.vertexId(v))) ;
    P::ParametricEdgeControls controls ;
    if(!edgeControls.empty()) {
      controls.resize(topology.edgeCount()) ;
      for(unsigned e=0;e<topology.edgeCount();++e) {
        const auto found=edgeControls.find(topology.edgeId(e)) ;
        if(found!=edgeControls.end()) controls[e]=found->second ;
      }
    }
    $initialParametricCell = P::ParametricCellData::initial(topology,corners,$parametricCellHistory,
      $parametricMaxDepth,$parametricMaxNodes,$parametricSplitFamily,$parametricExtrusionAxis,controls) ;
    $initialParametricHistory = $initialParametricCell.record() ;
  } catch(const std::exception &error) { $parametricInitialError = error.what() ; }
}

/// Incident cells must retain the same source curve on each shared edge.
$rule unit(parametricSourceEdgeGeometry), constraint(edge2node->pos) {
  $parametricSourceEdgeGeometry=P::EdgeGeometryData() ;
}
$rule apply((lower,upper,boundary_map)->face2edge->parametricSourceEdgeGeometry <- initialParametricCell,parametricInitialError,parametricTopology,
  (lower,upper,boundary_map)->face2edge->fileNumber(edge2node))[ParametricFaceUnion], constraint(geom_cells) {
  if(!$parametricInitialError.empty()) return ;
  std::map<P::EntityId,P::EdgeGeometryData> curves ; bool failed=false ;
  try {
    const auto topology=P::decodeParametricTopology($parametricTopology) ;
    const auto controls=$initialParametricCell.sourceEdgeControls(topology) ;
    for(unsigned e=0;e<topology.edgeCount();++e) {
      auto &curve=curves[topology.edgeId(e)] ; curve.assigned=true ; curve.controls=controls[e] ;
    }
  } catch(const std::exception &) { failed=true ; }
  std::set<int> visited ;
  const auto contribute=[&](int face) {
    for(int edge:$*face2edge[face]) if(visited.insert(edge).second) {
      P::EdgeGeometryData value ; const auto found=curves.find($*fileNumber(edge2node)[edge]) ;
      if(failed || found==curves.end()) value.failed=true ; else value=found->second ;
      join($*parametricSourceEdgeGeometry[edge],value) ;
    }
  } ;
  for(int face:$lower) contribute(face) ; for(int face:$upper) contribute(face) ; for(int face:$boundary_map) contribute(face) ;
}

/// Input leaf counts for file-order marking.
$rule pointwise(num_fine_cells <- initialParametricCell), constraint(geom_cells) {
  $num_fine_cells = int($initialParametricCell.leafCount()) ;
}
