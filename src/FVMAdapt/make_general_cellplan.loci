#ifndef USE_LIBXML2
typedef struct _xmlDoc xmlDoc;
#endif

using std::list ;
using std::queue ;
using std::cerr ;
using std::endl ;
using std::cout ;
using Loci::storeRepP ;
//int currentMem(void) ;

#ifdef USE_LIBXML2
bool mark_node(xmlNode* root_element,
               std::list<Node*>::iterator begin_pnt,
               std::list<Node*>::iterator end_pnt);
#endif

/// Read the XML region once for all cell topologies.
$rule blackbox(cellPlanXMLDoc <- xmlfile_par), prelude {
#ifdef USE_LIBXML2
  xmlDoc* doc = xmlReadFile((*$xmlfile_par).c_str(), NULL, 0) ;
  if(doc==NULL) {
    cerr << "WARNING: fail to parse xml file" << endl ;
    Loci::Abort() ;
  }
  xmlNode* root_element = xmlDocGetRootElement(doc) ;
  if(root_element == NULL) {
    xmlFreeDoc(doc) ;
    cerr << "WARNING: fail to parse xml file" << endl ;
    Loci::Abort() ;
  }
  *$cellPlanXMLDoc = std::shared_ptr<xmlDoc>(doc, [](xmlDoc* owned_doc) {
    xmlFreeDoc(owned_doc) ;
  }) ;
#else
  cerr << "adaptation code not compiled with libxml!  XML features not available!" ;
  Loci::Abort() ;
#endif
} ;

/// Read the parameter sources once for all cell topologies.
$rule blackbox(cellPlanSources <- parfile_par), prelude {
  vector<source_par> sources ;
  readPar(*$parfile_par, sources) ;
  if(sources.size()==0) {
    cerr << "WARNING: fail to read par file" << endl ;
    Loci::Abort() ;
  }
  *$cellPlanSources = sources ;
} ;

/// This rule make a newCellPlan according to cellPlan
/// and nodeTag, posTag
$rule pointwise(newCellPlan <- restart_tag_par, cellPlan, nodeTag,
isIndivisible,
(lower, upper, boundary_map)->(facePlan, is_quadface, nodeTag),
(lower, upper, boundary_map)->face2node->(pos, posTag, fileNumber(pos)),
(lower, upper, boundary_map)->face2edge->edge2node->pos,
(lower, upper, boundary_map)->face2edge->(edgePlan, nodeTag)),
constraint(gnrlcells) {

  if(!$isIndivisible) {
    std::list<Node*> node_list ;
    std::list<Edge*> edge_list ;
    std::list<Face*> face_list ;
    std::list<Node*> bnode_list ;
    int nindex ;

    Cell* aCell = build_general_cell($lower.begin(), $lower.size(),
                                     $upper.begin(), $upper.size(),
                                     $boundary_map.begin(), $boundary_map.size(),
                                     $*is_quadface,
                                     $*face2node,
                                     $*face2edge,
                                     $*edge2node,
                                     $*pos,
                                     $*edgePlan,
                                     $*facePlan,
                                     $*posTag,
                                     $*nodeTag,
                                     bnode_list,
                                     edge_list,
                                     face_list,
                                     $*fileNumber(pos));

    // calculate min_edge_length of the cell
    double min_edge_length =aCell->get_min_edge_length() ;
    std::vector<DiamondCell*> cells ;
    aCell->resplit($cellPlan, node_list, edge_list, face_list, cells) ;

    nindex = 0 ;
    for(std::list<Node*>::const_iterator np = node_list.begin(); np!= node_list.end(); np++) {
      (*np)->tag = $nodeTag[nindex++] ;
    }

    // split the cell Globals::levels times
    int numCells = cells.size();
    bool cell_split = false;
    if(numCells != 0) { // aCell is not a leaf
      for(int i=0; i<numCells; i++) {
        if((cells[i]->get_tagged())==1) {
          if((min_edge_length/double(1<<(cells[i]->getLevel()+Globals::levels))) > Globals::tolerance) {
            cells[i]->resplit(Globals::levels,node_list, edge_list, face_list) ;
            cell_split = true ;
          }else {
            int split_level = Globals::levels ;
            if(Globals::tolerance > 0.0) {
              split_level = int(log(min_edge_length/Globals::tolerance)/log(2.0) - cells[i]->getLevel()) ;
            }
            if(split_level >= 1) {
              cells[i]->resplit(split_level,node_list, edge_list, face_list) ;
              cell_split = true ;
            }
          }
        }
      }
    }else { //aCell is a leaf
      if(aCell->get_tagged()==1) {
        int split_level = Globals::levels ;
        if(Globals::tolerance > 0.0) {
          split_level = int(log(min_edge_length/Globals::tolerance)/log(2.0)) ;
        }
        if(split_level >= 1) {
          aCell->split(node_list, edge_list, face_list) ;
          for(int i=0; i<aCell->numNode; i++) {
            aCell->child[i]->resplit(min(Globals::levels, split_level)-1, node_list, edge_list, face_list) ;
          }
        }
      }
    }

    // rebalance this cell
    if(cell_split) {
      aCell->rebalance_cells(node_list, edge_list, face_list) ;
      $newCellPlan = aCell->make_cellplan() ;
    }else {
      // write new cellPlan
      $newCellPlan = aCell->make_cellplan() ;
    }

    // clean up
    if(aCell != 0) {
      delete aCell ;
      aCell = 0 ;
    }
    cleanup_list(node_list, edge_list, face_list) ;
    cleanup_list(bnode_list) ;
    reduce_vector($newCellPlan) ;
  }
}


/// This rule make a newCellPlan according to posTag
$rule pointwise(newCellPlan <- isIndivisible,
(lower, upper, boundary_map)->face2node->(pos, posTag, fileNumber(pos)),
(lower, upper, boundary_map)->face2edge->edge2node->pos,
norestart_tag_par), constraint(gnrlcells) {
  if(!$isIndivisible) {
    std::list<Node*> node_list ;
    std::list<Edge*> edge_list ;
    std::list<Face*> face_list ;
    std::list<Node*> bnode_list ;

    Cell* aCell = build_general_cell($lower.begin(), $lower.size(),
                                     $upper.begin(), $upper.size(),
                                     $boundary_map.begin(), $boundary_map.size(),
                                     $*face2node,
                                     $*face2edge,
                                     $*edge2node,
                                     $*pos,
                                     $*posTag,
                                     bnode_list,
                                     edge_list,
                                     face_list,
                                     $*fileNumber(pos));

    // calculate min_edge_length of the cell
    double min_edge_length =aCell->get_min_edge_length() ;

    // split the cell Globals::levels times
    if(aCell->get_tagged()==1) {
      int split_level = Globals::levels ;
      if(Globals::tolerance > 0.0) {
        split_level = int(log(min_edge_length/Globals::tolerance)/log(2.0)) ;
      }

      if(split_level >= 1) {
        aCell->split(node_list, edge_list, face_list) ;
        for(int i=0; i<aCell->numNode; i++) {
          aCell->child[i]->resplit(min(Globals::levels, split_level)-1, node_list, edge_list, face_list) ;
        }
      }
    }

    // write new cellPlan
    $newCellPlan = aCell->make_cellplan() ;

    // clean up
    if(aCell != 0) {
      delete aCell ;
      aCell = 0 ;
    }

    cleanup_list(node_list, edge_list, face_list) ;
    cleanup_list(bnode_list) ;
    reduce_vector($newCellPlan) ;
  }
}


/// This rule make a newCellPlan according to  xml file and input plan file
$rule pointwise(newCellPlan <- xmlfile_par, restart_xml_par,
cellPlan, isIndivisible,
(lower, upper, boundary_map)->(facePlan, is_quadface),
(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
(lower, upper, boundary_map)->face2edge->edge2node->pos,
(lower, upper, boundary_map)->face2edge->edgePlan, cellPlanXMLDoc),
constraint(gnrlcells) {

#ifdef USE_LIBXML2
  xmlNode* root_element = xmlDocGetRootElement($*cellPlanXMLDoc->get()) ;

  if(!$isIndivisible) {
    std::list<Edge*> edge_list ;
    std::list<Face*> face_list ;
    std::list<Node*> bnode_list ;
    std::queue<DiamondCell*> Q ;

    Cell* aCell = build_general_cell($lower.begin(), $lower.size(),
                                     $upper.begin(), $upper.size(),
                                     $boundary_map.begin(), $boundary_map.size(),
                                     $*is_quadface,
                                     $*face2node,
                                     $*face2edge,
                                     $*edge2node,
                                     $*pos,
                                     $*edgePlan,
                                     $*facePlan,
                                     bnode_list,
                                     edge_list,
                                     face_list,
                                     $*fileNumber(pos));

    if(!mark_node(root_element, bnode_list.begin(), bnode_list.end())) {
      cerr << "WARNING: fail to mark nodes, please check xml file" << endl ;
      Loci::Abort() ;
    }

    std::vector<DiamondCell*> cells ;
    std::list<Node*>::iterator former_pnt = bnode_list.end() ;
    aCell->resplit($cellPlan, bnode_list, edge_list, face_list, cells) ;

    former_pnt-- ;
    if(!mark_node(root_element, bnode_list.begin(), bnode_list.end())) {
      cerr << "WARNING: fail to mark nodes, please check xml file" << endl ;
      Loci::Abort() ;
    }

    DiamondCell* current ;

    // split the cell Globals::levels times
    int numCells = cells.size() ;

    if(numCells != 0) {
      for(int i=0; i<numCells; i++) {
        Q.push(cells[i]) ;
      }
    }else {
      double min_edge_length = aCell->get_min_edge_length() ;
      if(aCell->get_tagged()==1 && min_edge_length > (2*Globals::tolerance)) {
        former_pnt = bnode_list.end() ;
        aCell->split(bnode_list, edge_list, face_list) ;
        former_pnt-- ;
        if(!mark_node(root_element, bnode_list.begin(), bnode_list.end())) {
          cerr << "WARNING: fail to mark nodes, please check xml file" << endl ;
          Loci::Abort() ;
        }

        for(int i=0; i<aCell->numNode; i++) {
          Q.push(aCell->child[i]) ;
        }
      }
    }

    while(!Q.empty()) {
      current =Q.front() ;

      // calculate min_edge_length of the cell
      double min_edge_length =current->get_min_edge_length() ;

      if(current->get_tagged()==1 && min_edge_length > (2*Globals::tolerance)) {
        former_pnt = bnode_list.end() ;
        current->split(bnode_list, edge_list, face_list) ;

        former_pnt-- ;
        if(!mark_node(root_element, bnode_list.begin(), bnode_list.end())) {
          cerr << "WARNING: fail to mark nodes, please check xml file" << endl ;
          Loci::Abort() ;
        }

        for(int i=0; i<2*current->getNfold()+2; i++) {
          Q.push(current->getChildCell(i)) ;
        }
      }
      Q.pop() ;
    }
    aCell->rebalance_cells(bnode_list, edge_list, face_list) ;

    // write new cellPlan
    $newCellPlan = aCell->make_cellplan() ;

    // clean up
    if(aCell != 0) {
      delete aCell ;
      aCell = 0 ;
    }
    cleanup_list(bnode_list, edge_list, face_list) ;
    reduce_vector($newCellPlan) ;
  }
#endif
}


/// This rule make a newCellPlan according to xml file
$rule pointwise(newCellPlan <- norestart_xml_par,
isIndivisible, xmlfile_par,
(lower, upper, boundary_map)->face2node->pos,
(lower, upper, boundary_map)->face2edge->edge2node->pos,
(lower, upper, boundary_map)->face2node->fileNumber(pos),
cellPlanXMLDoc),
constraint(gnrlcells) {
#ifdef USE_LIBXML2
  xmlNode* root_element = xmlDocGetRootElement($*cellPlanXMLDoc->get()) ;
  if(!$isIndivisible) {
    std::list<Edge*> edge_list ;
    std::list<Face*> face_list ;
    std::list<Node*> bnode_list ;
    std::queue<DiamondCell*> Q ;

    Cell* aCell = build_general_cell($lower.begin(), $lower.size(),
                                     $upper.begin(), $upper.size(),
                                     $boundary_map.begin(), $boundary_map.size(),
                                     $*face2node,
                                     $*face2edge,
                                     $*edge2node,
                                     $*pos,
                                     bnode_list,
                                     edge_list,
                                     face_list,
                                     $*fileNumber(pos));

    DiamondCell* current ;

    if(!mark_node(root_element,bnode_list.begin(), bnode_list.end())) {
      cerr << "WARNING: fail to mark nodes, please check xml file" << endl ;
      Loci::Abort() ;
    }

    double min_edge_length =aCell->get_min_edge_length() ;
    if(aCell->get_tagged()==1 && min_edge_length > (2*Globals::tolerance)) {
      std::list<Node*>::iterator former_pnt = bnode_list.end() ;
      aCell->split(bnode_list, edge_list, face_list) ;
      former_pnt-- ;
      if(!mark_node(root_element, bnode_list.begin(), bnode_list.end())) {
        cerr << "WARNING: fail to mark nodes, plase check xml file" << endl ;
        Loci::Abort() ;
      }
      for(int i=0; i<aCell->numNode; i++) {
        Q.push(aCell->child[i]) ;
      }

      while(!Q.empty()) {
        current =Q.front() ;

        // calculate min_edge_length of the cell
        double min_edge_length = current->get_min_edge_length() ;

        if(current->get_tagged()==1 && min_edge_length > (2*Globals::tolerance)) {
          std::list<Node*>::iterator former_pnt = bnode_list.end() ;
          current->split(bnode_list, edge_list, face_list) ;

          former_pnt-- ;
          if(!mark_node(root_element, bnode_list.begin(), bnode_list.end())) {
            cerr << "WARNING: fail to mark nodes, please check xml file" << endl ;
            Loci::Abort() ;
          }
          for(int i=0; i<2*current->getNfold()+2; i++) {
            Q.push(current->getChildCell(i)) ;
          }
        }
        Q.pop() ;
      }
      aCell->rebalance_cells(bnode_list, edge_list, face_list) ;
    }

    // write new cellPlan
    $newCellPlan = aCell->make_cellplan() ;

    // clean up
    if(aCell != 0) {
      delete aCell ;
      aCell = 0 ;
    }

    cleanup_list(bnode_list, edge_list, face_list) ;
    reduce_vector($newCellPlan) ;
  }
#endif
}


/// Make a newCellPlan according to par file and input plan file
$rule pointwise(newCellPlan <- parfile_par, restart_par_par,
cellPlan, isIndivisible,
(lower, upper, boundary_map)->(facePlan, is_quadface),
(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
(lower, upper, boundary_map)->face2edge->edge2node->pos,
(lower, upper, boundary_map)->face2edge->edgePlan, cellPlanSources),
constraint(gnrlcells) {

  const vector<source_par>& sources = *($*cellPlanSources) ;
  if(!$isIndivisible) {
    std::list<Edge*> edge_list ;
    std::list<Face*> face_list ;
    std::list<Node*> bnode_list ;
    std::queue<DiamondCell*> Q ;
    Cell* aCell = build_general_cell($lower.begin(), $lower.size(),
                                     $upper.begin(), $upper.size(),
                                     $boundary_map.begin(), $boundary_map.size(),
                                     $*is_quadface,
                                     $*face2node,
                                     $*face2edge,
                                     $*edge2node,
                                     $*pos,
                                     $*edgePlan,
                                     $*facePlan,
                                     bnode_list,
                                     edge_list,
                                     face_list,
                                     $*fileNumber(pos)) ;
    std::vector<DiamondCell*> cells ;
    aCell->resplit( $cellPlan, bnode_list, edge_list, face_list, cells) ;
    DiamondCell* current ;
    int numCells = cells.size() ;
    if(numCells != 0) {
      for(int i=0; i<numCells; i++) {
        Q.push(cells[i]) ;
      }
    }else {
      if(aCell->get_tagged(sources) == 1) {
        aCell->split(bnode_list, edge_list, face_list) ;

        for(int i=0; i<aCell->numNode; i++) {
          Q.push(aCell->child[i]) ;
        }
      }
    }

    while(!Q.empty()) {
      current =Q.front() ;
      if(current->get_tagged(sources) == 1) {
        current->split(bnode_list, edge_list, face_list) ;
        for(int i=0; i<2*current->getNfold()+2; i++) {
          Q.push(current->getChildCell(i)) ;
        }
      }
      Q.pop() ;
    }
    aCell->rebalance_cells(bnode_list, edge_list, face_list) ;

    // write new cellPlan
    $newCellPlan = aCell->make_cellplan() ;

    //clean up
    if(aCell != 0) {
      delete aCell ;
      aCell = 0 ;
    }

    cleanup_list(bnode_list, edge_list, face_list) ;
    reduce_vector($newCellPlan) ;
  }
}


/// Make a newCellPlan according to par file
$rule pointwise(newCellPlan <- norestart_par_par,
isIndivisible, parfile_par,
(lower, upper, boundary_map)->face2node->pos,
(lower, upper, boundary_map)->face2edge->edge2node->pos,
(lower, upper, boundary_map)->face2node->fileNumber(pos),
cellPlanSources),
constraint(gnrlcells) {

    const vector<source_par>& sources = *($*cellPlanSources) ;
    if(!$isIndivisible) {
      std::list<Edge*> edge_list ;
      std::list<Face*> face_list ;
      std::list<Node*> bnode_list ;
      std::queue<DiamondCell*> Q ;

      Cell* aCell = build_general_cell($lower.begin(), $lower.size(),
                                       $upper.begin(), $upper.size(),
                                       $boundary_map.begin(), $boundary_map.size(),
                                       $*face2node,
                                       $*face2edge,
                                       $*edge2node,
                                       $*pos,
                                       bnode_list,
                                       edge_list,
                                       face_list,
                                       $*fileNumber(pos));

      DiamondCell* current ;
      if(aCell->get_tagged(sources) ==1) {
        aCell->split(bnode_list, edge_list, face_list) ;
        for(int i=0; i<aCell->numNode; i++) {
          Q.push(aCell->child[i]) ;
        }

        while(!Q.empty()) {
          current =Q.front() ;
          if(current->get_tagged(sources) == 1 ) {
            current->split(bnode_list, edge_list, face_list) ;
            for(int i=0; i <2*current->getNfold()+2; i++) {
              Q.push(current->getChildCell(i)) ;
            }
          }
          Q.pop() ;
        }
        aCell->rebalance_cells(bnode_list, edge_list, face_list) ;
      }

      // write new cellPlan
      $newCellPlan = aCell->make_cellplan() ;

      //clean up
      if(aCell != 0) {
        delete aCell ;
        aCell = 0 ;
      }

      cleanup_list(bnode_list, edge_list, face_list) ;
      reduce_vector($newCellPlan) ;
    }
}


/// Dummy parameter to trick Loci scheduler
$rule pointwise(priority::restart::balancedCellPlan <- beginWithMarker,
restart_tag_par, cellPlan, balancedCellPlan1, nodeTag, isIndivisible,
(lower, upper, boundary_map)->(facePlan, balancedFacePlan1, is_quadface, nodeTag),
(lower, upper, boundary_map)->face2node->(pos, posTag, fileNumber(pos)),
(lower, upper, boundary_map)->face2edge->edge2node->pos,
(lower, upper, boundary_map)->face2edge->(edgePlan, balancedEdgePlan1, nodeTag)),
constraint(gnrlcells) {

  if(!$isIndivisible) {
    std::list<Node*> node_list ;
    std::list<Edge*> edge_list ;
    std::list<Face*> face_list ;
    std::list<Node*> bnode_list ;

    Cell* aCell = build_resplit_general_cell($lower.begin(), $lower.size(),
                                             $upper.begin(), $upper.size(),
                                             $boundary_map.begin(), $boundary_map.size(),
                                             $*is_quadface,
                                             $*face2node,
                                             $*face2edge,
                                             $*edge2node,
                                             $*pos,
                                             $*edgePlan,
                                             $*facePlan,
                                             $*balancedEdgePlan1,
                                             $*balancedFacePlan1,
                                             $*posTag,
                                             $*nodeTag,
                                             bnode_list,
                                             node_list,
                                             edge_list,
                                             face_list,
                                             $*fileNumber(pos),
                                             $cellPlan,
                                             $nodeTag);

    std::vector<DiamondCell*> cells ; //leaves collected according to cellPlan1
    aCell->resplit( $balancedCellPlan1, node_list, edge_list, face_list, cells) ;

    // re-collect leaves according to tree structure
    std::list<DiamondCell*> leaves ;
    aCell->sort_leaves(leaves) ;

    // first if any cell need derefine
    std::set<DiamondCell*> dparents ;
    bool check_root = false ;

    // mark the cell that will be eliminated
    for(std::list<DiamondCell*>::const_iterator li = leaves.begin(); li != leaves.end(); li++) {
      if((*li)->get_tagged() ==2) {
        DiamondCell* parent = (*li)->getParentCell() ;
        if(parent==0) { check_root = true ; }
        if(parent!=0 && parent->needDerefine()) {
          dparents.insert(parent) ;
        }
      }
    }

    // derefine the cells
    for(std::set<DiamondCell*>::const_iterator si = dparents.begin(); si!= dparents.end(); si++) {
      (*si)->derefine() ;
    }
    if(check_root) {
      if(aCell->needDerefine()) aCell->derefine() ;
    }

    $balancedCellPlan = aCell->make_cellplan() ;

    // clean up
    if(aCell != 0) {
      delete aCell ;
      aCell = 0 ;
    }
    cleanup_list(node_list, edge_list, face_list) ;
    cleanup_list(bnode_list) ;
    reduce_vector($balancedCellPlan) ;
  }
}


/// Make a newCellPlan according to cellPlan and fineCellTag
$rule pointwise(newCellPlan <- restart_tag_par, cellPlan, fineCellTag,
isIndivisible,
(lower, upper, boundary_map)->(facePlan, is_quadface),
(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
(lower, upper, boundary_map)->face2edge->edge2node->pos,
(lower, upper, boundary_map)->face2edge->edgePlan),
constraint(gnrlcells) {

  if(!$isIndivisible) {
    std::list<Node*> node_list ;
    std::list<Edge*> edge_list ;
    std::list<Face*> face_list ;
    std::list<Node*> bnode_list ;

    Cell* aCell = build_general_cell($lower.begin(), $lower.size(),
                                      $upper.begin(), $upper.size(),
                                      $boundary_map.begin(), $boundary_map.size(),
                                      $*is_quadface,
                                      $*face2node,
                                      $*face2edge,
                                      $*edge2node,
                                      $*pos,
                                      $*edgePlan,
                                      $*facePlan,
                                      bnode_list,
                                      edge_list,
                                      face_list,
                                      $*fileNumber(pos));

    // calculate min_edge_length of the cell
    double min_edge_length = aCell->get_min_edge_length() ;

    std::vector<DiamondCell*> cells ;
    aCell->resplit( $cellPlan, node_list, edge_list, face_list, cells) ;

    // split the cell Globals::levels times
    int numCells = cells.size() ;
    bool cell_split = false ;
    if(numCells != 0) { //aCell is not a leaf
      for(int i=0; i<numCells; i++) {
        if($fineCellTag[i]==1) {
          if((min_edge_length/double(1<<(cells[i]->getLevel()+Globals::levels))) > Globals::tolerance) {
            cells[i]->resplit(Globals::levels,node_list, edge_list, face_list) ;
            cell_split = true ;
          }else {
            int split_level = Globals::levels ;
            if(Globals::tolerance > 0.0) {
              split_level = int(log(min_edge_length/Globals::tolerance)/log(2.0) - cells[i]->getLevel()) ;
            }
            if(split_level >= 1) {
              cells[i]->resplit(split_level,node_list, edge_list, face_list) ;
              cell_split = true ;
            }
          }
        }
      }
    }else { //aCell is a leaf
      if($fineCellTag[0]==1) {
        int split_level = Globals::levels ;
        if(Globals::tolerance > 0.0) {
          split_level = int(log(min_edge_length/Globals::tolerance)/log(2.0)) ;
        }
        if(split_level >= 1) {
          aCell->split(node_list, edge_list, face_list) ;
          for(int i=0; i<aCell->numNode; i++) {
            aCell->child[i]->resplit(min(Globals::levels, split_level)-1, node_list, edge_list, face_list) ;
          }
        }
      }
    }

    // rebalance this cell
    if(cell_split) {
      aCell->rebalance_cells(node_list, edge_list, face_list) ;
      $newCellPlan = aCell->make_cellplan() ;
    }else {
      // write new cellPlan
      $newCellPlan = aCell->make_cellplan() ;
    }

    // clean up
    if(aCell != 0) {
      delete aCell ;
      aCell = 0 ;
    }
    cleanup_list(node_list, edge_list, face_list) ;
    cleanup_list(bnode_list) ;
    reduce_vector($newCellPlan) ;
  }
}


/// Make a newCellPlan according to cellTag
$rule pointwise(newCellPlan <- isIndivisible, cellTag,
(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
(lower, upper, boundary_map)->face2edge->edge2node->pos,
norestart_tag_par), constraint(gnrlcells) {
  if(!$isIndivisible) {
    std::list<Node*> node_list ;
    std::list<Edge*> edge_list ;
    std::list<Face*> face_list ;
    std::list<Node*> bnode_list ;

    Cell* aCell = build_general_cell($lower.begin(), $lower.size(),
                                      $upper.begin(), $upper.size(),
                                      $boundary_map.begin(), $boundary_map.size(),
                                      $*face2node,
                                      $*face2edge,
                                      $*edge2node,
                                      $*pos,
                                      bnode_list,
                                      edge_list,
                                      face_list,
                                      $*fileNumber(pos));

    // calculate min_edge_length of the cell
    double min_edge_length =aCell->get_min_edge_length() ;

    // split the cell Globals::levels times
    if($cellTag==1) {
      int split_level = Globals::levels ;
      if(Globals::tolerance > 0.0) {
        split_level = int(log(min_edge_length/Globals::tolerance)/log(2.0)) ;
      }

      if(split_level >= 1) {
        aCell->split(node_list, edge_list, face_list) ;
        for(int i=0; i<aCell->numNode; i++) {
          aCell->child[i]->resplit(min(Globals::levels, split_level)-1, node_list, edge_list, face_list) ;
        }
      }
    }

    // write new cellPlan
    $newCellPlan = aCell->make_cellplan() ;

    // clean up
    if(aCell != 0) {
      delete aCell ;
      aCell = 0 ;
    }
    cleanup_list(node_list, edge_list, face_list) ;
    cleanup_list(bnode_list) ;
    reduce_vector($newCellPlan) ;
  }
}


/// Dummy parameter to trick Loci scheduler
$rule pointwise(priority::restart::balancedCellPlan <- beginWithMarker,
restart_tag_par, cellPlan, balancedCellPlan1, fineCellTag, isIndivisible,
(lower, upper, boundary_map)->(facePlan, balancedFacePlan1, is_quadface),
(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
(lower, upper, boundary_map)->face2edge->edge2node->pos,
(lower, upper, boundary_map)->face2edge->(edgePlan, balancedEdgePlan1)),
constraint(gnrlcells) {

  if(!$isIndivisible) {
    std::list<Node*> node_list ;
    std::list<Edge*> edge_list ;
    std::list<Face*> face_list ;
    std::list<Node*> bnode_list ;

    Cell* aCell = build_resplit_general_cell_ctag($lower.begin(), $lower.size(),
                                                  $upper.begin(), $upper.size(),
                                                  $boundary_map.begin(), $boundary_map.size(),
                                                  $*is_quadface,
                                                  $*face2node,
                                                  $*face2edge,
                                                  $*edge2node,
                                                  $*pos,
                                                  $*edgePlan,
                                                  $*facePlan,
                                                  $*balancedEdgePlan1,
                                                  $*balancedFacePlan1,
                                                  bnode_list,
                                                  node_list,
                                                  edge_list,
                                                  face_list,
                                                  $*fileNumber(pos),
                                                  $cellPlan,
                                                  $fineCellTag);

    std::vector<DiamondCell*> cells ; //leaves collected according to cellPlan1
    aCell->resplit( $balancedCellPlan1, node_list, edge_list, face_list, cells) ;

    // recollect leaves according to tree structure
    std::list<DiamondCell*> leaves ;
    aCell->sort_leaves(leaves) ;

    // first if any cell need derefine
    std::set<DiamondCell*> dparents ;
    bool check_root = false ;

    // mark the cell that will be eliminated
    for(std::list<DiamondCell*>::const_iterator li= leaves.begin(); li != leaves.end(); li++) {
      if((*li)->getTag() ==2) {
        DiamondCell* parent = (*li)->getParentCell() ;
        if(parent==0)check_root = true ;
        if(parent!=0 && parent->needDerefine_ctag()) {
          dparents.insert(parent) ;
        }
      }
    }

    // derefine the cells
    for(std::set<DiamondCell*>::const_iterator si = dparents.begin(); si!= dparents.end(); si++) {
      (*si)->derefine() ;
    }
    if(check_root) {
      if(aCell->needDerefine_ctag()) { aCell->derefine() ; }
    }

    $balancedCellPlan = aCell->make_cellplan() ;

    // clean up
    if(aCell != 0) {
      delete aCell ;
      aCell = 0 ;
    }
    cleanup_list(node_list, edge_list, face_list) ;
    cleanup_list(bnode_list) ;
    reduce_vector($balancedCellPlan) ;
  }
}
