//-----------------------------------------------------------------------------
// General-cell face plans before derefinement
//-----------------------------------------------------------------------------

$rule pointwise(balancedFacePlan1 <- (cl, cr)->balancedCellPlan1, face2node,
(cl, cr)->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
(cl, cr)->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(interior_faces, (cl, cr)->gnrlcells) {
  $balancedFacePlan1.clear() ;

  std::vector<char> facePlanL = extract_general_face($cl->$lower.begin(),
                                                     $cl->$lower.size(),
                                                     $cl->$upper.begin(),
                                                     $cl->$upper.size(),
                                                     $cl->$boundary_map.begin(),
                                                     $cl->$boundary_map.size(),
                                                     $*face2node,
                                                     $*face2edge,
                                                     $*edge2node,
                                                     $cl->$balancedCellPlan1,
                                                     _e_,
                                                     $*fileNumber(pos)) ;

  std::vector<char> facePlanR = extract_general_face($cr->$lower.begin(),
                                                     $cr->$lower.size(),
                                                     $cr->$upper.begin(),
                                                     $cr->$upper.size(),
                                                     $cr->$boundary_map.begin(),
                                                     $cr->$boundary_map.size(),
                                                     $*face2node,
                                                     $*face2edge,
                                                     $*edge2node,
                                                     $cr->$balancedCellPlan1,
                                                     _e_,
                                                     $*fileNumber(pos)) ;

  $balancedFacePlan1 = merge_faceplan(facePlanL, facePlanR, $face2node.size()) ;
  reduce_vector($balancedFacePlan1) ;
}

$rule pointwise(balancedFacePlan1 <- cl->balancedCellPlan1,
cl->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
cl->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(boundary_faces, cl->gnrlcells) {
  $balancedFacePlan1 = extract_general_face($cl->$lower.begin(),
                                           $cl->$lower.size(),
                                           $cl->$upper.begin(),
                                           $cl->$upper.size(),
                                           $cl->$boundary_map.begin(),
                                           $cl->$boundary_map.size(),
                                           $*face2node,
                                           $*face2edge,
                                           $*edge2node,
                                           $cl->$balancedCellPlan1,
                                           _e_,
                                           $*fileNumber(pos)) ;
  reduce_vector($balancedFacePlan1) ;
}


//-----------------------------------------------------------------------------
// Hex-cell face plans before derefinement
//-----------------------------------------------------------------------------

void extract_quad_edge(const std::vector<char>&, std::vector<char>&, unsigned int) ;
std::vector<char> merge_quad_face(std::vector<char>& facePlanL, char orientCodeL) ;
std::vector<char> merge_quad_face(std::vector<char>& facePlanL, char orientCodeL,
                                  std::vector<char>& facePlanR, char orientCodeR) ;
std::vector<char> extract_hex_face(const std::vector<char>& cellPlan, DIRECTION dd) ;


// This rule first extracts faceplan from cl and cr, then merges them into one
// final plan in the face's local coordinates system.
//
// To merge the plans, use a queue of ranges to simulate the tree splitting
// process, and put the inner eges in list xEdge and yEdges according to their
// directions.
//
// Then sort and unique xEdge and yEdge. and then merge all the overlapped
// edges.   
//
// The last step is compose a new refinement plan according to xEdges and
// yEdges. Search the inner edges of a parent cell, the result implies the
// split code. Repeat the same process for each child.

$rule pointwise(balancedFacePlan1 <- (cl, cr)->balancedCellPlan1,
(cl, cr)->hexOrientCode, fl, fr), constraint(interior_faces, (cl, cr)->hexcells) {
  std::vector<char> facePlanL = extract_hex_face($cl->$balancedCellPlan1, DIRECTION($fl)) ;
  std::vector<char> facePlanR = extract_hex_face($cr->$balancedCellPlan1, DIRECTION($fr)) ;
  $balancedFacePlan1 = merge_quad_face(facePlanL, $cl->$hexOrientCode[$fl],
    facePlanR, $cr->$hexOrientCode[$fr]) ;
  reduce_vector($balancedFacePlan1) ;
}

$rule pointwise(balancedFacePlan1 <- cl->balancedCellPlan1, cl->hexOrientCode, fl),
constraint(boundary_faces, cl->hexcells) {
  std::vector<char> facePlanL = extract_hex_face($cl->$balancedCellPlan1, DIRECTION($fl)) ;
  $balancedFacePlan1 = merge_quad_face(facePlanL, $cl->$hexOrientCode[$fl]) ;
  reduce_vector($balancedFacePlan1) ;
}


//-----------------------------------------------------------------------------
// Prism-cell face plans before derefinement
//-----------------------------------------------------------------------------

void extract_prism_face(const std::vector<char>& cellPlan,
  std::vector<char>& facePlan, int dd) ;

std::vector<char> merge_quad_face_p(const std::vector<char>& cellPlan1,
  int dd1, char orientCode1) ;

std::vector<char> merge_quad_face_pp(const  std::vector<char>& cellPlan1,
  int dd1, char orientCode1, const std::vector<char>& cellPlan2,
  int dd2, char orientCode2) ;

std::vector<char> merge_tri_face_p(const std::vector<char>& cellPlan1, int dd1,
  char orientCode1) ;

std::vector<char> merge_tri_face_pp(const std::vector<char>& cellPlan1,
  int dd1, char orientCode1, const std::vector<char>& cellPlan2,
  int dd2, char orientCode2) ;


// This rule first extracts faceplan from cl and cr, then merges them into one
// final plan in the face's local coordinates system.
//
// To merge the plans,  use a queue of ranges to simulate the tree splitting
// process, and put the inner eges in list xEdge and yEdges according to their
// directions.
//
// Then sort and unique xEdge and yEdge. and then merge all the overlapped
// edges.   
//
// The last step is compose a new refinement plan according to xEdges and
// yEdges. Search the inner edges of a parent cell, the result implies the
// split code. Repeat the same process for each child.

$rule pointwise(balancedFacePlan1 <- (cl, cr)->balancedCellPlan1,
(cl, cr)->prismOrientCode, fl, fr), constraint((cl, cr)->prisms) {
  if ($fl < 2) {
    $balancedFacePlan1 = merge_tri_face_pp($cl->$balancedCellPlan1, $fl, $cl->$prismOrientCode[$fl],
      $cr->$balancedCellPlan1, $fr, $cr->$prismOrientCode[$fr]) ;
  }else {
    $balancedFacePlan1 = merge_quad_face_pp($cl->$balancedCellPlan1, $fl, $cl->$prismOrientCode[$fl],
      $cr->$balancedCellPlan1, $fr, $cr->$prismOrientCode[$fr]) ;
  }
  reduce_vector($balancedFacePlan1) ;
}

$rule pointwise(balancedFacePlan1 <- cl->balancedCellPlan1, cl->prismOrientCode, fl),
constraint(boundary_faces, cl->prisms) {
  if ($fl < 2) {
    $balancedFacePlan1 = merge_tri_face_p($cl->$balancedCellPlan1, $fl,
                                          $cl->$prismOrientCode[$fl]) ;
  }else {
    $balancedFacePlan1 = merge_quad_face_p($cl->$balancedCellPlan1, $fl,
                                           $cl->$prismOrientCode[$fl]) ;
  }  
  reduce_vector($balancedFacePlan1) ;
}


//-----------------------------------------------------------------------------
// Mixed-cell face plans before derefinement
//-----------------------------------------------------------------------------

std::vector<char> extract_general_face(const Entity* lower, int lower_size,
                                       const Entity* upper, int upper_size,
                                       const Entity* boundary_map, int boundary_map_size,
                                       const const_multiMap& face2node,
                                       const const_multiMap& face2edge,
                                       const const_MapVec<2>& edge2node,
                                       const std::vector<char>& cellPlan,
                                       Entity ff,
                                       const const_store<int>& node_remap
                                       ) ;

std::vector<char> extract_prism_face(const std::vector<char>& cellPlan, int dd) ;

std::vector<char> merge_tri_face_p(const std::vector<char>& cellPlan1, int dd1, char orientCode1) ;

std::vector<char> extract_hex_face(const std::vector<char>& cellPlan,  DIRECTION dd) ;

std::vector<char> merge_quad_face(std::vector<char>& facePlanL, char orientCodeL) ;

std::vector<char> merge_quad_face(std::vector<char>& facePlanL, char orientCodeL,
                                  std::vector<char>& facePlanR, char orientCodeR) ;

std::vector<char>  merge_tri_face_pp(const std::vector<char>& cellPlan1, int dd1, char orientCode1,
                                     const std::vector<char>& cellPlan2, int dd2, char orientCode2) ;

std::vector<char> merge_faceplan(std::vector<char>& planl, std::vector<char>& planr, int numNodes) ;

std::vector<char> transfer_plan_g2q(std::vector<char>& facePlan) ;


/// Merge derefinement face plans between a general cell on the left and a
/// hexahedral cell on the right.
$rule pointwise(balancedFacePlan1 <- (cl, cr)->balancedCellPlan1,
cr->hexOrientCode, fr,
cl->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
cl->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(cl->gnrlcells, cr->hexcells) {
  $balancedFacePlan1.clear() ;

  std::vector<char> localPlanL = extract_general_face($cl->$lower.begin(),
                                                      $cl->$lower.size(),
                                                      $cl->$upper.begin(),
                                                      $cl->$upper.size(),
                                                      $cl->$boundary_map.begin(),
                                                      $cl->$boundary_map.size(),
                                                      $*face2node,
                                                      $*face2edge,
                                                      $*edge2node,
                                                      $cl->$balancedCellPlan1,
                                                      _e_,
                                                      $*fileNumber(pos)) ;

  std::vector<char> facePlanL = transfer_plan_g2q(localPlanL) ;
  std::vector<char> facePlanR = extract_hex_face($cr->$balancedCellPlan1,
                                                 DIRECTION($fr)) ;

  $balancedFacePlan1 = merge_quad_face(facePlanL, static_cast<char>(0),
                                       facePlanR, $cr->$hexOrientCode[$fr]) ;
  reduce_vector($balancedFacePlan1) ;
}

/// Merge derefinement face plans between a hexahedral cell on the left and a
/// general cell on the right.
$rule pointwise(balancedFacePlan1 <- (cl, cr)->balancedCellPlan1,
cl->hexOrientCode, fl,
cr->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
cr->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(cr->gnrlcells, cl->hexcells) {
  $balancedFacePlan1.clear() ;

  std::vector<char> localPlanR = extract_general_face($cr->$lower.begin(),
                                                      $cr->$lower.size(),
                                                      $cr->$upper.begin(),
                                                      $cr->$upper.size(),
                                                      $cr->$boundary_map.begin(),
                                                      $cr->$boundary_map.size(),
                                                      $*face2node,
                                                      $*face2edge,
                                                      $*edge2node,
                                                      $cr->$balancedCellPlan1,
                                                      _e_,
                                                      $*fileNumber(pos)) ;
  std::vector<char> facePlanR = transfer_plan_g2q(localPlanR) ;
  std::vector<char> facePlanL = extract_hex_face($cl->$balancedCellPlan1,
                                                 DIRECTION($fl)) ;

  $balancedFacePlan1 = merge_quad_face(facePlanR, static_cast<char>(0),
                                       facePlanL, $cl->$hexOrientCode[$fl]) ;
  reduce_vector($balancedFacePlan1) ;
}

/// Merge derefinement face plans between a general cell on the left and a
/// prism cell on the right.
$rule pointwise(balancedFacePlan1 <- (cl, cr)->balancedCellPlan1,
face2node, cr->prismOrientCode, fr,
cl->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
cl->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(cl->gnrlcells, cr->prisms) {
  $balancedFacePlan1.clear() ;

  std::vector<char> localPlanL = extract_general_face($cl->$lower.begin(),
                                                      $cl->$lower.size(),
                                                      $cl->$upper.begin(),
                                                      $cl->$upper.size(),
                                                      $cl->$boundary_map.begin(),
                                                      $cl->$boundary_map.size(),
                                                      $*face2node,
                                                      $*face2edge,
                                                      $*edge2node,
                                                      $cl->$balancedCellPlan1,
                                                      _e_,
                                                      $*fileNumber(pos)) ;

  if ($fr < 2) {
    std::vector<char> facePlanR = merge_tri_face_p($cr->$balancedCellPlan1,
                                                   $fr,
                                                   $cr->$prismOrientCode[$fr]) ;
    $balancedFacePlan1 = merge_faceplan(localPlanL, facePlanR,
                                        $face2node.size()) ;
  }else {
    std::vector<char> facePlanR = extract_prism_face($cr->$balancedCellPlan1,
                                                     $fr) ;
    std::vector<char> facePlanL = transfer_plan_g2q(localPlanL) ;
    $balancedFacePlan1 = merge_quad_face(facePlanL, static_cast<char>(0),
                                         facePlanR,
                                         $cr->$prismOrientCode[$fr]) ;
  }
  reduce_vector($balancedFacePlan1) ;
}

/// Merge derefinement face plans between a prism cell on the left and a
/// general cell on the right.
$rule pointwise(balancedFacePlan1 <- (cl, cr)->balancedCellPlan1,
face2node, cl->prismOrientCode, fl,
cr->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
cr->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(cr->gnrlcells, cl->prisms) {
  $balancedFacePlan1.clear() ;

  std::vector<char> localPlanR = extract_general_face($cr->$lower.begin(),
                                                      $cr->$lower.size(),
                                                      $cr->$upper.begin(),
                                                      $cr->$upper.size(),
                                                      $cr->$boundary_map.begin(),
                                                      $cr->$boundary_map.size(),
                                                      $*face2node,
                                                      $*face2edge,
                                                      $*edge2node,
                                                      $cr->$balancedCellPlan1,
                                                      _e_,
                                                      $*fileNumber(pos)) ;

  if ($fl < 2) {
    std::vector<char> facePlanL = merge_tri_face_p($cl->$balancedCellPlan1,
                                                   $fl,
                                                   $cl->$prismOrientCode[$fl]) ;
    $balancedFacePlan1 = merge_faceplan(facePlanL, localPlanR,
                                        $face2node.size()) ;
  } else {
    std::vector<char> facePlanL = extract_prism_face($cl->$balancedCellPlan1,
                                                     $fl) ;
    std::vector<char> facePlanR = transfer_plan_g2q(localPlanR) ;

    $balancedFacePlan1 = merge_quad_face(facePlanR, static_cast<char>(0),
                                         facePlanL,
                                         $cl->$prismOrientCode[$fl]) ;
  }
  reduce_vector($balancedFacePlan1) ;
}

/// Merge derefinement face plans between a hexahedral cell on the left and a
/// prism cell on the right.
$rule pointwise(balancedFacePlan1 <- (cl, cr)->balancedCellPlan1,
cr->prismOrientCode, cl->hexOrientCode, fl, fr),
constraint(cl->hexcells, cr->prisms) {
  std::vector<char> facePlanL = extract_hex_face($cl->$balancedCellPlan1,
                                                 DIRECTION($fl)) ;
  std::vector<char> facePlanR = extract_prism_face($cr->$balancedCellPlan1,
                                                   $fr) ;
  $balancedFacePlan1 = merge_quad_face(facePlanL, $cl->$hexOrientCode[$fl],
                                       facePlanR, $cr->$prismOrientCode[$fr]) ;
  reduce_vector($balancedFacePlan1) ;
}

/// Merge derefinement face plans between a prism cell on the left and a
/// hexahedral cell on the right.
$rule pointwise(balancedFacePlan1 <- (cl, cr)->balancedCellPlan1,
cl->prismOrientCode, cr->hexOrientCode, fl, fr),
constraint(cr->hexcells, cl->prisms) {
  std::vector<char> facePlanR = extract_hex_face($cr->$balancedCellPlan1,
                                                 DIRECTION($fr)) ;
  std::vector<char> facePlanL = extract_prism_face($cl->$balancedCellPlan1,
                                                   $fl) ;
  $balancedFacePlan1 = merge_quad_face(facePlanL, $cl->$prismOrientCode[$fl],
                                       facePlanR, $cr->$hexOrientCode[$fr]) ;
  reduce_vector($balancedFacePlan1) ;
}


//-----------------------------------------------------------------------------
// Edge plans before derefinement
//-----------------------------------------------------------------------------

/// Intermediate set of integer edge split coordinates implied by balancedFacePlan1.
/// Multiple faces can contribute to the same edge; apply rules merge these sets.
$type balancedPointSet1 store<SetLong> ;

$rule unit(balancedPointSet1), constraint(edge2node->pos){
  $balancedPointSet1 = SetLong() ;
}

$rule apply(face2edge->balancedPointSet1<-balancedFacePlan1, is_quadface,
face2node->pos, face2edge->edge2node->pos, face2edge->balancedPointSet1)[SetLongUnionOp],
constraint(faces) {

  if($is_quadface) {
    if($face2node.size()!=4) {
      cerr << "WARNING: Not a hexcell" << endl ;
      Loci::Abort() ;
    }

    for(int i = 0; i < $face2edge.size(); i++) {
      int64 maxValue = int64(1) << MAXLEVEL;
      std::vector<char> plan ;
      extract_quad_edge($balancedFacePlan1, plan, i) ;
      if(plan.size() == 0) {
        continue ;
      }

      bool needReverse = false ;

      if(i == 0 && $face2edge[0]->$edge2node[0] == $face2node[1]) {
        needReverse = true ;
      }else if(i == 1 &&  $face2edge[1]->$edge2node[0] == $face2node[2]) {
        needReverse = true ;
      }else if(i == 2 && $face2edge[2]->$edge2node[0] == $face2node[2]) {
        needReverse = true ;
      }else if(i == 3 && $face2edge[3]->$edge2node[0] == $face2node[3]) {
        needReverse = true ;
      }

      queue<pair<int64, int64> > Q ;
      char code = plan.front() ;
      unsigned int index = 0 ;
      pair<int64, int64> pRange = make_pair(int64(0), maxValue) ;
      Q.push(pRange) ;

      int64 midP ;

      while(!Q.empty()) {
        // read in a code
        if(index >= plan.size()) {
          code = 0 ;
        }else {
          code = plan[index++] ;
        }

        // read in the range from the queue
        pRange = Q.front() ;

        // process the cell, push children ranges into Q and put the middle
        // point into points.
        switch(code) {
          case 1: {
            midP = (pRange.first + pRange.second) / 2 ;
            Q.push(make_pair(pRange.first, midP)) ;
            Q.push(make_pair(midP, pRange.second)) ;

            SetLong points ;
            if(needReverse) {
              points.aset.insert(maxValue - midP) ;
            }else {
              points.aset.insert(midP) ;
            }
            join($face2edge[i]->$balancedPointSet1, points) ;
            break ;
          }

          case 0:
            break ;

          case 8:
            Q.push(pRange) ;
            break ;

          default :
            cerr << "WARNING: illegal splitCode in rule edge_points_apply" << endl ;
            break ;
        }
        Q.pop() ;
      }
      plan.clear() ;
    }
  }else {

    if($balancedFacePlan1.size() == 0) {
      return ;
    }

    int64 maxValue = int64(1) << MAXLEVEL ;

    // assume $balancedFacePlan1[0] == 1
    int nfnode = $face2node.size() ;
    std::vector<bool> needReverse(nfnode) ;

    for(int i=0; i<nfnode; i++) {
      if($face2edge[i]->$edge2node[0] == $face2node[i] &&
         $face2edge[i]->$edge2node[1] == $face2node[i==(nfnode-1)?0:i+1]) {
        needReverse[i] = false ;
      }else {
        needReverse[i] = true ;
      }
    }

    // first time split face, put all the edgecenter into pointSet

    std::queue<pair<int, TwoEdge> > Q ;
    std::vector<TwoEdge> child(nfnode) ;
    for(int i =0; i< nfnode; i++) {
      if(needReverse[i]) {
        child[i].e0 = make_pair(maxValue, maxValue/2) ;
      }else {
        child[i].e0 = make_pair(int64(0),maxValue/2) ;
      }

      if(needReverse[i==0?nfnode-1:i-1]){
        child[i].e3 = make_pair(maxValue/2, int64(0)) ;
      }else {
        child[i].e3 = make_pair(maxValue/2, maxValue) ;
      }
      Q.push(make_pair(i, child[i])) ;

      SetLong points ;
      points.aset.insert(maxValue/2) ;
      join($face2edge[i]->$balancedPointSet1, points) ;
    }

    TwoEdge current ;
    unsigned  int index = 1 ;
    char mySplitCode ;
    int edgeID ;

    while(!Q.empty()) {
      current = Q.front().second ;
      edgeID = Q.front().first ;
      if(index >= $balancedFacePlan1.size()) {
        mySplitCode = 0 ;
      }else {
        // take a code from splitcode
        mySplitCode = $balancedFacePlan1[index] ;
        index++ ;
      }

      if(mySplitCode == 1) {

        // define new edgeID and push the children into Q
        // put edgecenter into pointSet if necessary
        int newID[4] = {-1,-1,-1,-1} ;

        //define the 4 children
        TwoEdge child[4] ;

        // if edgeID== -1, each newID is -1, no edgecenter need to be put
        // into pointSet
        if(edgeID == -1) {
          for(int i=0; i < 3; i++) {
            newID[i] = -1 ;
          }
        }else if(edgeID >= 0 && edgeID < nfnode){ //if edgeID is in [0, nfnode), edge 0 is on edgeID, edge3 is on edgeID-1
          newID[2] = -1 ;
          newID[0] = edgeID ; //e0 on edgeID, e3 on edgeID-1
          child[0].e0 = make_pair(current.e0.first, (current.e0.first + current.e0.second)/2) ;
          child[0].e3 = make_pair((current.e3.first + current.e3.second)/2, current.e3.second) ;

          newID[1] = 2*nfnode+edgeID ; //e3 on edgId
          child[1].e3 = make_pair((current.e0.first + current.e0.second)/2, current.e0.second) ;

          newID[3] = nfnode +(edgeID==0?nfnode-1:edgeID-1) ; //e0 on edgeId
          child[3].e0 = make_pair(current.e3.first, (current.e3.first + current.e3.second)/2) ;

          SetLong edgePoints ;
          edgePoints.aset.insert((current.e0.first + current.e0.second)/2) ;
          join($face2edge[edgeID]->$balancedPointSet1, edgePoints) ;

          SetLong previousEdgePoints ;
          previousEdgePoints.aset.insert((current.e3.first + current.e3.second)/2) ;
          join($face2edge[edgeID==0?nfnode-1:edgeID-1]->$balancedPointSet1,
               previousEdgePoints) ;

        }else if(edgeID >=nfnode && edgeID <2*nfnode) { //edge 0 on edgeID-nfnode
          newID[2] = newID[3] = -1 ;
          newID[0] = edgeID ; //e0 on edgeId
          child[0].e0 = make_pair(current.e0.first, (current.e0.first + current.e0.second)/2) ;

          newID[1] = nfnode + edgeID ; //e3 on edgeId
          child[1].e3 = make_pair((current.e0.first + current.e0.second)/2, current.e0.second) ;

          SetLong edgePoints ;
          edgePoints.aset.insert((current.e0.first + current.e0.second)/2) ;
          join($face2edge[edgeID-nfnode]->$balancedPointSet1, edgePoints) ;
        }else if(edgeID >= 2*nfnode && edgeID < 3*nfnode) { //edge 3 on edgeID-2*nfnode
          newID[1] = newID[2] = -1 ;
          newID[0] = edgeID ; //e3 on edgeId
          child[0].e3 = make_pair((current.e3.first + current.e3.second)/2, current.e3.second) ;

          newID[3] = edgeID - nfnode ; //e0 on edgeId
          child[3].e0 = make_pair(current.e3.first, (current.e3.first + current.e3.second)/2) ;

          SetLong edgePoints ;
          edgePoints.aset.insert((current.e3.first + current.e3.second)/2) ;
          join($face2edge[edgeID-2*nfnode]->$balancedPointSet1, edgePoints) ;
        }else {
          cerr << " WARNING: illegal edgeID" << endl ;
          Loci::Abort() ;
        }

        for(int i = 0; i < 4; i++) {
          Q.push(make_pair(newID[i],child[i])) ;
        }
      }
      Q.pop() ;
    }
  }
}


$rule pointwise(balancedEdgePlan1<-balancedPointSet1) {
  if($balancedPointSet1.aset.empty()) { return ; }

  // define range of the integer coordinates of the edge
  int64 maxValue = int64(1) << MAXLEVEL ;

  // prepare to make up the refinement plan according to list points
  $balancedEdgePlan1.clear() ;
  queue<pair<int64, int64> > Q ;
  pair<int64,int64>  pRange = make_pair(int64(0), maxValue) ;
  Q.push(pRange) ;
  int64 midP ;

  while(!Q.empty()) {
    // read in the range
    pRange = Q.front() ;

    // define the positions
    midP = (pRange.first + pRange.second) / 2 ;

    // if midP is in pointSet,set the code to 1, else the code is 0
    if($balancedPointSet1.aset.empty()) {
      break ;
    }else {
      std::set<int64>::iterator p = $balancedPointSet1.aset.find(midP) ;
      if(p != $balancedPointSet1.aset.end()) {
        Q.push(make_pair(pRange.first, midP)) ;
        Q.push(make_pair(midP, pRange.second)) ;
        $balancedEdgePlan1.push_back(1) ;
      }
      else{
        $balancedEdgePlan1.push_back(0) ;
      }
    }
    Q.pop();
  }
  while($balancedEdgePlan1.size() != 0 && $balancedEdgePlan1.back() == 0 ) {
    $balancedEdgePlan1.pop_back() ;
  }
  reduce_vector($balancedEdgePlan1) ;
}
