//-----------------------------------------------------------------------------
// General-cell face plans
//-----------------------------------------------------------------------------

$rule pointwise(balancedFacePlan <- (cl, cr)->balancedCellPlan, face2node,
(cl, cr)->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
(cl, cr)->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(interior_faces, (cl, cr)->gnrlcells) {
  $balancedFacePlan.clear() ;

  std::vector<char> facePlanL = extract_general_face($cl->$lower.begin(),
                                                     $cl->$lower.size(),
                                                     $cl->$upper.begin(),
                                                     $cl->$upper.size(),
                                                     $cl->$boundary_map.begin(),
                                                     $cl->$boundary_map.size(),
                                                     $*face2node,
                                                     $*face2edge,
                                                     $*edge2node,
                                                     $cl->$balancedCellPlan,
                                                     _e_,
                                                     $*fileNumber(pos)) ;

  std::vector<char> facePlanR = extract_general_face($cr->$lower.begin(),
                                                     $cr->$lower.size(),
                                                     $cr->$upper.begin(),
                                                     $cr->$upper.size(),
                                                     $cr->$boundary_map.begin(),
                                                     $cr->$boundary_map.size(),
                                                     $*face2node,
                                                     $*face2edge,
                                                     $*edge2node,
                                                     $cr->$balancedCellPlan,
                                                     _e_,
                                                     $*fileNumber(pos)) ;

  $balancedFacePlan = merge_faceplan(facePlanL, facePlanR, $face2node.size()) ;
  reduce_vector($balancedFacePlan) ;
}

$rule pointwise(balancedFacePlan <- cl->balancedCellPlan,
cl->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
cl->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(boundary_faces, cl->gnrlcells) {
  $balancedFacePlan = extract_general_face($cl->$lower.begin(),
                                           $cl->$lower.size(),
                                           $cl->$upper.begin(),
                                           $cl->$upper.size(),
                                           $cl->$boundary_map.begin(),
                                           $cl->$boundary_map.size(),
                                           $*face2node,
                                           $*face2edge,
                                           $*edge2node,
                                           $cl->$balancedCellPlan,
                                           _e_,
                                           $*fileNumber(pos)) ;
  reduce_vector($balancedFacePlan) ;
}


//-----------------------------------------------------------------------------
// Hex-cell face plans
//-----------------------------------------------------------------------------

void extract_quad_edge(const std::vector<char>&, std::vector<char>&, unsigned int) ;
std::vector<char> merge_quad_face(std::vector<char>& facePlanL, char orientCodeL) ;
std::vector<char> merge_quad_face(std::vector<char>& facePlanL, char orientCodeL,
                                  std::vector<char>& facePlanR, char orientCodeR) ;

std::vector<char> extract_hex_face(const std::vector<char>& cellPlan, DIRECTION dd) ;


// This rule first extract faceplan from cl and cr, then merge them into one
// final plan in the face's local coordinates system
//
// To merge the plans, use a queue of ranges to simulate the tree splitting
// process, and put the inner eges in list xEdge and yEdges according to their
// directions.
//
// Then sort and unique xEdge and yEdge. and then merge all the overlapped
// edges.   
//
// The last step is compose a new refinement plan according to xEdges and
// yEdges. Search the inner edges of a parent cell, the result implies the
// split code. repeat the same process for each child.

$rule pointwise(balancedFacePlan <- (cl, cr)->balancedCellPlan,
(cl, cr)->hexOrientCode, fl, fr), constraint(interior_faces, (cl, cr)->hexcells) {
  std::vector<char> facePlanL = extract_hex_face($cl->$balancedCellPlan, DIRECTION($fl)) ;
  std::vector<char> facePlanR = extract_hex_face($cr->$balancedCellPlan, DIRECTION($fr)) ;
  $balancedFacePlan = merge_quad_face(facePlanL, $cl->$hexOrientCode[$fl],
    facePlanR, $cr->$hexOrientCode[$fr]) ;
  reduce_vector($balancedFacePlan) ;
}

$rule pointwise(balancedFacePlan <- cl->balancedCellPlan, cl->hexOrientCode, fl),
constraint(boundary_faces, cl->hexcells) {
  std::vector<char> facePlanL = extract_hex_face($cl->$balancedCellPlan, DIRECTION($fl)) ;
  $balancedFacePlan = merge_quad_face(facePlanL, $cl->$hexOrientCode[$fl]) ;
  reduce_vector($balancedFacePlan) ;
}


//-----------------------------------------------------------------------------
// Prism-cell face plans
//-----------------------------------------------------------------------------

void extract_prism_face(const std::vector<char>& cellPlan, std::vector<char>& facePlan, int dd) ;
std::vector<char> merge_quad_face_p(const std::vector<char>& cellPlan1, int dd1, char orientCode1) ;
std::vector<char> merge_quad_face_pp(const std::vector<char>& cellPlan1, int dd1, char orientCode1,
                                     const std::vector<char>& cellPlan2, int dd2, char orientCode2) ;
std::vector<char> merge_tri_face_p(const std::vector<char>& cellPlan1, int dd1, char orientCode1) ;
std::vector<char> merge_tri_face_pp(const std::vector<char>& cellPlan1, int dd1, char orientCode1,
                                    const std::vector<char>& cellPlan2, int dd2, char orientCode2) ;


// This rule first extracts faceplan from cl and cr, then merges them into one
// final plan in the face's local coordinates system.
//
// To merge the plans, use a queue of ranges to simulate the tree splitting
// process, and put the inner eges in list xEdge and yEdges according to their
// directions.
//
// Then sort and unique xEdge and yEdge. and then merge all the overlapped
// edges.   
//
// The last step is compose a new refinement plan according to xEdges and
// yEdges. Search the inner edges of a parent cell, the result implies the
// split code. Repeat the same process for each child.

$rule pointwise(balancedFacePlan <- (cl, cr)->balancedCellPlan,
(cl, cr)->prismOrientCode, fl, fr), constraint((cl, cr)->prisms) {
  if ($fl < 2) {
    $balancedFacePlan = merge_tri_face_pp($cl->$balancedCellPlan, $fl, $cl->$prismOrientCode[$fl],
      $cr->$balancedCellPlan, $fr, $cr->$prismOrientCode[$fr]) ;
  }else {
    $balancedFacePlan = merge_quad_face_pp($cl->$balancedCellPlan, $fl, $cl->$prismOrientCode[$fl],
      $cr->$balancedCellPlan, $fr, $cr->$prismOrientCode[$fr]) ;
  }
  reduce_vector($balancedFacePlan) ;
}

$rule pointwise(balancedFacePlan <- cl->balancedCellPlan, cl->prismOrientCode, fl),
constraint(boundary_faces, cl->prisms) {
  if ($fl < 2) {
    $balancedFacePlan = merge_tri_face_p($cl->$balancedCellPlan, $fl,
					 $cl->$prismOrientCode[$fl]) ;
  }else {
    $balancedFacePlan = merge_quad_face_p($cl->$balancedCellPlan, $fl,
                                          $cl->$prismOrientCode[$fl]) ;
  }
  reduce_vector($balancedFacePlan) ;
}


//-----------------------------------------------------------------------------
// Mixed-cell face plans
//-----------------------------------------------------------------------------

std::vector<char> extract_general_face(const Entity* lower, int lower_size,
                                       const Entity* upper, int upper_size,
                                       const Entity* boundary_map, int boundary_map_size,
                                       const const_multiMap& face2node,
                                       const const_multiMap& face2edge,
                                       const const_MapVec<2>& edge2node,
                                       const std::vector<char>& cellPlan,
                                       Entity ff,
                                       const const_store<int>& node_remap
                                       ) ;

std::vector<char> extract_prism_face(const std::vector<char>& cellPlan, int dd) ;

std::vector<char> merge_tri_face_p(const std::vector<char>& cellPlan1, int dd1,
                                   char orientCode1) ;

std::vector<char> extract_hex_face(const std::vector<char>& cellPlan, DIRECTION dd) ;

std::vector<char> merge_quad_face(std::vector<char>& facePlanL, char orientCodeL) ;

std::vector<char> merge_quad_face(std::vector<char>& facePlanL, char orientCodeL,
                                  std::vector<char>& facePlanR, char orientCodeR) ;

std::vector<char> merge_tri_face_pp(const std::vector<char>& cellPlan1,
                                    int dd1, char orientCode1,
                                    const std::vector<char>& cellPlan2,
                                    int dd2, char orientCode2) ;

std::vector<char> merge_faceplan(std::vector<char>& planl,
                                 std::vector<char>& planr, int numNodes) ;

std::vector<char> transfer_plan_g2q(std::vector<char>& facePlan) ;


$rule pointwise(balancedFacePlan <- (cl, cr)->balancedCellPlan, cr->hexOrientCode, fr,
cl->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)), 
cl->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(cl->gnrlcells, cr->hexcells) {
  $balancedFacePlan.clear() ;
  std::vector<char> localPlanL = extract_general_face(
    $cl->$lower.begin(), $*lower.num_elems($cl),
    $cl->$upper.begin(), $*upper.num_elems($cl),
    $cl->$boundary_map.begin(), $*boundary_map.num_elems($cl),
    $*face2node, $*face2edge, $*edge2node, $cl->$balancedCellPlan, _e_,
    $*fileNumber(pos)) ;
  std::vector<char> facePlanL = transfer_plan_g2q(localPlanL) ;
  std::vector<char> facePlanR = extract_hex_face($cr->$balancedCellPlan, DIRECTION($fr)) ;
  $balancedFacePlan = merge_quad_face(facePlanL, static_cast<char>(0), facePlanR,
                                      $cr->$hexOrientCode[$fr]);
  reduce_vector($balancedFacePlan) ;
}

$rule pointwise(balancedFacePlan <- (cl, cr)->balancedCellPlan, cl->hexOrientCode, fl,
cr->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)), 
cr->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(cr->gnrlcells, cl->hexcells) {
  $balancedFacePlan.clear() ;
  std::vector<char> localPlanR = extract_general_face(
    $cr->$lower.begin(), $*lower.num_elems($cr),
    $cr->$upper.begin(), $*upper.num_elems($cr),
    $cr->$boundary_map.begin(), $*boundary_map.num_elems($cr),
    $*face2node, $*face2edge, $*edge2node, $cr->$balancedCellPlan, _e_,
    $*fileNumber(pos)) ;
  std::vector<char> facePlanR = transfer_plan_g2q(localPlanR) ;
  std::vector<char> facePlanL = extract_hex_face($cl->$balancedCellPlan, DIRECTION($fl)) ;
  $balancedFacePlan = merge_quad_face(facePlanR, static_cast<char>(0), facePlanL,
                                      $cl->$hexOrientCode[$fl]);
  reduce_vector($balancedFacePlan) ;
}

$rule pointwise(balancedFacePlan <- (cl, cr)->balancedCellPlan, cr->prismOrientCode, fr,
cl->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)), 
cl->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(cl->gnrlcells, cr->prisms) {
  $balancedFacePlan.clear() ;
  std::vector<char> localPlanL = extract_general_face(
    $cl->$lower.begin(), $*lower.num_elems($cl),
    $cl->$upper.begin(), $*upper.num_elems($cl),
    $cl->$boundary_map.begin(), $*boundary_map.num_elems($cl),
    $*face2node, $*face2edge, $*edge2node, $cl->$balancedCellPlan, _e_,
    $*fileNumber(pos)) ;

  if($fr < 2) {
    std::vector<char> facePlanR = merge_tri_face_p($cr->$balancedCellPlan, $fr,
                                                   $cr->$prismOrientCode[$fr]) ;
    $balancedFacePlan = merge_faceplan(localPlanL, facePlanR,
                                       $*face2node.num_elems(_e_)) ;
  }else {
    std::vector<char> facePlanR = extract_prism_face($cr->$balancedCellPlan, $fr) ;
    std::vector<char> facePlanL = transfer_plan_g2q(localPlanL) ;
    $balancedFacePlan = merge_quad_face(facePlanL, static_cast<char>(0), facePlanR,
                                        $cr->$prismOrientCode[$fr]);
  }
  reduce_vector($balancedFacePlan) ;
}

$rule pointwise(balancedFacePlan <- (cl, cr)->balancedCellPlan, cl->prismOrientCode, fl,
cr->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)), 
cr->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(cr->gnrlcells, cl->prisms) {
  $balancedFacePlan.clear();
  std::vector<char> localPlanR = extract_general_face(
    $cr->$lower.begin(), $*lower.num_elems($cr),
    $cr->$upper.begin(), $*upper.num_elems($cr),
    $cr->$boundary_map.begin(), $*boundary_map.num_elems($cr),
    $*face2node, $*face2edge, $*edge2node, $cr->$balancedCellPlan, _e_,
    $*fileNumber(pos)) ;

  if($fl < 2) {
    std::vector<char> facePlanL = merge_tri_face_p($cl->$balancedCellPlan, $fl,
                                                   $cl->$prismOrientCode[$fl]) ;
    $balancedFacePlan = merge_faceplan(facePlanL, localPlanR, $*face2node.num_elems(_e_)) ;
  }else {
    std::vector<char> facePlanL = extract_prism_face($cl->$balancedCellPlan, $fl) ;
    std::vector<char> facePlanR = transfer_plan_g2q(localPlanR) ;
    $balancedFacePlan = merge_quad_face(facePlanR, static_cast<char>(0), facePlanL,
                                        $cl->$prismOrientCode[$fl]);
  }
  reduce_vector($balancedFacePlan) ;
}

$rule pointwise(balancedFacePlan <- (cl, cr)->balancedCellPlan, cr->prismOrientCode,
cl->hexOrientCode, fl, fr), constraint(cl->hexcells, cr->prisms) {
  std::vector<char> facePlanL = extract_hex_face($cl->$balancedCellPlan, DIRECTION($fl)) ;
  std::vector<char> facePlanR = extract_prism_face($cr->$balancedCellPlan, $fr) ;
  $balancedFacePlan = merge_quad_face(facePlanL, $cl->$hexOrientCode[$fl], facePlanR,
                                      $cr->$prismOrientCode[$fr]);
  reduce_vector($balancedFacePlan) ;
}

$rule pointwise(balancedFacePlan <- (cl, cr)->balancedCellPlan, cl->prismOrientCode,
cr->hexOrientCode, fl, fr), constraint(cr->hexcells, cl->prisms) {
  std::vector<char> facePlanR = extract_hex_face($cr->$balancedCellPlan, DIRECTION($fr)) ;
  std::vector<char> facePlanL = extract_prism_face($cl->$balancedCellPlan, $fl) ;
  $balancedFacePlan = merge_quad_face(facePlanL, $cl->$prismOrientCode[$fl], facePlanR,
                                      $cr->$hexOrientCode[$fr]);
  reduce_vector($balancedFacePlan) ;
}


//-----------------------------------------------------------------------------
// Edge plans
//-----------------------------------------------------------------------------

// Intermediate set of integer edge split coordinates implied by balancedFacePlan.
// Multiple faces can contribute to the same edge; apply rules merge these sets.
$type balancedPointSet store<SetLong> ;

$rule unit(balancedPointSet), constraint(edge2node->pos) {
  $balancedPointSet = SetLong() ;
}

$rule apply(face2edge->balancedPointSet<-balancedFacePlan, is_quadface,
face2node->pos,face2edge->edge2node->pos, face2edge->balancedPointSet)[SetLongUnionOp],
constraint(faces) {
  if($is_quadface && $face2node.size() != 4) {
    cerr << "WARNING: quadrilateral face must have four nodes" << endl ;
    Loci::Abort() ;
  }

  if($balancedFacePlan.size() == 0) { return ; }

  const int edgeCount = $is_quadface ? $face2edge.size() : $face2node.size() ;
  std::vector<bool> edgeReversed(edgeCount, false) ;

  if($is_quadface) {
    for(int i=0; i<edgeCount; i++) {
      if(i == 0 && $face2edge[0]->$edge2node[0] == $face2node[1]) {
        edgeReversed[i] = true ;
      }else if(i == 1 && $face2edge[1]->$edge2node[0] == $face2node[2]) {
        edgeReversed[i] = true ;
      }else if(i == 2 && $face2edge[2]->$edge2node[0] == $face2node[2]) {
        edgeReversed[i] = true ;
      }else if(i == 3 && $face2edge[3]->$edge2node[0] == $face2node[3]) {
        edgeReversed[i] = true ;
      }
    }
  }else {
    for(int i=0; i<edgeCount; i++) {
      edgeReversed[i] =
        !($face2edge[i]->$edge2node[0] == $face2node[i] &&
          $face2edge[i]->$edge2node[1] ==
            $face2node[i==(edgeCount-1)?0:i+1]) ;
    }
  }

  const std::vector<SetLong> edgeSplits =
    face_edge_splits($balancedFacePlan, $is_quadface, edgeReversed) ;
  for(int i=0; i<edgeCount; i++) {
    if(edgeSplits[i].aset.empty()) { continue ; }
    join($face2edge[i]->$balancedPointSet, edgeSplits[i]) ;
  }
}

$rule pointwise(balancedEdgePlan<-balancedPointSet) {
  if($balancedPointSet.aset.empty()) { return ; }
  encode_edge_plan($balancedPointSet, $balancedEdgePlan) ;
}
