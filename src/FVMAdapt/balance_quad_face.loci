#include <queue>
#include <vector>
#include <utility>
#include <list>
#include <bitset>
#include "hex_defines.h"
#include <Loci.h>

using std::list ;
using std::queue ;
using std::bitset ;
using std::cerr ;
using std::endl ;
using std::cout ;

$include "FVM.lh"
$include "fvmadapt_internal.lh"

void extract_quad_edge(const std::vector<char>&, std::vector<char>&, unsigned int);
std::vector<char> merge_quad_face(std::vector<char>& facePlanL, char orientCodeL);
std::vector<char> merge_quad_face(std::vector<char>& facePlanL, char orientCodeL,
                                  std::vector<char>& facePlanR, char orientCodeR);

std::vector<char>  extract_hex_face(const  std::vector<char>& cellPlan,  DIRECTION dd);

/// This rule first extracts faceplan from cl and cr, then merge them into one final plan
/// in the face's local coordinates system
///
/// To merge the plans,  use a queue of ranges to simulate the tree splitting
/// process, and put the inner eges in list xEdge and yEdges according to their directions.
///
/// Then sort and unique xEdge and yEdge. and then merge all the overlapped edges
///
/// The last step is compose a new refinement plan according to xEdges and yEdges. Search
/// the inner edges of a parent cell, the result implies the split code. repeat the same process for
/// each child.

/// Merge refinement face plans from the hexahedral cells adjacent to
/// an interior face.
$rule pointwise(balancedFacePlan <- (cl, cr)->balancedCellPlan,
(cl, cr)->hexOrientCode, fl, fr),
constraint(interior_faces, (cl, cr)->hexcells) {
  std::vector<char> facePlanL = extract_hex_face($cl->$balancedCellPlan,
                                                 DIRECTION($fl)) ;
  std::vector<char> facePlanR = extract_hex_face($cr->$balancedCellPlan,
                                                 DIRECTION($fr)) ;
  $balancedFacePlan = merge_quad_face(facePlanL, $cl->$hexOrientCode[$fl],
                                       facePlanR, $cr->$hexOrientCode[$fr]) ;
  reduce_vector($balancedFacePlan) ;
}

/// Extract the refinement face plan from the hexahedral cell adjacent to a
/// boundary face.
$rule pointwise(balancedFacePlan <- cl->balancedCellPlan,
cl->hexOrientCode, fl),
constraint(boundary_faces, cl->hexcells) {
  std::vector<char> facePlanL = extract_hex_face($cl->$balancedCellPlan,
                                                 DIRECTION($fl)) ;
  $balancedFacePlan = merge_quad_face(facePlanL,
                                       $cl->$hexOrientCode[$fl]) ;
  reduce_vector($balancedFacePlan) ;
}
