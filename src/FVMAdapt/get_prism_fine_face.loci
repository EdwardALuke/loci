#include <iostream>
#include <vector>
#include <Loci.h>
#include <Tools/tools.h>
#include "prism.h"

#include "face_output.h"

$include "FVM.lh"
$include "fvmadapt_internal.lh"

// by: Qiuhan Xue
// This file generate  fine_faces according refinement plans. The
// original grid is prism element. Anisotropic refinement is used. the rules should be
// used After node_offset and cell_offset has been set up.
// FineFaces is defined as c1, c2,followed by face2node.

/// Get fine_faces of prism cells
$rule pointwise(fine_faces_cell <-
balancedCellPlan, balanced_node_offset,
balanced_cell_offset, (prism2face, prism2node, prismOrientCode),
(lower, upper, boundary_map)->(balancedFacePlan, balanced_node_offset),
(lower, upper, boundary_map)->face2edge->(balancedEdgePlan,balanced_node_offset),
(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
(lower, upper, boundary_map)->face2edge->edge2node->(pos, fileNumber(pos)),
(lower, upper, boundary_map)->fileNumber(face2node)),
constraint(faceHistoryDisabled, prisms) {
  Loci::FaceOutput output($fine_faces_cell) ;
  if($balancedCellPlan.size() == 0) {
    return ;
  }

  std::list<Node*> bnode_list ; // boundary node
  std::list<Edge*> edge_list ;
  std::list<QuadFace*> qface_list ;
  std::list<Face*> gface_list ;
  std::list<Node*> node_list ; // inner node

  // build a Cell
  Prism* aCell = build_prism_cell($lower.begin(), $lower.size(),
    $upper.begin(), $upper.size(), $boundary_map.begin(), $boundary_map.size(),
    $prism2face, $prism2node, $prismOrientCode, $*face2node,
    $*face2edge, $*edge2node, $*pos, $*balancedEdgePlan,
    $*balancedFacePlan, $*balanced_node_offset, $*fileNumber(face2node),
    $*fileNumber(pos), bnode_list, edge_list, qface_list, gface_list) ;

  Loci::make_prism_cell_faces(aCell, $balancedCellPlan, $balanced_node_offset,
    $balanced_cell_offset, node_list, edge_list, qface_list, gface_list, output) ;

  // clean up
  if(aCell != 0) {
    delete aCell ;
    aCell = 0 ;
  }

  // Delete the separately owned nodes, edges, and faces.
  cleanup_list(bnode_list, edge_list, qface_list) ;
  cleanup_list(gface_list) ;
  cleanup_list(node_list) ;
}

/// Record refinement patches with the generated faces.
$rule pointwise(fine_faces_cell, fine_face_patches_cell <-
recordFaceHistory, fileNumber(geom_cells), planCellFileOffset,
balancedCellPlan, balanced_node_offset,
balanced_cell_offset, (prism2face, prism2node, prismOrientCode),
(lower, upper, boundary_map)->(balancedFacePlan, balanced_node_offset),
(lower, upper, boundary_map)->face2edge->(balancedEdgePlan,balanced_node_offset),
(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
(lower, upper, boundary_map)->face2edge->edge2node->(pos, fileNumber(pos)),
(lower, upper, boundary_map)->fileNumber(face2node)),
constraint(faceHistoryEnabled, prisms) {
  Loci::FaceOutput output($fine_faces_cell, $fine_face_patches_cell,
    $fileNumber(geom_cells)+$planCellFileOffset) ;
  if($balancedCellPlan.size() == 0) {
    return ;
  }

  std::list<Node*> bnode_list ; // boundary node
  std::list<Edge*> edge_list ;
  std::list<QuadFace*> qface_list ;
  std::list<Face*> gface_list ;
  std::list<Node*> node_list ; // inner node

  // build a Cell
  Prism* aCell = build_prism_cell($lower.begin(), $lower.size(),
    $upper.begin(), $upper.size(), $boundary_map.begin(), $boundary_map.size(),
    $prism2face, $prism2node, $prismOrientCode, $*face2node,
    $*face2edge, $*edge2node, $*pos, $*balancedEdgePlan,
    $*balancedFacePlan, $*balanced_node_offset, $*fileNumber(face2node),
    $*fileNumber(pos), bnode_list, edge_list, qface_list, gface_list) ;

  Loci::make_prism_cell_faces(aCell, $balancedCellPlan, $balanced_node_offset,
    $balanced_cell_offset, node_list, edge_list, qface_list, gface_list, output) ;

  // clean up
  if(aCell != 0) {
    delete aCell ;
    aCell = 0 ;
  }

  // Delete the separately owned nodes, edges, and faces.
  cleanup_list(bnode_list, edge_list, qface_list) ;
  cleanup_list(gface_list) ;
  cleanup_list(node_list) ;
}

/// Get fine_faces of interior faces
$rule pointwise(fine_faces <-
balancedFacePlan, balanced_node_offset,
face2edge->(balancedEdgePlan, balanced_node_offset),
(cl, cr)->(balancedCellPlan, balanced_cell_offset, prism2node, prism2face, prismOrientCode),
(fl, fr), (cl, cr)->(upper, lower, boundary_map)->face2node->pos,
(cl, cr)->(upper, lower, boundary_map)-> face2edge->edge2node->pos,
face2node->(pos, fileNumber(pos))), constraint(faceHistoryDisabled, (cl, cr)->prisms) {
  Loci::FaceOutput output($fine_faces) ;
  std::list<Node*> bnode_list, node_list ;
  std::list<Edge*> edge_list ;
  QuadFace* aqFace = 0 ;
  Face* agFace = 0 ;
  std::vector<QuadFace*> fine_qfaces ;
  std::vector<Face*> fine_gfaces ;
  if($face2node.size() == 4) {
    aqFace = build_quad_face($face2node.begin(), $face2edge.begin(),
      $*edge2node, $*pos, $*balancedEdgePlan, $*balanced_node_offset,
      $*fileNumber(pos), bnode_list, edge_list) ;
    fine_qfaces = output.split(aqFace, $balancedFacePlan, $balanced_node_offset,
      node_list, edge_list) ;
  }else {
    agFace = build_general_face($face2node.begin(),$face2node.size(),
      $face2edge.begin(), $*edge2node, $*pos, $*balanced_node_offset,
      $*balancedEdgePlan, bnode_list, edge_list, $*fileNumber(pos)) ;
    fine_gfaces = output.split(agFace, $balancedFacePlan, $balanced_node_offset,
      node_list, edge_list) ;
  }

  std::vector<int32> CL(1,1) ;
  if(!$balancedFacePlan.empty() || $face2node.size() != 4) {
    CL = get_c1_prism($cl->$balancedCellPlan, $balancedFacePlan,
      $cl->$prismOrientCode[$fl], $fl) ;
  }
  std::vector<int32> CR(1,1) ;
  if(!$balancedFacePlan.empty() || $face2node.size() != 4) {
    CR = get_c1_prism($cr->$balancedCellPlan, $balancedFacePlan,
      $cr->$prismOrientCode[$fr], $fr) ;
  }
  if($face2node.size() == 4) {
    output.append(fine_qfaces, CL, $cl->$balancedCellPlan, $cl->$balanced_cell_offset,
      CR, $cr->$balancedCellPlan, $cr->$balanced_cell_offset) ;
  }else {
    output.append(fine_gfaces, CL, $cl->$balancedCellPlan, $cl->$balanced_cell_offset,
      CR, $cr->$balancedCellPlan, $cr->$balanced_cell_offset) ;
  }

  // Clean up the face tree and its nodes and edges.
  delete aqFace ;
  delete agFace ;
  cleanup_list(node_list) ;
  cleanup_list(bnode_list, edge_list) ;
}

/// Record refinement patches with the generated faces.
$rule pointwise(fine_faces, fine_face_patches <-
recordFaceHistory, planFaceFileNumber,
balancedFacePlan, balanced_node_offset,
face2edge->(balancedEdgePlan, balanced_node_offset),
(cl, cr)->(balancedCellPlan, balanced_cell_offset, prism2node, prism2face, prismOrientCode),
(fl, fr), (cl, cr)->(upper, lower, boundary_map)->face2node->pos,
(cl, cr)->(upper, lower, boundary_map)-> face2edge->edge2node->pos,
face2node->(pos, fileNumber(pos))), constraint(faceHistoryEnabled, (cl, cr)->prisms) {
  Loci::FaceOutput output($fine_faces, $fine_face_patches, $planFaceFileNumber) ;
  std::list<Node*> bnode_list, node_list ;
  std::list<Edge*> edge_list ;
  QuadFace* aqFace = 0 ;
  Face* agFace = 0 ;
  std::vector<QuadFace*> fine_qfaces ;
  std::vector<Face*> fine_gfaces ;
  if($face2node.size() == 4) {
    aqFace = build_quad_face($face2node.begin(), $face2edge.begin(),
      $*edge2node, $*pos, $*balancedEdgePlan, $*balanced_node_offset,
      $*fileNumber(pos), bnode_list, edge_list) ;
    fine_qfaces = output.split(aqFace, $balancedFacePlan, $balanced_node_offset,
      node_list, edge_list) ;
  }else {
    agFace = build_general_face($face2node.begin(),$face2node.size(),
      $face2edge.begin(), $*edge2node, $*pos, $*balanced_node_offset,
      $*balancedEdgePlan, bnode_list, edge_list, $*fileNumber(pos)) ;
    fine_gfaces = output.split(agFace, $balancedFacePlan, $balanced_node_offset,
      node_list, edge_list) ;
  }

  std::vector<int32> CL(1,1) ;
  if(!$balancedFacePlan.empty() || $face2node.size() != 4) {
    CL = get_c1_prism($cl->$balancedCellPlan, $balancedFacePlan,
      $cl->$prismOrientCode[$fl], $fl) ;
  }
  std::vector<int32> CR(1,1) ;
  if(!$balancedFacePlan.empty() || $face2node.size() != 4) {
    CR = get_c1_prism($cr->$balancedCellPlan, $balancedFacePlan,
      $cr->$prismOrientCode[$fr], $fr) ;
  }
  if($face2node.size() == 4) {
    output.append(fine_qfaces, CL, $cl->$balancedCellPlan, $cl->$balanced_cell_offset,
      CR, $cr->$balancedCellPlan, $cr->$balanced_cell_offset) ;
  }else {
    output.append(fine_gfaces, CL, $cl->$balancedCellPlan, $cl->$balanced_cell_offset,
      CR, $cr->$balancedCellPlan, $cr->$balanced_cell_offset) ;
  }

  // Clean up the face tree and its nodes and edges.
  delete aqFace ;
  delete agFace ;
  cleanup_list(node_list) ;
  cleanup_list(bnode_list, edge_list) ;
}

/// Get fine_faces of boundary faces
$rule pointwise(fine_faces <-
balancedFacePlan, balanced_node_offset,
face2edge->(balancedEdgePlan, balanced_node_offset),
cl->(balancedCellPlan, balanced_cell_offset, prism2face, prism2node, prismOrientCode),
fl, cl->(upper, lower, boundary_map)->face2node->pos,
cl->(upper, lower, boundary_map)-> face2edge->edge2node->pos,
face2node->(pos, fileNumber(pos)), ref->boundary_tags),
constraint(faceHistoryDisabled, cl->prisms, boundary_faces) {
  Loci::FaceOutput output($fine_faces) ;
  std::list<Node*> bnode_list, node_list ;
  std::list<Edge*> edge_list ;
  QuadFace* aqFace = 0 ;
  Face* agFace = 0 ;
  std::vector<QuadFace*> fine_qfaces ;
  std::vector<Face*> fine_gfaces ;
  if($face2node.size() == 4) {
    aqFace = build_quad_face($face2node.begin(), $face2edge.begin(),
      $*edge2node, $*pos, $*balancedEdgePlan, $*balanced_node_offset,
      $*fileNumber(pos), bnode_list, edge_list) ;
    fine_qfaces = output.split(aqFace, $balancedFacePlan, $balanced_node_offset,
      node_list, edge_list) ;
  }else {
    agFace = build_general_face($face2node.begin(),$face2node.size(),
      $face2edge.begin(), $*edge2node, $*pos, $*balanced_node_offset,
      $*balancedEdgePlan, bnode_list, edge_list, $*fileNumber(pos)) ;
    fine_gfaces = output.split(agFace, $balancedFacePlan, $balanced_node_offset,
      node_list, edge_list) ;
  }

  std::vector<int32> CL(1,1) ;
  if(!$balancedFacePlan.empty() || $face2node.size() != 4) {
    CL = get_c1_prism($cl->$balancedCellPlan, $balancedFacePlan,
      $cl->$prismOrientCode[$fl], $fl) ;
  }
  int boundary = -atoi(&($ref->$boundary_tags[3])) ;
  if($face2node.size() == 4) {
    output.append(fine_qfaces, CL, $cl->$balancedCellPlan, $cl->$balanced_cell_offset, boundary) ;
  }else {
    output.append(fine_gfaces, CL, $cl->$balancedCellPlan, $cl->$balanced_cell_offset, boundary) ;
  }

  // Clean up the face tree and its nodes and edges.
  delete aqFace ;
  delete agFace ;
  cleanup_list(node_list) ;
  cleanup_list(bnode_list, edge_list) ;
}

/// Record refinement patches with the generated faces.
$rule pointwise(fine_faces, fine_face_patches <-
recordFaceHistory, planFaceFileNumber,
balancedFacePlan, balanced_node_offset,
face2edge->(balancedEdgePlan, balanced_node_offset),
cl->(balancedCellPlan, balanced_cell_offset, prism2face, prism2node, prismOrientCode),
fl, cl->(upper, lower, boundary_map)->face2node->pos,
cl->(upper, lower, boundary_map)-> face2edge->edge2node->pos,
face2node->(pos, fileNumber(pos)), ref->boundary_tags),
constraint(faceHistoryEnabled, cl->prisms, boundary_faces) {
  Loci::FaceOutput output($fine_faces, $fine_face_patches, $planFaceFileNumber) ;
  std::list<Node*> bnode_list, node_list ;
  std::list<Edge*> edge_list ;
  QuadFace* aqFace = 0 ;
  Face* agFace = 0 ;
  std::vector<QuadFace*> fine_qfaces ;
  std::vector<Face*> fine_gfaces ;
  if($face2node.size() == 4) {
    aqFace = build_quad_face($face2node.begin(), $face2edge.begin(),
      $*edge2node, $*pos, $*balancedEdgePlan, $*balanced_node_offset,
      $*fileNumber(pos), bnode_list, edge_list) ;
    fine_qfaces = output.split(aqFace, $balancedFacePlan, $balanced_node_offset,
      node_list, edge_list) ;
  }else {
    agFace = build_general_face($face2node.begin(),$face2node.size(),
      $face2edge.begin(), $*edge2node, $*pos, $*balanced_node_offset,
      $*balancedEdgePlan, bnode_list, edge_list, $*fileNumber(pos)) ;
    fine_gfaces = output.split(agFace, $balancedFacePlan, $balanced_node_offset,
      node_list, edge_list) ;
  }

  std::vector<int32> CL(1,1) ;
  if(!$balancedFacePlan.empty() || $face2node.size() != 4) {
    CL = get_c1_prism($cl->$balancedCellPlan, $balancedFacePlan,
      $cl->$prismOrientCode[$fl], $fl) ;
  }
  int boundary = -atoi(&($ref->$boundary_tags[3])) ;
  if($face2node.size() == 4) {
    output.append(fine_qfaces, CL, $cl->$balancedCellPlan, $cl->$balanced_cell_offset, boundary) ;
  }else {
    output.append(fine_gfaces, CL, $cl->$balancedCellPlan, $cl->$balanced_cell_offset, boundary) ;
  }

  // Clean up the face tree and its nodes and edges.
  delete aqFace ;
  delete agFace ;
  cleanup_list(node_list) ;
  cleanup_list(bnode_list, edge_list) ;
}
