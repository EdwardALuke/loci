// Internal fact types shared by FVMAdapt rules.

$include "FVMAdapt/fvmadapt.lh"

/// Final leaf depths for each original cell, in fine-cell index order.
$type fineCellDepth store<std::vector<int> > ;

/// Last adaptation's result for each leaf, in fine-cell index order.
$type fineCellChange store<std::vector<int> > ;

/// Final leaf edge lengths for each original cell, in fine-cell index order.
$type fineMaxEdgeLength store<std::vector<double> > ;
$type fineMaxEdgeLengthXY store<std::vector<double> > ;

/// Base-mesh file number of each original cell.
$type planRootFileNumber store<int> ;
$type firstGeomCellFileNumber param<int> ;

// Mesh domains

/// Mesh faces used by FVMAdapt edge/face balancing rules.
$type faces Constraint ;

/// All non-boundary faces.
$type interior_faces Constraint ;

// Mesh connectivity

/// Mapping from face to edges that bound the face.
$type face2edge multiMap ;

/// Mapping from edge to its two endpoint nodes.
$type edge2node MapVec<2> ;

// Refinement requests

/// Adaptation requests for original nodes and refinement-created nodes.
$type posTag store<char> ;
$type nodeTag store<std::vector<char> > ;

/// Adaptation requests for original cells and current leaf cells.
$type cellTag store<char> ;
$type fineCellTag store<std::vector<char> > ;

// Refined-mesh numbering

/// Numbers of nodes and faces in the original mesh.
$type num_original_nodes param<int> ;
$type num_original_faces param<int> ;

/// Numbers of refinement-created nodes before and after plan balancing.
$type num_inner_nodes store<int> ;
$type balanced_num_inner_nodes store<int> ;

/// Numbers of leaf cells in the input, accepted output and donor histories.
$type num_fine_cells store<int> ;
$type balanced_num_fine_cells store<int> ;
$type parent_num_fine_cells store<int> ;

/// Offsets used to number nodes and cells in the accepted mesh.
$type balanced_node_offset store<int> ;
$type balanced_cell_offset store<int> ;

/// One-based (new leaf, old leaf) donor pairs within each original cell.
$type indexMap store<std::vector<std::pair<int32, int32> > > ;

// Generated refined mesh

/// Coordinates of nodes created inside original cells, faces, and edges.
$type inner_nodes_cell store<Loci::FineNodes> ;
$type inner_nodes_face store<Loci::FineNodes> ;
$type inner_nodes_edge store<Loci::FineNodes> ;

/// Fine faces created inside refined cells and from original mesh faces.
$type fine_faces_cell store<Loci::FineFaces> ;
$type fine_faces store<Loci::FineFaces> ;

/// Enable face correspondence for the accepted mesh.
$type recordFaceHistory param<bool> ;
$type faceHistoryEnabled Constraint ;
#include <FVMAdapt/face_history_internal.h>
/// Optional face patches in the same order as the generated faces.
$type fine_face_patches store<Loci::FacePatches> ;
$type fine_face_patches_cell store<Loci::FacePatches> ;
