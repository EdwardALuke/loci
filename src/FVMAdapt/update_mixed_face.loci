#include <queue>
#include <vector>
#include <utility>

#include <Loci.h>
#include "hex_defines.h"
#include "plan_operations.h"
#include "defines.h"
#include "face.h"
$include "FVM.lh"
$include "fvmadapt_internal.lh"


using std::vector ;
using std::queue ;
using std::cerr ;
using std::endl ;
using std::cout ;

/// Dummy
$rule pointwise(tmpFacePlan <- (cl, cr)->tmpCellPlan,
cr->hexOrientCode, fr,
cl->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
cl->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(cl->gnrlcells, cr->hexcells) {
  $tmpFacePlan.clear() ;

  std::vector<char> localPlanL = extract_general_face($cl->$lower.begin(),
                                                      $cl->$lower.size(),
                                                      $cl->$upper.begin(),
                                                      $cl->$upper.size(),
                                                      $cl->$boundary_map.begin(),
                                                      $cl->$boundary_map.size(),
                                                      $*face2node,
                                                      $*face2edge,
                                                      $*edge2node,
                                                      $cl->$tmpCellPlan,
                                                      _e_,
                                                      $*fileNumber(pos)) ;

  std::vector<char> facePlanL = transfer_plan_g2q(localPlanL) ;
  std::vector<char> facePlanR = extract_hex_face($cr->$tmpCellPlan,
                                                 DIRECTION($fr)) ;

  $tmpFacePlan = merge_quad_face(facePlanL, char(0),
                                 facePlanR, $cr->$hexOrientCode[$fr]) ;
  reduce_vector($tmpFacePlan) ;
}


/// Dummy
$rule pointwise(tmpFacePlan <- (cl, cr)->tmpCellPlan,
cl->hexOrientCode, fl,
cr->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
cr->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(cr->gnrlcells, cl->hexcells) {
  $tmpFacePlan.clear() ;

  std::vector<char> localPlanR = extract_general_face($cr->$lower.begin(),
                                                      $cr->$lower.size(),
                                                      $cr->$upper.begin(),
                                                      $cr->$upper.size(),
                                                      $cr->$boundary_map.begin(),
                                                      $cr->$boundary_map.size(),
                                                      $*face2node,
                                                      $*face2edge,
                                                      $*edge2node,
                                                      $cr->$tmpCellPlan,
                                                      _e_,
                                                      $*fileNumber(pos)) ;
  std::vector<char> facePlanR = transfer_plan_g2q(localPlanR) ;
  std::vector<char> facePlanL = extract_hex_face($cl->$tmpCellPlan,
                                                 DIRECTION($fl)) ;

  $tmpFacePlan = merge_quad_face(facePlanR, char(0),
                                 facePlanL, $cl->$hexOrientCode[$fl]) ;
  reduce_vector($tmpFacePlan) ;
}


/// Dummy
$rule pointwise(tmpFacePlan <- (cl, cr)->tmpCellPlan,
face2node, cr->prismOrientCode, fr,
cl->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
cl->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(cl->gnrlcells, cr->prisms) {
  $tmpFacePlan.clear() ;

  std::vector<char> localPlanL = extract_general_face($cl->$lower.begin(),
                                                      $cl->$lower.size(),
                                                      $cl->$upper.begin(),
                                                      $cl->$upper.size(),
                                                      $cl->$boundary_map.begin(),
                                                      $cl->$boundary_map.size(),
                                                      $*face2node,
                                                      $*face2edge,
                                                      $*edge2node,
                                                      $cl->$tmpCellPlan,
                                                      _e_,
                                                      $*fileNumber(pos)) ;

  if($fr < 2) {
    std::vector<char> facePlanR = merge_tri_face_p($cr->$tmpCellPlan,
                                                   $fr,
                                                   $cr->$prismOrientCode[$fr]) ;
    $tmpFacePlan = merge_faceplan(localPlanL, facePlanR,
                                  $face2node.size()) ;
  }else {
    std::vector<char> facePlanR = extract_prism_face($cr->$tmpCellPlan,
                                                     $fr) ;
    std::vector<char> facePlanL = transfer_plan_g2q(localPlanL) ;
    $tmpFacePlan = merge_quad_face(facePlanL, char(0),
                                   facePlanR,
                                   $cr->$prismOrientCode[$fr]) ;
  }
  reduce_vector($tmpFacePlan) ;
}


/// Dummy
$rule pointwise(tmpFacePlan <- (cl, cr)->tmpCellPlan,
face2node, cl->prismOrientCode, fl,
cr->(lower, upper, boundary_map)->face2node->(pos, fileNumber(pos)),
cr->(lower, upper, boundary_map)->face2edge->edge2node->pos),
constraint(cr->gnrlcells, cl->prisms) {
  $tmpFacePlan.clear() ;

  std::vector<char> localPlanR = extract_general_face($cr->$lower.begin(),
                                                      $cr->$lower.size(),
                                                      $cr->$upper.begin(),
                                                      $cr->$upper.size(),
                                                      $cr->$boundary_map.begin(),
                                                      $cr->$boundary_map.size(),
                                                      $*face2node,
                                                      $*face2edge,
                                                      $*edge2node,
                                                      $cr->$tmpCellPlan,
                                                      _e_,
                                                      $*fileNumber(pos)) ;

  if($fl < 2) {
    std::vector<char> facePlanL = merge_tri_face_p($cl->$tmpCellPlan,
                                                   $fl,
                                                   $cl->$prismOrientCode[$fl]) ;
    $tmpFacePlan = merge_faceplan(facePlanL, localPlanR,
                                  $face2node.size()) ;
  }else {
    std::vector<char> facePlanL = extract_prism_face($cl->$tmpCellPlan,
                                                     $fl) ;
    std::vector<char> facePlanR = transfer_plan_g2q(localPlanR) ;

    $tmpFacePlan = merge_quad_face(facePlanR, char(0),
                                   facePlanL,
                                   $cl->$prismOrientCode[$fl]) ;
  }
  reduce_vector($tmpFacePlan) ;
}


$rule pointwise(tmpFacePlan <- (cl, cr)->tmpCellPlan,
cr->prismOrientCode, cl->hexOrientCode, fl, fr),
constraint(cl->hexcells, cr->prisms) {
  std::vector<char> facePlanL = extract_hex_face($cl->$tmpCellPlan,
                                                 DIRECTION($fl)) ;
  std::vector<char> facePlanR = extract_prism_face($cr->$tmpCellPlan,
                                                   $fr) ;
  $tmpFacePlan = merge_quad_face(facePlanL, $cl->$hexOrientCode[$fl],
                                 facePlanR, $cr->$prismOrientCode[$fr]) ;
  reduce_vector($tmpFacePlan) ;
}


$rule pointwise(tmpFacePlan <- (cl, cr)->tmpCellPlan,
cl->prismOrientCode, cr->hexOrientCode, fl, fr),
constraint(cr->hexcells, cl->prisms) {
  std::vector<char> facePlanR = extract_hex_face($cr->$tmpCellPlan,
                                                 DIRECTION($fr)) ;
  std::vector<char> facePlanL = extract_prism_face($cl->$tmpCellPlan,
                                                   $fl) ;
  $tmpFacePlan = merge_quad_face(facePlanL, $cl->$prismOrientCode[$fl],
                                 facePlanR, $cr->$hexOrientCode[$fr]) ;
  reduce_vector($tmpFacePlan) ;
}
