#include <vector>
#include <Loci.h>
#include "defines.h"
#include "plan_operations.h"

using std::cerr;
using std::endl;
using namespace Loci;

$include "FVM.lh"
$include "fvmadapt_internal.lh"

/// Intermediate set of integer edge split coordinates implied by balancedFacePlan1.
/// Multiple faces can contribute to the same edge; apply rules merge these sets.
$type balancedPointSet1 store<SetLong> ;

$rule unit(balancedPointSet1), constraint(edge2node->pos){
  $balancedPointSet1 = SetLong() ;
}

/// Project the balanced face plan onto its boundary edges for union merging.
$rule apply(face2edge->balancedPointSet1<-balancedFacePlan1, is_quadface,
face2node->pos, face2edge->edge2node->pos, face2edge->balancedPointSet1)[SetLongUnionOp],
constraint(faces) {
  if($is_quadface && $face2node.size() != 4) {
    cerr << "WARNING: Not a hexcell" << endl ;
    Loci::Abort() ;
  }

  if($balancedFacePlan1.size() == 0) { return ; }

  const int edgeCount =
    $is_quadface ? $face2edge.size() : $face2node.size() ;
  std::vector<bool> edgeReversed(edgeCount, false) ;

  if($is_quadface) {
    for(int i=0; i<edgeCount; i++) {
      if(i == 0 && $face2edge[0]->$edge2node[0] == $face2node[1]) {
        edgeReversed[i] = true ;
      }else if(i == 1 &&
               $face2edge[1]->$edge2node[0] == $face2node[2]) {
        edgeReversed[i] = true ;
      }else if(i == 2 &&
               $face2edge[2]->$edge2node[0] == $face2node[2]) {
        edgeReversed[i] = true ;
      }else if(i == 3 &&
               $face2edge[3]->$edge2node[0] == $face2node[3]) {
        edgeReversed[i] = true ;
      }
    }
  }else {
    for(int i=0; i<edgeCount; i++) {
      edgeReversed[i] =
        !($face2edge[i]->$edge2node[0] == $face2node[i] &&
          $face2edge[i]->$edge2node[1] ==
            $face2node[i==(edgeCount-1)?0:i+1]) ;
    }
  }

  const std::vector<SetLong> edgeSplits =
    project_face_plan_to_edge_splits(
      $balancedFacePlan1, $is_quadface, edgeReversed) ;
  for(int i=0; i<edgeCount; i++) {
    if(edgeSplits[i].aset.empty()) { continue ; }
    join($face2edge[i]->$balancedPointSet1, edgeSplits[i]) ;
  }
}

$rule pointwise(balancedEdgePlan1<-balancedPointSet1) {
  if($balancedPointSet1.aset.empty()) { return ; }
  encode_edge_plan($balancedPointSet1, $balancedEdgePlan1) ;
}
